---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import F1GameModal from '../components/F1GameModal.astro';
import VitalityGameModal from '../components/VitalityGameModal.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);
const theme = Astro.cookies.get('theme')?.value === 'dark' ? 'dark' : 'light';

const siteUrl = "https://arthurdx.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const metaDescription = description || (lang === 'fr' 
  ? "Portfolio d'Arthur Doradoux, élève-ingénieur à Mines Saint-Étienne et Politecnico di Milano. Projets en microélectronique, hardware, informatique et product management." 
  : "Arthur Doradoux's portfolio, engineering student at Mines Saint-Étienne and Politecnico di Milano. Hardware, microelectronics, computing, and product management projects.");
const metaImage = image || new URL('/assets/arthur.jpeg', siteUrl).toString();

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Arthur Doradoux",
  "url": siteUrl,
  "image": new URL('/assets/arthur.jpeg', siteUrl).toString(),
  "sameAs": [
    "https://linkedin.com/in/arthur-doradoux/",
    "https://github.com/Arthrir"
  ],
  "jobTitle": lang === 'fr' ? "Élève-ingénieur / Futur Product Owner" : "Student Engineer / Aspiring Product Owner",
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "Mines Saint-Étienne" },
    { "@type": "EducationalOrganization", "name": "Politecnico di Milano" }
  ]
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={metaDescription} />
		<link rel="canonical" href={canonicalURL.toString()} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook / LinkedIn -->
		<meta property="og:site_name" content="Arthur Doradoux" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalURL.toString()} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
		<meta property="og:image" content={metaImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={metaImage} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/logo/icone_gray.png" />
		<link rel="apple-touch-icon" href="/logo/icone_gray.png" />
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&display=swap" rel="stylesheet">

		<script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

		<script is:inline define:vars={{ theme }}>
			document.documentElement.dataset.themeInit = theme;

      // Easter Egg F1 : Fan de F1 & Télémétrie des performances
      window.addEventListener('load', () => {
        setTimeout(() => {
          const perfData = window.performance.timing;
          const pageLoadTime = perfData.loadEventEnd - perfData.navigationStart;
          const renderTime = perfData.domComplete - perfData.domInteractive;

          console.log("%c// TELEMETRY ACTIVE — Arthur Doradoux", "color: #FF5500; font-weight: bold; font-size: 13px; background: #101114; padding: 4px 8px; border-radius: 4px;");
          console.log("%c[PIT NOTE] Tapez 'f1' ou 'vitality' n'importe où sur le site pour lancer les labs interactifs.", "color: #0A6CFF; font-style: italic; font-size: 11px; margin-top: 4px;");
          console.log(`%c[METRICS] Page Load Time : ${pageLoadTime}ms`, "color: #39FF14; font-weight: bold; margin-top: 4px;");
          console.log(`%c[METRICS] DOM Interactive : ${renderTime}ms`, "color: #8F9198;");
          console.log("%c[STATUS] Systems nominal.", "color: #8F9198;");
        }, 0);
      });
		</script>
	</head>
	<body class={theme === 'dark' ? 'theme-dark' : 'theme-light'} style="min-height: 100vh; display: flex; flex-direction: column;">
		<Header lang={lang} />

		<main id="mainWrap" style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 100px 24px 40px; flex: 1; display: flex; flex-direction: column;">
			<slot />
		</main>

		<footer id="footerWrap" style="border-top: 1px solid var(--border); padding: 16px 24px; text-align: center; color: var(--muted); font-size: 0.85rem;">
			<div style="max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
				<p id="footerCopyright" style="user-select: none;">
					© 2026 Arthur Doradoux. {t('common.rights')} 
					<span style="margin: 0 6px; opacity: 0.5;">•</span> 
					<a href="/mentions-legales" style="color: var(--muted); text-decoration: underline; text-underline-offset: 3px;">
						{lang === 'fr' ? 'Mentions légales & Confidentialité' : 'Legal & Privacy'}
					</a>
				</p>
				<div style="display: flex; gap: 16px; align-items: center;">
					<a href="https://linkedin.com/in/arthur-doradoux/" target="_blank" aria-label="LinkedIn" style="color: var(--muted);">
						<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
					</a>
					<a href="https://github.com/Arthrir" target="_blank" aria-label="GitHub" style="color: var(--muted);">
						<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
					</a>
				</div>
			</div>
		</footer>

		<CommandPalette />
		<F1GameModal />
		<VitalityGameModal />
    <Analytics />

    <script is:inline>
      // Secret mobile trigger : 3 taps rapides sur le copyright = F1, 5 taps = Vitality Aim Lab
      let secretTapCount = 0;
      let secretTapTimer = null;
      const copyrightEl = document.getElementById('footerCopyright');
      copyrightEl?.addEventListener('pointerdown', (e) => {
        if (e.target.tagName && e.target.tagName.toLowerCase() === 'a') return;
        secretTapCount++;
        clearTimeout(secretTapTimer);
        secretTapTimer = setTimeout(() => {
          if (secretTapCount === 3 && window.startF1) {
            window.startF1();
          } else if (secretTapCount >= 5 && window.startVitality) {
            window.startVitality();
          }
          secretTapCount = 0;
        }, 450);
      });
    </script>
	</body>
</html>
