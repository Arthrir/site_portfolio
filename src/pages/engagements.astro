---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);

const featured = [
  {
    logo: "/logo/minitel.png",
    color: "var(--accent-bright)",
    date: "Mar 2025 — Mar 2026",
    role: "MINITEL", // Le nom de l'orga devient le sous-titre
    title: "Association President", // Le poste devient le gros titre
    desc: "Student association focused on IT, networking and gaming. Leadership of a 16-member team, management of campus Wi-Fi/wired infrastructure (150+ apartments), LAN events with Riot Games and Red Bull, and budgeting (>€10k). Elected honorary member.",
    tags: ["Team Management", "Network Administration", "Budget Management"]
  },
  {
    logo: "/logo/emse.png",
    color: "var(--school-emse)",
    date: "Feb 2026 — Pres.",
    role: "ISMIN & ICM Cohorts",
    title: "Elected Member of the Academic Committee",
    desc: "Participation in Academic Committee meetings where major changes to the school's academic programs are discussed, decided upon and presented. Representative and spokesperson.",
    tags: ["Institutional Communication", "Mediation", "Stakeholder Management"]
  }
];

const others = [
  {
    logo: "/logo/emse.png",
    date: "Sep 2024 — Pres.",
    role: "1st & 2nd Year",
    title: "Class Representative",
    desc: "Active liaison and mediation between students and the administration for all academic, logistical and social matters. Monthly meetings with campus leadership.",
  },
  {
    logo: "/logo/bde.jpeg",
    date: "Apr 2025 — Mar 2026",
    role: "Student Union",
    title: "Merchandising and Uniforms Manager",
    desc: "Management of orders, inventory, and distribution of uniforms and merchandise for the school's students.",
  },
  {
    logo: "/logo/emse.png",
    date: "Jan 2025 — Pres.",
    role: "Communication Department",
    title: "School Ambassador",
    desc: "Collaboration on updating the ISMIN Alpha brochure, scriptwriting social media video capsules, and producing presentation videos.",
  },
  {
    logo: "/logo/comif.jpeg",
    date: "Mar 2025 — Pres.",
    role: "Student Bar & Café",
    title: "COMIF Staff Member",
    desc: "Daily service of drinks and snacks during breaks and student events, handling transactions, customer service.",
  }
];
---

<Layout title="Arthur Doradoux | Student Engagements">
  <section style="padding: 40px 0 80px; max-width: 900px; margin: 0 auto;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue); margin-bottom: 40px;">
      <div class="stacked-bg">{t('engagements.kicker')}</div>
      <h2 class="stacked-main">{t('engagements.title')}</h2>
    </div>

    <p style="color: var(--muted); margin-bottom: 40px; max-width: 620px;">
      {t('engagements.subtitle')}
    </p>

    <div class="section-subhead" style="margin-top: 0;">{t('engagements.featuredLabel')}</div>
    <div>
      {featured.map(item => (
        <div class="impact-card" style={`--dot-color: ${item.color};`}>
          <span class="impact-tag">{item.date}</span>
          <div class="item-head" style="margin-bottom: 10px;">
            {item.logo && <img class="item-logo" src={item.logo} alt="" />}
            <div>
              <h3 class="role-name">{item.title}</h3>
              <span class="org-name-sub" style={`--dot-color: ${item.color};`}>{item.role}</span>
            </div>
          </div>
          <p style="font-size: 0.96rem; line-height: 1.7; max-width: 640px;">{item.desc}</p>
          <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
            {item.tags.map(tag => <span class="skill-tag">{tag}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="section-subhead">{t('engagements.othersLabel')}</div>
    <div>
      {others.map(item => (
        <details class="accordion-item">
          <summary>
            <span class="item-head">
              {item.logo && <img class="item-logo" src={item.logo} alt="" />}
              <span>{item.title}</span>
            </span>
            <span class="accordion-meta">
              <span class="accordion-date">{item.date}</span>
              <span class="accordion-plus"></span>
            </span>
          </summary>
          <div class="accordion-body">
            <div class="accordion-body-inner">
              <p class="org-name-sub" style="margin-bottom: 8px;">{item.role}</p>
              <p style="font-size: 0.92rem;">{item.desc}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>