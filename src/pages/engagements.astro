---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);

const featured = [
  {
    logo: "/logo/emse.png", color: "var(--school-emse)", date: lang === 'fr' ? "Fév 2026 - Aujourd'hui" : "Feb 2026 - Pres.",
    role: "ISMIN & ICM", title: lang === 'fr' ? "Élu au comité de l'enseignement" : "Elected Member of the Academic Committee",
    site: "https://www.mines-stetienne.fr/",
    team: [{ name: "Laure Rivier", link: "https://linkedin.com/in/laure-rivier-83060a328" }],
    desc: lang === 'fr' ? `
      <ul>
        <li>Participation aux réunions de comité de l'enseignement où sont discutés, décidés et présentés les grands changements des programmes pédagogiques de l'école.</li>
        <li>Représentant et porte-parole des promotions ISMIN et ICM.</li>
      </ul>
    ` : `
      <ul>
        <li>Participation in Academic Committee meetings where major changes to the school's academic programs are discussed, decided upon and presented.</li>
        <li>Representative and spokesperson for the ISMIN and ICM cohorts.</li>
      </ul>
    `,
    tags: ["Communication Institutionnelle", "Médiation", "Gestion des Parties Prenantes"]
  },
  {
    logo: "/logo/minitel.png", logoAction: "window.startMinitel && window.startMinitel()", color: "var(--accent-bright)", date: lang === 'fr' ? "Mars 2025 - Mars 2026" : "Mar 2025 - Mar 2026",
    role: "MINITEL", title: lang === 'fr' ? "Président" : "President",
    site: "https://minitel.emse.fr/",
    desc: lang === 'fr' ? `
      <p style="margin-bottom:8px">Association étudiante d'informatique, réseau et gaming. Direction de l'association (16 membres) et gestion des projets majeurs :</p>
      <ul>
        <li>Gestion et maintenance du réseau internet Wi-Fi et filaire du campus (150+ appartements étudiants).</li>
        <li>Organisation d'événements et de LAN en partenariat avec Riot Games et Red Bull.</li>
        <li>Coordination des équipes, planification d'événements et gestion d'un budget > 10 000€.</li>
      </ul>
      <p style="margin-top:8px"><i>Élu membre d'honneur de l'association à la fin de mon mandat.</i></p>
    ` : `
      <p style="margin-bottom:8px">Student association focused on IT, networking and gaming. Leadership of a 16-member team :</p>
      <ul>
        <li>Management and maintenance of the campus Wi-Fi and wired Internet network (150+ student apartments).</li>
        <li>Organization of events and LAN parties in partnership with Riot Games and Red Bull.</li>
        <li>Team coordination, event planning and management of a budget exceeding €10k.</li>
      </ul>
      <p style="margin-top:8px"><i>Elected honorary member of the association at the end of my term.</i></p>
    `,
    tags: ["Management d'équipe", "Administration Réseau", "Budget"]
  }
];

const others = [
  { 
    logo: "/logo/emse.png", date: lang === 'fr' ? "Sep 2024 - Aujourd'hui" : "Sep 2024 - Pres.", role: "1A & 2A", 
    title: lang === 'fr' ? "Représentant de Promotion" : "Class Representative", 
    site: "https://www.mines-stetienne.fr/",
    team: [{ name: "Laure Rivier", link: "https://linkedin.com/in/laure-rivier-83060a328" }],
    desc: lang === 'fr' ? `
      <ul>
        <li>Réunions mensuelles avec l'équipe de direction du campus pour remonter les points clés de la promotion.</li>
        <li>Liaison active avec les professeurs pour des ajustements de cours ou d'évaluations.</li>
        <li>Création de questionnaires et centralisation des avis et ressentis.</li>
      </ul>
    ` : `
      <ul>
        <li>Monthly meetings with the campus leadership team to report key issues.</li>
        <li>Active liaison with course instructors regarding course adjustments.</li>
        <li>Advocacy for students’ academic interests with the academic administration.</li>
      </ul>
    ` 
  },
  { 
    logo: "/logo/emse.png", date: lang === 'fr' ? "Janvier 2025 - Aujourd'hui" : "Jan 2025 - Pres.", role: "Communication", 
    title: lang === 'fr' ? "Ambassadeur Communication" : "School Ambassador", 
    site: "https://www.mines-stetienne.fr/",
    desc: lang === 'fr' ? `
      <ul>
        <li>Mise à jour et refonte intégrale de la plaquette Alpha du cursus ISMIN pour les futurs élèves ingénieurs.</li>
        <li>Participation à l'écriture de scripts pour des capsules vidéos destinées aux réseaux sociaux de l'école.</li>
        <li>Réalisation d'une vidéo de présentation de l'uniforme de Mines Saint-Etienne.</li>
      </ul>
    ` : `
      <ul>
        <li>Update and complete redesign of the ISMIN Alpha brochure.</li>
        <li>Contribution to scriptwriting for short video capsules intended for social media.</li>
        <li>Production of a presentation video of the Mines Saint-Étienne uniform.</li>
      </ul>
    ` 
  },
  { 
    logo: "/logo/alumni.png", date: lang === 'fr' ? "Rôle à vie" : "Lifetime", role: "Alumni", 
    title: lang === 'fr' ? "Relai de la Promotion" : "Class Representative for Alumni", 
    site: "https://www.mines-saint-etienne.org/",
    team: [{ name: "Laure Rivier", link: "https://linkedin.com/in/laure-rivier-83060a328" }],
    desc: lang === 'fr' ? "Représentation de la promotion auprès du réseau des anciens élèves pour assurer la communication, organiser des événements de networking et faciliter la collaboration professionnelle." : "Representation of the class within the alumni network to ensure communication, organize networking events and facilitate professional collaboration." 
  },
  { 
    logo: "/logo/bde.jpeg", date: lang === 'fr' ? "Avril 2025 - Mars 2026" : "Apr 2025 - Mar 2026", role: "BDE", 
    title: lang === 'fr' ? "Responsable Merchandising et Uniformes" : "Merchandising and Uniforms Manager", 
    site: "https://bde-emse.fr/",
    desc: lang === 'fr' ? "Gestion des commandes et de la distribution des uniformes et produits dérivés pour les élèves de l'école." : "Management of orders and distribution of uniforms and merchandise for the school’s students." 
  },
  { 
    logo: "/logo/fei.jpeg", date: lang === 'fr' ? "Avril 2025 - Nov 2025" : "Apr 2025 - Nov 2025", role: "FEI", 
    title: lang === 'fr' ? "Chargé Logistique" : "Logistics Officer", 
    site: "https://fei-aix.com/",
    desc: lang === 'fr' ? "Soutien à l'accueil et au guidage des entreprises. Gestion du bon déroulement des conférences et résolution des problèmes logistiques sur site." : "Support for welcoming and guiding companies. Ensuring the smooth running of conferences and solving on-site logistical issues." 
  },
  { 
    logo: "/logo/jmp.png", date: lang === 'fr' ? "2025 - Présent" : "2025 - Pres.", role: "Junior-Entreprise", 
    title: "Junior Mines Provence", 
    site: "https://www.junior-mines-provence.fr/",
    desc: lang === 'fr' ? `
      <ul>
        <li>Junior-Entreprise du campus Georges Charpak Provence de Mines Saint-Étienne.</li>
        <li>Participation aux missions d'ingénierie et de conseil en informatique et microélectronique.</li>
      </ul>
    ` : `
      <ul>
        <li>Junior-Enterprise of the Georges Charpak Provence campus at Mines Saint-Étienne.</li>
        <li>Involvement in tech and consulting missions in IT and microelectronics.</li>
      </ul>
    ` 
  },
  { 
    logo: "/logo/comif.jpeg", date: lang === 'fr' ? "Mars 2025 - Mars 2026" : "Mar 2025 - Mar 2026", role: "COMIF", 
    title: lang === 'fr' ? "Serveur au Bar Étudiant" : "Student Bar Staff", 
    desc: lang === 'fr' ? "Service quotidien de boissons et de collations pendant les pauses et les soirées associatives, incluant la gestion des transactions et le service client." : "Daily service of drinks and snacks during breaks and student events, handling transactions and customer service." 
  },
  { 
    logo: "/logo/solidar-ismin.jpg", date: lang === 'fr' ? "Mars 2025 - Mars 2026" : "Mar 2025 - Mar 2026", role: "Solidar'ISMIN", 
    title: lang === 'fr' ? "Pôle Prévention HVSSD" : "HVSSD Prevention Team", 
    desc: lang === 'fr' ? "Formation de tous les bureaux associatifs du campus aux enjeux de Harcèlement et Violences (HVSSD) à travers une formation en réalité virtuelle." : "Active participation in training sessions and development of awareness campaigns against harassment and violence." 
  }
];
---

<Layout 
  title={lang === 'fr' ? "Arthur Doradoux | Engagements & Leadership" : "Arthur Doradoux | Leadership & Engagements"}
  description={lang === 'fr' ? "Engagements associatifs et responsabilités d'Arthur Doradoux : Présidence de Minitel, élu au comité de l'enseignement, représentant de promotion Mines Saint-Étienne." : "Student leadership and community engagements of Arthur Doradoux: President of Minitel, elected academic committee member, class representative at Mines Saint-Étienne."}
>
  <section style="padding: 40px 0 80px; max-width: 900px; margin: 0 auto;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue); margin-bottom: 40px;">
      <div class="stacked-bg">{lang === 'fr' ? 'Leadership' : 'Leadership'}</div>
      <h2 class="stacked-main">{lang === 'fr' ? 'Engagements étudiants' : 'Student Engagements'}</h2>
    </div>

    <div class="section-subhead" style="margin-top: 0; margin-bottom: 24px; font-size: 0.95rem;">{lang === 'fr' ? 'Engagements les plus marquants' : 'Key Student Engagements'}</div>

    <div style="display: flex; flex-direction: column; gap: 16px;">
      {featured.map(item => (
        <div class="impact-card" style={`--dot-color: ${item.color};`}>
          <div class="item-head" style="margin-bottom: 12px;">
            {item.logoAction ? (
              <img class="org-logo force-white-bg" src={item.logo} alt={`Logo ${item.role}`} onclick={item.logoAction} style="cursor: pointer;" title="Accéder au terminal Minitel" />
            ) : (
              <img class="org-logo force-white-bg" src={item.logo} alt={`Logo ${item.role}`} />
            )}
            <div>
              <h3 class="role-name">{item.title}</h3>
              <span class="org-name-sub" style={`color: ${item.color};`}>{item.role}</span>
            </div>
            <div style="margin-left: auto; font-size: 0.85rem; font-weight: 600; color: var(--muted); text-align: right;">{item.date}</div>
          </div>
          <div style="font-size: 0.96rem; line-height: 1.7; max-width: 740px;" set:html={item.desc} />
          <div style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              {item.tags.map(tag => <span class="skill-tag">{tag}</span>)}
            </div>
            <div style="display: flex; gap: 14px; align-items: center; font-size: 0.85rem; flex-wrap: wrap;">
              {item.team && item.team.map(member => (
                <span style="color: var(--muted); display: inline-flex; align-items: center; gap: 5px;">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                  {lang === 'fr' ? 'En binôme avec' : 'With'} <a href={member.link} target="_blank" rel="noopener noreferrer" style="color: var(--text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">{member.name} ↗</a>
                </span>
              ))}
              {item.site && (
                <a href={item.site} target="_blank" rel="noopener noreferrer" style="color: var(--pop-blue); font-weight: 600; display: inline-flex; align-items: center; gap: 4px; text-decoration: underline; text-underline-offset: 2px;">
                  {lang === 'fr' ? 'Site officiel' : 'Official website'} ↗
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="section-subhead" style="margin-top: 48px; margin-bottom: 24px; font-size: 0.95rem;">{lang === 'fr' ? 'Autres rôles' : 'Other Roles'}</div>
    <div>
      {others.map(item => (
        <details class="accordion-item">
          <summary class="accordion-summary-align">
            <span class="item-head">
              <img class="org-logo force-white-bg" src={item.logo} alt={`Logo ${item.role}`} />
              <span>{item.title}</span>
            </span>
            <span class="accordion-meta">
              <span class="accordion-date">{item.date}</span>
              <span class="accordion-plus"></span>
            </span>
          </summary>
          <div class="accordion-body">
            <div class="accordion-body-inner">
              <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 12px; flex-wrap: wrap;">
                <p class="org-name-sub" style="margin-bottom: 0;">{item.role}</p>
                <div style="display: flex; gap: 12px; align-items: center; font-size: 0.82rem; flex-wrap: wrap;">
                  {item.team && item.team.map(member => (
                    <span style="color: var(--muted); display: inline-flex; align-items: center; gap: 4px;">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                      {lang === 'fr' ? 'En binôme avec' : 'With'} <a href={member.link} target="_blank" rel="noopener noreferrer" style="color: var(--text); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">{member.name} ↗</a>
                    </span>
                  ))}
                  {item.site && (
                    <a href={item.site} target="_blank" rel="noopener noreferrer" style="color: var(--pop-blue); font-weight: 600; text-decoration: underline; text-underline-offset: 2px;">
                      {lang === 'fr' ? 'Site officiel' : 'Official website'} ↗
                    </a>
                  )}
                </div>
              </div>
              <div style="font-size: 0.92rem;" set:html={item.desc} />
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <style>
    .item-head { display: flex; align-items: center; gap: 14px; }
    .accordion-summary-align { display: flex; justify-content: space-between; align-items: center; }
    .org-logo { width: 38px !important; height: 38px !important; object-fit: contain; border-radius: 8px; border: 1px solid var(--border); padding: 4px; flex-shrink: 0; }
    .impact-card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--card-bg); padding: 26px 28px; position: relative; border-left: 3px solid var(--dot-color, var(--accent)); box-shadow: var(--shadow); }
  </style>

  <style is:global>
    .impact-card ul, .accordion-body-inner ul { padding-left: 24px; margin-left: 4px; margin-top: 8px; }
    .impact-card li, .accordion-body-inner li { margin-bottom: 6px; }
  </style>
</Layout>