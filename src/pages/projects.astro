---
/* src/pages/projects.astro */
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "FPGA ECG and Communication",
    date: "Feb. 2026 – Mar. 2026",
    desc: "Project involving FPGA programming in order to decrypt ECG frames previously encrypted using the ASCON algorithm in Python. Implementation of a Python dashboard for real-time monitoring.",
    tags: ["SystemVerilog", "FPGA", "Vivado", "Python"],
    link: "#"
  },
  {
    title: "Embedded AI",
    date: "Feb. 2026 – Mar. 2026",
    desc: "AI project aimed at detecting faults in machines. The AI is then embedded on a board using an STM32 microcontroller.",
    tags: ["STM32", "AI", "Python", "Embedded Electronics", "C", "Git"],
    link: "https://github.com/Arthrir/ISMIN-IA_Embarquee_Projet"
  },
  {
    title: "AI Manufacturing",
    date: "Feb. 2026 – Mar. 2026",
    desc: "Work in progress manufacturing application leveraging R and AI frameworks.",
    tags: ["R", "AI"],
    link: "#"
  },
  {
    title: "Processor Architecture (RISC-V)",
    date: "Oct. 2025 – Jan. 2026",
    desc: "Implementation of a RISC-V processor in SystemVerilog, including jump and branch handling.",
    tags: ["RISC-V", "Processors", "SystemVerilog", "Design"],
    link: "#"
  },
  {
    title: "Enterprise Computer Network Security",
    date: "Oct. 2025 – Jan. 2026",
    desc: "Network security project analyzing a virtual machine to identify and exploit vulnerabilities, creating a Python environment for security tools, and exploring social engineering approaches.",
    tags: ["Python", "Linux", "OSINT", "Networks"],
    link: "#"
  },
  {
    title: "IoT Project",
    date: "Nov. 2025 – Feb. 2026",
    desc: "Design of an air quality measurement enclosure intended for zoos in order to regulate and better control microclimates.",
    tags: ["STM32", "3D Modeling", "3D Printing", "Sensors", "C", "IoT"],
    link: "#"
  },
  {
    title: "Capacitive Sensor Fan Prototype",
    date: "Feb. 2025 – Jun. 2025",
    desc: "Hardware prototyping project to design a fan controlled by a capacitive sensor using an STM32 microcontroller. Sliding gesture control with LED feedback.",
    tags: ["Sensor", "STM32", "PCB", "Hardware Prototyping", "Electronics", "C"],
    link: "#"
  },
  {
    title: "Autonomous Robot Programming (STM32)",
    date: "Feb. 2025 – Jun. 2025",
    desc: "Programming of a robot based on an STM32 microcontroller to stop 20 cm away from an object and follow it dynamically using an ultrasonic sensor on a servomotor.",
    tags: ["C", "STM32 Microcontroller", "Robotics"],
    link: "#"
  },
  {
    title: "Design of a RISC-V Processor (32-bit ISA)",
    date: "Oct. 2025 – Dec. 2025",
    desc: "Complete design of a processing unit (CPU) based on the RISC-V architecture (RV32I) using Logisim-evolution with an ALU, registers, memory, and a data bus.",
    tags: ["CPU Architecture", "RISC-V", "Logisim Evolution", "Digital Logic"],
    link: "#"
  },
  {
    title: "ASCON128 Encryption Implementation",
    date: "Feb. 2025 – May 2025",
    desc: "Implementation of the lightweight cryptographic algorithm ASCON128 using a state machine in SystemVerilog for embedded systems and IoT, accompanied by a Typst report.",
    tags: ["SystemVerilog", "Cryptography", "Security"],
    link: "https://github.com/Arthrir/ISMIN-ASCON-CSN"
  },
  {
    title: "State.io Game",
    date: "Feb. 2025 – Apr. 2025",
    desc: "Development of the State.io game in C to conquer territories by sending troops. Built using a client-server architecture and the Ncurses library for terminal UI.",
    tags: ["Dev Lead", "C", "Sockets", "Ncurses", "Multithreading"],
    link: "https://github.com/Arthrir/ISMIN-Jeu_Stateio"
  },
  {
    title: "Handi’Mines — Disability Awareness",
    date: "Feb. 2025 – Jun. 2025",
    desc: "Organization of a stand during 'Sport dans ma ville' in Gardanne to promote disability sports (blind football, showdown) and production of an awareness video.",
    tags: ["Communication", "Event Organization"],
    link: "#"
  },
  {
    title: "Velisud — Entrep’ Program",
    date: "Oct. 2024 – Mar. 2025",
    desc: "Participation in the Entrep’ entrepreneurship program focusing on designing an intermediate vehicle to be commercialized in the south of France, handling technical specs and electronic design.",
    tags: ["Technical Lead", "Entrepreneurship", "Electronic Design"],
    link: "#"
  },
  {
    title: "TIPE — Blackjack Optimization",
    date: "Jan. 2023 – Jul. 2024",
    desc: "Python simulation modeling player happiness and strategy optimization to balance casino gains and player retention.",
    tags: ["Python", "Statistical Modeling", "NumPy", "Matplotlib"],
    link: "#"
  }
];

const allTags = Array.from(new Set(projects.flatMap(p => p.tags))).sort();
---

<Layout title="Arthur Doradoux | Projects Hub">
  <section style="padding: 40px 0 80px;">
    <div class="stacked-title-wrapper" style="margin-bottom: 40px;">
      <div class="stacked-bg">Hub</div>
      <h2 class="stacked-main">Projects Hub</h2>
    </div>
    
    <p style="color: var(--muted); margin-bottom: 24px; max-width: 600px;">
      Explore all 14 technical realizations, hardware prototypes, and software architectures. Click on a tag to filter projects dynamically.
    </p>

    <!-- Filtres par tags -->
    <div id="tagFilterContainer" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px;">
      <button class="skill-tag active" data-tag="all">All Projects (14)</button>
      {allTags.map(tag => (
        <button class="skill-tag" data-tag={tag}>{tag}</button>
      ))}
    </div>

    <!-- Grille des projets -->
    <div id="projectsGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      {projects.map(project => (
        <article class="card project-card" data-tags={JSON.stringify(project.tags)} style="background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 6px;">{project.title}</h3>
            <p class="muted" style="font-size: 0.85rem; margin-bottom: 12px;">{project.date}</p>
            <p style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text);">{project.desc}</p>
          </div>

          <div>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px;">
              {project.tags.map(t => (
                <span class="skill-tag" style="font-size: 0.7rem; pointer-events: none;">{t}</span>
              ))}
            </div>
            {project.link !== "#" && (
              <a href={project.link} target="_blank" style="display: inline-block; font-size: 0.85rem; font-weight: 600; color: var(--pop-blue); text-decoration: none;">
                View on GitHub →
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const filterButtons = document.querySelectorAll('#tagFilterContainer .skill-tag');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        const selectedTag = button.getAttribute('data-tag');

        projectCards.forEach(card => {
          const cardTags = JSON.parse(card.getAttribute('data-tags'));
          if (selectedTag === 'all' || cardTags.includes(selectedTag)) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>