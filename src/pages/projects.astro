---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);

const projects = [
  { 
    title: lang === 'fr' ? "FPGA - ECG & communication sécurisée" : "FPGA ECG and Communication", 
    date: lang === 'fr' ? "Fév. 2026 - Mars 2026" : "Feb. 2026 – Mar. 2026", 
    desc: lang === 'fr' ? `
      <p>Développement d’un système basé sur FPGA permettant le déchiffrement de trames ECG.</p>
      <ul>
        <li>Déchiffrement matériel de trames chiffrées avec l’algorithme ASCON.</li>
        <li>Implémentation de l'architecture en SystemVerilog.</li>
        <li>Création d’un dashboard Python pour le suivi médical en temps réel.</li>
      </ul>
    ` : `
      <p>Project involving FPGA programming to decrypt ECG frames.</p>
      <ul>
        <li>Hardware decryption of frames previously encrypted using ASCON.</li>
        <li>SystemVerilog architecture implementation.</li>
        <li>Real-time Python dashboard implementation for medical monitoring.</li>
      </ul>
    `, 
    tags: { hardware: ["FPGA"], software: ["Python", "SystemVerilog"], soft: [], tools: ["Vivado"] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "IA embarquée (Détection de défauts)" : "Embedded AI", 
    date: lang === 'fr' ? "Fév. 2026 - Mars 2026" : "Feb. 2026 – Mar. 2026", 
    desc: lang === 'fr' ? `
      <ul>
        <li>Entraînement d'un modèle en Python pour détecter des défauts sur des machines.</li>
        <li>Intégration et optimisation du modèle sur un microcontrôleur STM32 en C.</li>
      </ul>
    ` : `
      <ul>
        <li>Model training in Python for fault detection.</li>
        <li>Embedding and optimizing the AI model on an STM32 microcontroller using C.</li>
      </ul>
    `, 
    tags: { hardware: ["STM32"], software: ["Python", "C"], soft: [], tools: [] }, link: "https://github.com/Arthrir/ISMIN-IA_Embarquee_Projet" 
  },
  { 
    title: lang === 'fr' ? "Architecture des processeurs RISC‑V" : "Processor Architecture (RISC-V)", 
    date: lang === 'fr' ? "Oct. 2025 - Jan. 2026" : "Oct. 2025 – Jan. 2026", 
    desc: lang === 'fr' ? `
      <ul>
        <li>Implémentation complète d’un processeur RISC‑V en SystemVerilog.</li>
        <li>Gestion avancée des branchements (jumps & branches).</li>
      </ul>
    ` : `
      <ul>
        <li>Complete implementation of a RISC-V processor in SystemVerilog.</li>
        <li>Advanced jump and branch handling.</li>
      </ul>
    `, 
    tags: { hardware: ["RISC-V"], software: ["SystemVerilog"], soft: [], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Sécurité des réseaux informatiques" : "Enterprise Network Security", 
    date: lang === 'fr' ? "Oct. 2025 - Jan. 2026" : "Oct. 2025 – Jan. 2026", 
    desc: lang === 'fr' ? `
      <ul>
        <li>Analyse et exploitation de vulnérabilités sur une machine virtuelle isolée.</li>
        <li>Développement d’un environnement Python regroupant divers outils d'exploitation.</li>
      </ul>
    ` : `
      <ul>
        <li>Vulnerability analysis and exploitation on an isolated VM.</li>
        <li>Creation of a Python environment integrating various exploitation tools.</li>
      </ul>
    `, 
    tags: { hardware: [], software: ["Python", "Linux"], soft: [], tools: ["OSINT"] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Projet IoT - Qualité de l’air" : "Terrariot IoT Box", 
    date: lang === 'fr' ? "Nov. 2025 - Fév. 2026" : "Nov. 2025 – Feb. 2026", 
    desc: lang === 'fr' ? "Conception d’un boîtier de mesure de la qualité de l’air destiné aux zoos afin de réguler et contrôler des microclimats spécifiques." : "Design of an air quality measurement enclosure intended for zoos in order to regulate and better control microclimates.", 
    tags: { hardware: ["STM32", "Sensors", "3D Printing"], software: ["C"], soft: [], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Ventilateur à capteur capacitif" : "Capacitive Sensor Fan", 
    date: lang === 'fr' ? "Fév. 2025 - Juin 2025" : "Feb. 2025 – Jun. 2025", 
    desc: lang === 'fr' ? `
      <ul>
        <li>Acquisition de données via STM32 pour ajuster la vitesse.</li>
        <li>Contrôle glissant (slider) à l'aide de deux électrodes.</li>
      </ul>
    ` : `
      <ul>
        <li>STM32 data acquisition to adjust fan speed.</li>
        <li>Sliding control interaction using two electrodes.</li>
      </ul>
    `, 
    tags: { hardware: ["STM32", "Sensors", "PCB"], software: ["C"], soft: [], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Robot autonome (STM32)" : "Autonomous Robot (STM32)", 
    date: lang === 'fr' ? "Fév. 2025 - Juin 2025" : "Feb. 2025 – Jun. 2025", 
    desc: lang === 'fr' ? "Programmation d'un robot basé sur STM32. Algorithme lui permettant de s'arrêter exactement à 20cm d'un objet puis de le suivre dynamiquement." : "Programming of an STM32-based robot to dynamically follow objects maintaining a 20cm distance.", 
    tags: { hardware: ["STM32", "Robotics"], software: ["C"], soft: [], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Conception Processeur RISC-V (32 bits)" : "CPU Design (RV32I)", 
    date: lang === 'fr' ? "Oct. 2025 - Déc. 2025" : "Oct. 2025 – Dec. 2025", 
    desc: lang === 'fr' ? "Conception complète d'un CPU (RV32I) sur Logisim-evolution (ALU, registres, mémoire)." : "Complete design of a processing unit (CPU) based on RISC-V using Logisim-evolution.", 
    tags: { hardware: ["RISC-V"], software: [], soft: [], tools: ["Logisim"] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Implémentation chiffrement ASCON" : "ASCON128 Encryption", 
    date: lang === 'fr' ? "Fév. 2025 - Mai 2025" : "Feb. 2025 – May 2025", 
    desc: lang === 'fr' ? "Création d'une machine d'état en SystemVerilog pour chiffrer et déchiffrer des données selon l'algorithme ASCON128." : "Design of a SystemVerilog state machine to perform encryption/decryption using ASCON128.", 
    tags: { hardware: ["Cryptography"], software: ["SystemVerilog"], soft: [], tools: [] }, link: "https://github.com/Arthrir/ISMIN-ASCON-CSN" 
  },
  { 
    title: lang === 'fr' ? "Jeu State.io" : "State.io Game", 
    date: lang === 'fr' ? "Fév. 2025 - Avr. 2025" : "Feb. 2025 – Apr. 2025", 
    desc: lang === 'fr' ? "Développement d'un jeu multijoueur en C visant la conquête de territoires (Sockets, Ncurses)." : "Development of the State.io game in C using client-server architecture (Sockets) and Ncurses.", 
    tags: { hardware: [], software: ["C"], soft: ["Dev Lead"], tools: [] }, link: "https://github.com/Arthrir/ISMIN-Jeu_Stateio" 
  },
  { 
    title: lang === 'fr' ? "Handi’Mines - Sensibilisation" : "Handi'Mines", 
    date: lang === 'fr' ? "Fév. 2025 - Juin 2025" : "Feb. 2025 – Jun. 2025", 
    desc: lang === 'fr' ? "Organisation d'un événement handisport (ateliers cécifoot et showdown)." : "Organization of a disability sports awareness event (blind football, showdown).", 
    tags: { hardware: [], software: [], soft: ["Event Management", "Communication"], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "Velisud - Programme Entrep’" : "Velisud — Entrep'", 
    date: lang === 'fr' ? "Oct. 2024 - Mar. 2025" : "Oct. 2024 – Mar. 2025", 
    desc: lang === 'fr' ? "Conception technique et électronique d'un véhicule intermédiaire dans le cadre d'un programme d'entrepreneuriat." : "Technical specifications and electronic design for an intermediate vehicle in a local entrepreneurship program.", 
    tags: { hardware: ["Electronics"], software: [], soft: ["Entrepreneurship", "Tech Lead"], tools: [] }, link: "#" 
  },
  { 
    title: lang === 'fr' ? "TIPE - Optimisation Blackjack" : "TIPE — Blackjack", 
    date: lang === 'fr' ? "Jan. 2023 - Juil. 2024" : "Jan. 2023 – Jul. 2024", 
    desc: lang === 'fr' ? "Simulation Python modélisant le bonheur du joueur pour optimiser les gains du casino." : "Python simulation modeling player happiness to optimize casino gains.", 
    tags: { hardware: [], software: ["Python"], soft: [], tools: ["Matplotlib"] }, link: "#" 
  }
];

// Extraction dynamique des filtres pour les menus
const extractTags = (cat: 'hardware' | 'software' | 'soft' | 'tools') => Array.from(new Set(projects.flatMap(p => p.tags[cat]))).sort();

const hardwareTags = extractTags('hardware');
const softwareTags = extractTags('software');
const softTags = extractTags('soft');
const toolsTags = extractTags('tools');
---

<Layout title={lang === 'fr' ? "Arthur Doradoux | Projets" : "Arthur Doradoux | Projects Hub"}>
  <section style="padding: 20px 0 60px;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-purple); --dot-color: var(--pop-purple); margin-bottom: 30px;">
      <h2 class="stacked-main">{t('projects.title')}</h2>
    </div>

    <!-- Menus Déroulants de Filtres -->
    <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;" class="filter-controls">
      <select id="hwSelect" class="pro-select">
        <option value="">{lang === 'fr' ? "+ Hardware" : "+ Hardware"}</option>
        {hardwareTags.map(tag => <option value={tag}>{tag}</option>)}
      </select>
      
      <select id="swSelect" class="pro-select">
        <option value="">{lang === 'fr' ? "+ Langages & Software" : "+ Languages & Software"}</option>
        {softwareTags.map(tag => <option value={tag}>{tag}</option>)}
      </select>

      <select id="toolSelect" class="pro-select">
        <option value="">{lang === 'fr' ? "+ Outils" : "+ Tools"}</option>
        {toolsTags.map(tag => <option value={tag}>{tag}</option>)}
      </select>

      <select id="softSelect" class="pro-select">
        <option value="">{lang === 'fr' ? "+ Soft Skills" : "+ Soft Skills"}</option>
        {softTags.map(tag => <option value={tag}>{tag}</option>)}
      </select>
    </div>

    <!-- Zone d'affichage des filtres actifs -->
    <div id="activeFiltersContainer" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; min-height: 32px;">
      <!-- Rempli par JS -->
    </div>

    <div id="projectsGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
      {projects.map((project, i) => {
        const flatTags = [...project.tags.hardware, ...project.tags.software, ...project.tags.tools, ...project.tags.soft];
        return (
          <article class="card project-card" data-tags={JSON.stringify(flatTags)} style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <h3 style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; margin-bottom: 6px;">{project.title}</h3>
              <p class="muted" style="font-size: 0.85rem; margin-bottom: 12px;">{project.date}</p>
              <div class="project-desc" style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text);" set:html={project.desc} />
            </div>
            <div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px;">
                {flatTags.map(tag => (
                  <span class="skill-tag" style="font-size: 0.7rem;">{tag}</span>
                ))}
              </div>
              {project.link !== "#" && (
                <a href={project.link} target="_blank" style="display: inline-block; font-size: 0.85rem; font-weight: 600; text-decoration: underline; text-decoration-color: var(--pop-purple); text-underline-offset: 3px;">
                  {t('common.viewOnGithub')} →
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <style is:global>
    .pro-select {
      appearance: none; background-color: var(--card-bg); border: 1px solid var(--border-strong);
      color: var(--text); padding: 8px 36px 8px 14px; font-size: 0.85rem; font-weight: 600;
      border-radius: 8px; cursor: pointer; outline: none; transition: border-color 0.2s ease;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%236B6D76%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%3E%3C%2Fpolyline%3E%3C%2Fsvg%3E");
      background-repeat: no-repeat; background-position: right 10px center; background-size: 16px;
    }
    .pro-select:hover { border-color: var(--text); }
    
    .active-filter-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      background: var(--text); color: var(--bg); border-radius: 100px;
      font-size: 0.8rem; font-weight: 600; cursor: pointer;
    }
    .active-filter-chip:hover { opacity: 0.8; }

    .project-desc ul { padding-left: 20px; margin-top: 8px; }
    .project-desc li { margin-bottom: 6px; }
  </style>

  <script>
    const selects = document.querySelectorAll('.pro-select') as NodeListOf<HTMLSelectElement>;
    const activeContainer = document.getElementById('activeFiltersContainer');
    const projectCards = Array.from(document.querySelectorAll('.project-card')) as HTMLElement[];
    
    let activeTags = new Set<string>();

    function renderFilters() {
      if(!activeContainer) return;
      activeContainer.innerHTML = '';
      
      activeTags.forEach(tag => {
        const chip = document.createElement('div');
        chip.className = 'active-filter-chip';
        chip.innerHTML = `${tag} <span>✕</span>`;
        chip.addEventListener('click', () => {
          activeTags.delete(tag);
          renderFilters();
          applyFilters();
        });
        activeContainer.appendChild(chip);
      });
    }

    function applyFilters() {
      projectCards.forEach(card => {
        const cardTags = JSON.parse(card.getAttribute('data-tags') || '[]');
        // Un projet s'affiche si AUCUN filtre n'est actif, OU s'il possède TOUS les tags sélectionnés
        const isMatch = activeTags.size === 0 || Array.from(activeTags).every(t => cardTags.includes(t as string));
        card.style.display = isMatch ? 'flex' : 'none';
      });
    }

    selects.forEach(select => {
      select.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        if (val) {
          activeTags.add(val);
          select.value = ""; // Reset dropdown
          renderFilters();
          applyFilters();
        }
      });
    });
  </script>
</Layout>