---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);
---

<Layout 
	title={lang === 'fr' ? "Arthur Doradoux | Ingénieur & Product Design" : "Arthur Doradoux | Engineering & Product Design"}
	description={lang === 'fr' ? "Portfolio d'Arthur Doradoux, élève-ingénieur aux Mines Saint-Étienne et au Politecnico di Milano. Recherche de stage de fin d'études (5+ mois) en tant que Product Owner ou Hardware/Software." : "Portfolio of Arthur Doradoux, engineering student at Mines Saint-Étienne and Politecnico di Milano. Seeking an end-of-studies internship as a Product Owner or in Hardware/Software."}
>
	<section style="padding: 40px 0 70px;">
		<div style="display: flex; align-items: center; justify-content: space-between; gap: 60px; flex-wrap: wrap;">
			<div style="flex: 1; min-width: 300px;">
				<div class="badge-row">
					<span class="badge badge-emse">Mines Saint-Étienne</span>
					<span class="badge badge-polimi">Politecnico di Milano</span>
					<span class="badge badge-emlyon">emlyon</span>
				</div>

				<h1 style="font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.6rem, 6vw, 4rem); line-height: 1.05; margin-bottom: 20px; letter-spacing: -0.01em;">
					Arthur Doradoux
				</h1>
				<p style="font-size: 1.1rem; color: var(--muted); margin-bottom: 32px; max-width: 520px;">
					{lang === 'fr' ? "Étudiant en microélectronique et informatique, passionné par les innovations technologiques. À la recherche d'un stage de fin d'études (5+ mois) à partir d'avril 2027." : "Microelectronics and Computer Science student. Currently looking for a 5+ month end-of-studies internship starting in April 2027."}
				</p>

				<div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
					<a href="/projects" class="btn btn-primary">{lang === 'fr' ? "Explorer mes projets" : "Explore my projects"}</a>
					<a href="#contact" class="btn btn-secondary">{lang === 'fr' ? "Me contacter" : "Get in Touch"}</a>
				</div>
			</div>

			<div style="position: relative; width: 260px; height: 330px; flex-shrink: 0; margin: 0 auto;">
				<img src="/assets/arthur.jpeg" alt="Arthur Doradoux - Élève-ingénieur Mines Saint-Étienne & Politecnico di Milano" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); position: relative; z-index: 2;" />
				<div style="position: absolute; bottom: -12px; right: -12px; width: 100%; height: 100%; border: 1px solid var(--pop-blue); border-radius: var(--radius); z-index: 1;"></div>
			</div>
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-fuchsia); --dot-color: var(--pop-fuchsia);">
			<div class="stacked-bg">{t('home.visionKicker')}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Profil & Ambitions' : 'Profile & Ambitions'}</h2>
		</div>

		<div class="card" style="padding: 36px;">
			<div style="font-size: 1.02rem; line-height: 1.8; display: flex; flex-direction: column; gap: 20px;" set:html={lang === 'fr' ? `
				<p>Entre mes projets techniques à Mines Saint-Étienne, mes expériences professionnelles en France et en Allemagne, et mon semestre actuel au Politecnico di Milano, mon parcours s'est nourri d'une forte culture internationale et de voyages.</p>
				<p>C’est particulièrement à la tête d'associations étudiantes, notamment en tant que Président de MINITEL, qu'en pilotant des équipes et des projets d'envergure, j'ai réalisé que je voulais m'orienter vers le management, la gestion de projet et le product management.</p>
				<p>Passionné par les produits technologiques et innovants, je construis mon cursus au carrefour de l'ingénierie, du design produit, du marketing et de la stratégie. C'est cette vision globale qui guidera mon avenir vers des rôles de Product Owner / Manager.</p>
				<div style="border-left: 2px solid var(--pop-fuchsia); padding-left: 16px; margin: 6px 0; font-style: italic; color: var(--text);">
					Mon ambition : concevoir des produits qui comptent et innovent pour changer le monde.
				</div>
			` : `
				<p>Between my technical projects at Mines Saint-Étienne, my professional experiences in France and Germany, and my current semester at Politecnico di Milano, my path has been shaped by a strong international culture and travel.</p>
				<p>Leading student associations, particularly as President of MINITEL, managing teams and major projects, made me realize that I wanted to focus my career on management, project management, and product management.</p>
				<p>Passionate about innovative and technological products, I am building my curriculum at the crossroads of engineering, product design, marketing, and strategy. This global vision drives my goal to evolve into Product Owner / Manager roles.</p>
				<div style="border-left: 2px solid var(--pop-fuchsia); padding-left: 16px; margin: 6px 0; font-style: italic; color: var(--text);">
					My ambition: to design products that matter and innovate to change the world.
				</div>
			`} />
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue);">
			<div class="stacked-bg">{t('home.careerKicker')}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Expériences Professionnelles' : 'Work Experience'}</h2>
		</div>

		<div class="timeline" style="--dot-color: var(--pop-blue);">
			<div class="timeline-item">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Avr. 2026 - <br class="date-br">Juil. 2026' : 'Apr. 2026 - <br class="date-br">Jul. 2026'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo" src="/logo/advantest.png" alt="Advantest" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Stage Ingénieur R&D Test Cell Integration' : 'R&D Test Cell Integration Engineering Intern'}</h3>
              <span class="org-name-sub" style="color: var(--pop-blue);"><strong>Advantest</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- {lang === 'fr' ? 'Böblingen, Allemagne' : 'Böblingen, Germany'}</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--pop-blue);" set:html={lang === 'fr' ? `
            <ul>
              <li>Tests de PCBs de calibration destinés au test de puces IA/GPU.</li>
              <li>Modélisation et impression 3D d'un boîtier d'interface entre le testeur et l'ordinateur.</li>
              <li>Mesures et analyses de précision sur des PCBs à l'aide de Microscope, VNA et TDR.</li>
            </ul>
          ` : `
            <ul>
              <li>Testing calibration PCBs intended for AI/GPU chip testing.</li>
              <li>3D modeling and printing of an interface enclosure between the tester and the computer.</li>
              <li>Precision measurements and analysis on PCBs using a microscope, VNA and TDR.</li>
            </ul>
          `} />
          <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
            <span class="skill-tag">Hardware Testing</span>
            <span class="skill-tag">PCB Calibration</span>
            <span class="skill-tag">3D Printing</span>
            <span class="skill-tag">VNA / TDR</span>
          </div>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Jan. 2025 - <br class="date-br">Fév. 2025' : 'Jan. 2025 - <br class="date-br">Feb. 2025'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo logo-phinia" src="/logo/phinia.png" alt="PHINIA Delphi" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Stage Ingénieur Systèmes Hardware' : 'Hardware Systems Engineering Intern'}</h3>
              <span class="org-name-sub" style="color: var(--pop-blue);"><strong>PHINIA Delphi France</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Blois, France</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--pop-blue);" set:html={lang === 'fr' ? `
            <ul>
              <li>Configuration et tests de systèmes d'injection (plateforme ECU 24V).</li>
              <li>Découverte des bancs de tests industriels et des protocoles de validation hardware.</li>
              <li>Validation fonctionnelle d'ECU avec application Hydrogène (H2).</li>
              <li>Caractérisation thermique d'un ECU via communication CAN après adaptation de 12V à 24V.</li>
            </ul>
          ` : `
            <ul>
              <li>Configured and tested hardware/software using a 24V ECU platform.</li>
              <li>Introduction to industrial test benches and hardware validation protocols.</li>
              <li>Functional validation of ECUs for hydrogen-related applications.</li>
              <li>Performed thermal characterization using CAN communication after adaptation from 12V to 24V.</li>
            </ul>
          `} />
          <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
            <span class="skill-tag">Embedded Systems</span>
            <span class="skill-tag">CAN Communication</span>
            <span class="skill-tag">Thermal Characterization</span>
            <span class="skill-tag">Hardware Validation</span>
          </div>
				</div>
			</div>
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-orange); --dot-color: var(--pop-orange);">
			<div class="stacked-bg">{lang === 'fr' ? 'Diplômes' : 'Degrees'}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Formation' : 'Education'}</h2>
		</div>

		<div class="timeline">
			<div class="timeline-item" style="--dot-color: var(--school-emlyon);">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Sep. 2027 - <br class="date-br">Juin 2028' : 'Sep. 2027 - <br class="date-br">Jun. 2028'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo" src="/logo/emlyon.png" alt="emlyon" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Double Diplôme PGE (Accepté)' : 'PGE Double Degree (Accepted)'}</h3>
							<span class="org-name-sub" style="color: var(--school-emlyon);"><strong>emlyon business school</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Lyon, France</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--school-emlyon);" set:html={lang === 'fr' ? `
						<ul>
							<li><strong>Programme :</strong> Programme Grande École (PGE) en Double Diplôme avec le cursus ISMIN.</li>
							<li><strong>Objectif :</strong> Compléter mon socle technique par les outils financiers, stratégiques et managériaux nécessaires pour évoluer vers un rôle de Product Owner global.</li>
						</ul>
            <p style="margin-top: 12px; font-size: 0.85rem; font-style: italic; color: var(--muted);">* Ma candidature complète est disponible en français via le lien ci-dessous.</p>
					` : `
						<ul>
							<li><strong>Program:</strong> Master in Management (PGE) Double Degree with ISMIN.</li>
							<li><strong>Goal:</strong> Complement my technical background with the financial, strategic, and managerial tools required for a global Product Owner role.</li>
						</ul>
            <p style="margin-top: 12px; font-size: 0.85rem; font-style: italic; color: var(--muted);">* Note: My full application file is available in French via the link below.</p>
					`} />

					<a href="/candidature_emlyon/index.html" target="_blank" style="display: inline-block; margin-top: 14px; font-size: 0.9rem; font-weight: 700; color: var(--school-emlyon); text-decoration: underline; text-underline-offset: 3px; transition: opacity 0.2s ease;">
						{lang === 'fr' ? 'Voir ma candidature emlyon (Format Web) →' : 'View my emlyon application (Web Format) →'}
					</a>
				</div>
			</div>

			<div class="timeline-item" style="--dot-color: var(--school-polimi);">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Sep. 2026 - <br class="date-br">Fév. 2027' : 'Sep. 2026 - <br class="date-br">Feb. 2027'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo force-white-bg" src="/logo/polimi.png" alt="Politecnico di Milano" />
						<div>
							<h3 class="role-name">Master in Design & Engineering</h3>
              <span class="org-name-sub" style="color: var(--school-polimi);"><strong>Politecnico di Milano</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Milan, Italie</span></span>
						</div>
					</div>
          <div class="mission-list" style="--dot-color: var(--school-polimi);" set:html={lang === 'fr' ? `
            <ul>
              <li><strong>Cours :</strong> Product Design Studio 1, UX Design, Design and Manufacturing, Virtual and Physical Prototyping.</li>
              <li><strong>Enjeu :</strong> Maîtriser l'ergonomie, le prototypage rapide et l'UX pour placer l'utilisateur au centre de la conception matérielle. Une compétence clé pour diriger des produits dans les entreprises technologiques innovantes.</li>
            </ul>
          ` : `
            <ul>
              <li><strong>Courses:</strong> Product Design Studio 1, UX Design, Design and Manufacturing, Virtual and Physical Prototyping.</li>
              <li><strong>Goal:</strong> Master ergonomics, rapid prototyping, and UX to put the user at the center of hardware design—a key skill for leading products in innovative tech companies.</li>
            </ul>
          `} />
				</div>
			</div>

			<div class="timeline-item" style="--dot-color: var(--school-emse);">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Sep. 2024 - <br class="date-br">Juin 2027' : 'Sep. 2024 - <br class="date-br">Jun. 2027'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo force-white-bg" src="/logo/emse.png" alt="Mines Saint-Étienne" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Diplôme d'ingénieur ISMIN" : "ISMIN Engineering Degree"}</h3>
              <span class="org-name-sub" style="color: var(--school-emse);"><strong>Mines de Saint-Étienne</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Gardanne, France</span></span>
						</div>
					</div>
          <div class="mission-list" style="--dot-color: var(--school-emse);" set:html={lang === 'fr' ? `
            <ul>
              <li><strong>Formation :</strong> Microélectronique et Informatique.</li>
              <li><strong>Tronc commun :</strong> Microcontrôleurs, Traitement du Signal, Architecture CPU, Électronique Numérique/Analogique, Cryptographie.</li>
              <li><strong>Électifs :</strong> IA pour la Production, FPGA & Sécurité, Entrepreneuriat.</li>
            </ul>
          ` : `
            <ul>
              <li><strong>Major:</strong> Microelectronics and Computer Science.</li>
              <li><strong>Core curriculum:</strong> Microcontrollers, Signal Processing, CPU Architecture, Digital/Analog Electronics, Cryptography.</li>
              <li><strong>Electives:</strong> AI for Production, FPGA and Security, Entrepreneurship.</li>
            </ul>
          `} />
				</div>
			</div>

      <div class="timeline-item" style="--dot-color: var(--muted);">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Sep. 2022 - <br class="date-br">Juin 2024' : 'Sep. 2022 - <br class="date-br">Jun. 2024'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
            <img class="org-logo" src="/logo/pothier.png" alt="Lycée Pothier" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Classes Préparatoires (MPSI / MP*)" : "Intensive Preparatory Classes (CPGE)"}</h3>
              <span class="org-name-sub" style="color: var(--muted);"><strong>Lycée Pothier</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Orléans, France</span></span>
						</div>
					</div>
          <p style="margin-top: 10px;">{lang === 'fr' ? "Spécialités : Mathématiques, Physique, Informatique." : "Mathematics, Physics, Computer Science."}</p>
				</div>
			</div>

      <div class="timeline-item" style="--dot-color: var(--muted);">
				<div class="timeline-date" set:html={lang === 'fr' ? 'Sep. 2019 - <br class="date-br">Juin 2022' : 'Sep. 2019 - <br class="date-br">Jun. 2022'}></div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
            <img class="org-logo" src="/logo/nda.png" alt="Lycée Notre-Dame des Aydes" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Baccalauréat Mention Bien (Section Européenne)" : "High School Diploma with Honors"}</h3>
              <span class="org-name-sub" style="color: var(--muted);"><strong>Lycée Notre-Dame des Aydes</strong> <span style="color: var(--muted); font-weight: 500; text-transform: none;">- Blois, France</span></span>
						</div>
					</div>
          <p style="margin-top: 10px;">{lang === 'fr' ? "Spécialités : Mathématiques, Physique-Chimie, HGGSP. Option Maths Expertes." : "Mathematics, Physics, Chemistry, Geopolitics, Advanced Mathematics option, European Track."}</p>
				</div>
			</div>
		</div>
	</section>

	<section id="recommendations" style="display: none; padding: 60px 0 20px; max-width: 1000px; margin: 0 auto;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-purple); --dot-color: var(--pop-purple); margin-bottom: 40px; text-align: center;">
			<div class="stacked-bg" style="left: 50%; transform: translateX(-50%); width: 100%;">{lang === 'fr' ? 'Témoignages' : 'Endorsements'}</div>
			<h2 class="stacked-main" style="margin-left: 0;">{lang === 'fr' ? 'Recommandations' : 'Recommendations'}</h2>
		</div>

		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">

			<div class="card" style="padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
				<div>
					<div style="font-size: 1.8rem; color: var(--pop-blue); line-height: 1; margin-bottom: 12px; font-family: var(--font-serif);">“</div>
					<p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); font-style: italic; margin-bottom: 20px;">
						{lang === 'fr' 
							? "Arthur a démontré une rigueur technique exemplaire et une grande autonomie dans la caractérisation des systèmes. Sa capacité à faire le pont entre contraintes hardware et vision globale a été un vrai atout pour l'équipe."
							: "Arthur showed remarkable technical rigor and strong autonomy in systems characterization. His ability to bridge hardware constraints and overall product vision was a real asset to our team."}
					</p>
				</div>
				<div style="display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--border); padding-top: 16px;">
					<img class="org-logo" src="/logo/advantest.png" alt="Advantest" style="width: 36px; height: 36px; object-fit: contain; border-radius: 6px;" />
					<div>
						<div style="font-weight: 600; font-size: 0.95rem;">Nom du Tuteur / Mentor</div>
						<div style="font-size: 0.8rem; color: var(--muted);">Senior Hardware Engineer — Advantest</div>
					</div>
				</div>
			</div>

			<div class="card" style="padding: 28px; display: flex; flex-direction: column; justify-content: space-between;">
				<div>
					<div style="font-size: 1.8rem; color: var(--pop-orange); line-height: 1; margin-bottom: 12px; font-family: var(--font-serif);">“</div>
					<p style="font-size: 0.95rem; line-height: 1.6; color: var(--text); font-style: italic; margin-bottom: 20px;">
						{lang === 'fr' 
							? "En tant que président de Minitel et représentant de promotion, Arthur sait fédérer des équipes, structurer des projets complexes et dialoguer avec des parties prenantes exigeantes."
							: "As President of Minitel and class representative, Arthur excels at rallying teams, structuring ambitious initiatives, and engaging with demanding stakeholders."}
					</p>
				</div>
				<div style="display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--border); padding-top: 16px;">
					<img class="org-logo force-white-bg" src="/logo/emse.png" alt="Mines Saint-Étienne" style="width: 36px; height: 36px; object-fit: contain; border-radius: 6px;" />
					<div>
						<div style="font-weight: 600; font-size: 0.95rem;">Responsable Pédagogique / Associatif</div>
						<div style="font-size: 0.8rem; color: var(--muted);">Mines Saint-Étienne (ISMIN)</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="contact" style="padding: 60px 0 40px; max-width: 1000px; margin: 0 auto;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue); margin-bottom: 40px; text-align: center;">
      <div class="stacked-bg" style="left: 50%; transform: translateX(-50%); width: 100%;">Contact</div>
      <h2 class="stacked-main" style="margin-left: 0;">{lang === 'fr' ? 'Me contacter' : 'Get in Touch'}</h2>
    </div>

		<div class="card contact-wrapper" style="padding: 40px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: center;">

			<div>
				<h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 600; margin: 10px 0 20px; line-height: 1.1;">
					{lang === 'fr' ? "Travaillons ensemble !" : "Let's Work Together"}
				</h2>
				<p style="color: var(--muted); font-size: 0.95rem; margin-bottom: 30px; line-height: 1.6;">
					{lang === 'fr' ? "À la recherche d'un stage de fin d'études (5+ mois à partir d'avril 2027) en tant que Product Owner ou en développement hardware/software. Écrivez-moi directement !" : "Looking for a 5+ month end-of-studies internship starting in April 2027 as a Product Owner or in hardware/software development. Drop me a line!"}
				</p>

				<div style="display: flex; flex-direction: column; gap: 20px;">

          <div style="display: flex; align-items: center; gap: 14px;">
						<a href="tel:+33627883483" class="contact-icon-box" aria-label="Phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
