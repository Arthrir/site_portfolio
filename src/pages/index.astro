---
/* src/pages/index.astro */
import Layout from '../layouts/Layout.astro';
---

<Layout title="Arthur Doradoux | Engineering & Product Design">
	<!-- Hero Section (Sans le texte géant en arrière-plan) -->
	<section style="padding: 40px 0 80px;">
		<div style="display: flex; align-items: center; justify-content: space-between; gap: 60px;">
			<div style="flex: 1;">
				<span style="display: inline-block; font-size: 0.75rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--pop-blue); margin-bottom: 16px; padding: 4px 10px; border: 1px solid var(--pop-blue); border-radius: 6px; background: rgba(10, 132, 255, 0.05);">
					MINES SAINT-ÉTIENNE × POLI MI
				</span>
				<h1 style="font-family: var(--font-serif); font-size: 4rem; line-height: 1.05; margin-bottom: 20px; letter-spacing: -1px;">
					Arthur <em style="font-style: italic; color: var(--pop-fuchsia);">Doradoux</em>
				</h1>
				<p style="font-size: 1.15rem; color: var(--muted); line-height: 1.6; margin-bottom: 32px; max-width: 540px;">
					Microelectronics & Computer Science student, bridging the gap between deep tech hardware, systems engineering, and product design.
				</p>
				<div style="display: flex; gap: 16px;">
					<a href="/projects" style="background-color: var(--text); color: var(--bg); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none;">Explore Projects</a>
					<a href="mailto:arthur.doradoux@etu.emse.fr" style="background-color: transparent; color: var(--text); border: 1px solid var(--border); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none;">Get in touch</a>
				</div>
			</div>

			<div style="position: relative; width: 280px; height: 350px; flex-shrink: 0;">
				<img src="/assets/arthur.jpeg" alt="Arthur Doradoux" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); position: relative; z-index: 2; box-shadow: var(--shadow);" />
				<div style="position: absolute; bottom: -12px; right: -12px; width: 100%; height: 100%; border: 2px solid var(--pop-orange); border-radius: var(--radius); z-index: 1; opacity: 0.5;"></div>
			</div>
		</div>
	</section>

	<!-- Experience Section -->
	<section style="padding: 40px 0;">
		<h2 style="font-family: var(--font-serif); font-size: 2.2rem; margin-bottom: 40px;">Experience</h2>
		
		<div class="timeline">
			<div class="timeline-item">
				<div class="timeline-date">Apr — Jul 2026</div>
				<div class="timeline-content">
					<h3 style="font-size: 1.2rem; margin-bottom: 6px;">R&D Test Cell Integration Intern <span style="color: var(--pop-blue);">@ Advantest</span></h3>
					<p class="muted" style="font-size: 0.9rem;">Böblingen, Germany</p>
					<p style="margin-top: 12px; font-size: 0.95rem;">Designed a 3D printed controller enclosure and validated calibration PCBs for AI/GPU testing systems[cite: 1]. Conducted analysis on mechanical pin-to-PCB alignment[cite: 1].</p>
					<div style="margin-top: 14px; display: flex; gap: 8px;">
						<span style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; background: rgba(105, 255, 10, 0.15); color: #2e8500;">KiCAD</span>
						<span style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; background: rgba(10, 132, 255, 0.1); color: var(--pop-blue);">Hardware Design</span>
					</div>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-date">Jan — Feb 2025</div>
				<div class="timeline-content">
					<h3 style="font-size: 1.2rem; margin-bottom: 6px;">Hardware Systems Engineering Intern <span style="color: var(--pop-orange);">@ PHINIA Delphi</span></h3>
					<p class="muted" style="font-size: 0.9rem;">Blois, France</p>
					<p style="margin-top: 12px; font-size: 0.95rem;">Performed thermal characterization and modified Electronic Control Unit (ECU) for vehicle testing[cite: 1, 4]. Configured and tested hardware/software for the first hydrogen injection using a 24V ECU platform[cite: 1].</p>
					<div style="margin-top: 14px; display: flex; gap: 8px;">
						<span style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; background: rgba(255, 159, 10, 0.1); color: var(--pop-orange);">Embedded Systems</span>
						<span style="font-size: 0.75rem; padding: 2px 8px; border-radius: 4px; background: rgba(191, 90, 242, 0.1); color: var(--pop-purple);">CAN</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Education Section -->
	<section style="padding: 40px 0 80px;">
		<h2 style="font-family: var(--font-serif); font-size: 2.2rem; margin-bottom: 40px;">Education</h2>
		
		<div class="timeline">
			<div class="timeline-item">
				<div class="timeline-date">2024 — 2027</div>
				<div class="timeline-content">
					<h3 style="font-size: 1.2rem; margin-bottom: 6px;">École Nationale Supérieure des Mines de Saint-Étienne</h3>
					<p class="muted" style="font-size: 0.9rem;">ISMIN Program (Microelectronics & Computer Science) — Gardanne, France[cite: 1]</p>
					<p style="margin-top: 12px; font-size: 0.95rem;">Master’s degree focusing on microcontrollers, embedded systems, digital/analog electronics, and processor architecture[cite: 1]. Elected student representative on the Academic Committee.</p>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-date">2022 — 2024</div>
				<div class="timeline-content">
					<h3 style="font-size: 1.2rem; margin-bottom: 6px;">Classes Préparatoires aux Grandes Écoles (CPGE)</h3>
					<p class="muted" style="font-size: 0.9rem;">Lycée Pothier, Orléans — MPSI / MP*[cite: 7]</p>
					<p style="margin-top: 12px; font-size: 0.95rem;">Intensive scientific courses focused on advanced mathematics, physics, and computer science[cite: 1].</p>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-date">2019 — 2022</div>
				<div class="timeline-content">
					<h3 style="font-size: 1.2rem; margin-bottom: 6px;">French Baccalaureate with Honors</h3>
					<p class="muted" style="font-size: 0.9rem;">Lycée Notre-Dame des Aydes, Blois — European Section[cite: 1]</p>
					<p style="margin-top: 12px; font-size: 0.95rem;">Specializations in Mathematics, Physics-Chemistry, and Advanced Mathematics option[cite: 1].</p>
				</div>
			</div>
		</div>
	</section>
</Layout>