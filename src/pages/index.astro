---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);
---

<Layout title="Arthur Doradoux | Engineering & Product Design">
	<section style="padding: 40px 0 70px;">
		<div style="display: flex; align-items: center; justify-content: space-between; gap: 60px; flex-wrap: wrap;">
			<div style="flex: 1; min-width: 300px;">
				<div class="badge-row">
					<span class="badge badge-emse">Mines Saint-Étienne</span>
					<span class="badge badge-polimi">Politecnico di Milano</span>
					<span class="badge badge-emlyon">emlyon</span>
				</div>

				<h1 style="font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.6rem, 6vw, 4rem); line-height: 1.05; margin-bottom: 20px; letter-spacing: -0.01em;">
					Arthur Doradoux
				</h1>
				<p style="font-size: 1.1rem; color: var(--muted); margin-bottom: 32px; max-width: 520px;">
					{lang === 'fr' ? "Étudiant en microélectronique et en informatique, passionné par les innovations technologiques." : "Microelectronics and Computer Science student, passionate about technology and innovation."}
				</p>

				<div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
					<a href="/projects" class="btn btn-primary">{t('home.ctaProjects')}</a>
					<a href="#contact" class="btn btn-secondary">{lang === 'fr' ? "Me contacter" : "Get in Touch"}</a>
				</div>
			</div>

			<div style="position: relative; width: 260px; height: 330px; flex-shrink: 0; margin: 0 auto;">
				<img src="/assets/arthur.jpeg" alt="Arthur Doradoux" style="width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); position: relative; z-index: 2;" />
				<div style="position: absolute; bottom: -12px; right: -12px; width: 100%; height: 100%; border: 1px solid var(--pop-blue); border-radius: var(--radius); z-index: 1;"></div>
			</div>
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-fuchsia); --dot-color: var(--pop-fuchsia);">
			<div class="stacked-bg">{t('home.visionKicker')}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Profil & Ambitions' : 'Profile & Ambitions'}</h2>
		</div>

		<div class="card" style="padding: 36px;">
			<div style="font-size: 1.02rem; line-height: 1.8; display: flex; flex-direction: column; gap: 20px;">
				<p>{lang === 'fr' ? "Actuellement élève ingénieur à Mines Saint-Étienne (ISMIN), je construis un profil à la croisée de l’ingénierie, du design et du management. Ma formation m’a permis d’acquérir une solide rigueur technique à travers des projets en systèmes embarqués, hardware, architecture des processeurs et intelligence artificielle." : "Currently an engineering student at Mines Saint-Étienne (ISMIN), I am building a profile at the intersection of engineering, design and management."}</p>
				<p>{lang === 'fr' ? "Au fil de mes expériences associatives et professionnelles, j’ai compris que ce qui me motive ne se limite pas à la conception technique d’un système. Ce qui m’intéresse, c’est de comprendre pourquoi une technologie est développée, pour qui elle crée de la valeur, et comment la transformer en un produit utile et pertinent." : "Over time, I realized that what drives me most is not only the technical design of a system, but why a technology is developed and for whom it creates value."}</p>
				<p>{lang === 'fr' ? "À terme, je souhaite évoluer vers des fonctions de Product Owner / Product Manager, au croisement de la technique, de l’expérience utilisateur et de la stratégie." : "In the long term, I aim to grow into Product Owner / Product Manager roles."}</p>
				<div style="border-left: 2px solid var(--pop-fuchsia); padding-left: 16px; margin: 6px 0; font-style: italic; color: var(--text);">
					{lang === 'fr' ? "Mon objectif est de développer une véritable triple compétence entre ingénierie, design et management pour concevoir et piloter des produits technologiques innovants." : "My goal is to build a genuine triple competency across engineering, design and management."}
				</div>
			</div>
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue);">
			<div class="stacked-bg">{t('home.careerKicker')}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Expériences Professionnelles' : 'Work Experience'}</h2>
		</div>

		<div class="timeline" style="--dot-color: var(--pop-blue);">
			<div class="timeline-item">
				<div class="timeline-date">{lang === 'fr' ? 'Avr. 2026 — Juil. 2026' : 'Apr. 2026 — Jul. 2026'}</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo" src="/logo/advantest.png" alt="Advantest" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Stage Ingénieur R&D Test Cell Integration' : 'R&D Test Cell Integration Engineering Intern'}</h3>
              <span class="org-name-sub" style="color: var(--pop-blue);">Advantest <span style="color: var(--muted); font-weight: 500; text-transform: none;">— {lang === 'fr' ? 'Böblingen, Allemagne' : 'Böblingen, Germany'}</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--pop-blue);" set:html={lang === 'fr' ? `
            <ul>
              <li>Tests de PCBs de calibration destinés au test de puces IA/GPU.</li>
              <li>Modélisation et impression 3D d'un boîtier d'interface entre le testeur et l'ordinateur.</li>
              <li>Mesures et analyses de précision sur des PCBs à l'aide de Microscope, VNA et TDR.</li>
            </ul>
          ` : `
            <ul>
              <li>Testing calibration PCBs intended for AI/GPU chip testing.</li>
              <li>3D modeling and printing of an interface enclosure between the tester and the computer.</li>
              <li>Precision measurements and analysis on PCBs using a microscope, VNA and TDR.</li>
            </ul>
          `} />
          <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
            <span class="skill-tag">Hardware Testing</span>
            <span class="skill-tag">PCB Calibration</span>
            <span class="skill-tag">3D Printing</span>
            <span class="skill-tag">VNA / TDR</span>
          </div>
				</div>
			</div>

			<div class="timeline-item">
				<div class="timeline-date">{lang === 'fr' ? 'Jan. 2025 — Fév. 2025' : 'Jan. 2025 — Feb. 2025'}</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo logo-phinia" src="/logo/phinia.png" alt="PHINIA Delphi" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Stage Ingénieur Systèmes Hardware' : 'Hardware Systems Engineering Intern'}</h3>
              <span class="org-name-sub" style="color: var(--pop-blue);">PHINIA Delphi France <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Blois, France</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--pop-blue);" set:html={lang === 'fr' ? `
            <ul>
              <li>Configuration et tests de systèmes d'injection (plateforme ECU 24V).</li>
              <li>Découverte des bancs de tests industriels et des protocoles de validation hardware.</li>
              <li>Validation fonctionnelle d'ECU avec application Hydrogène (H2).</li>
              <li>Caractérisation thermique d'un ECU via communication CAN après adaptation de 12V à 24V.</li>
            </ul>
          ` : `
            <ul>
              <li>Configured and tested hardware/software using a 24V ECU platform.</li>
              <li>Introduction to industrial test benches and hardware validation protocols.</li>
              <li>Functional validation of ECUs for hydrogen-related applications.</li>
              <li>Performed thermal characterization using CAN communication after adaptation from 12V to 24V.</li>
            </ul>
          `} />
          <div style="margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap;">
            <span class="skill-tag">Embedded Systems</span>
            <span class="skill-tag">CAN Communication</span>
            <span class="skill-tag">Thermal Characterization</span>
            <span class="skill-tag">Hardware Validation</span>
          </div>
				</div>
			</div>
		</div>
	</section>

	<section style="padding: 40px 0;">
		<div class="stacked-title-wrapper" style="--stacked-color: var(--pop-orange); --dot-color: var(--pop-orange);">
			<div class="stacked-bg">{lang === 'fr' ? 'Diplômes' : 'Degrees'}</div>
			<h2 class="stacked-main">{lang === 'fr' ? 'Formation' : 'Education'}</h2>
		</div>

		<div class="timeline">
			<!-- Application de la couleur de l'école directement sur le timeline-item -->
			<div class="timeline-item" style="--dot-color: var(--school-emlyon);">
				<div class="timeline-date">2027 — 2028</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo" src="/logo/emlyon.png" alt="emlyon" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? 'Double Diplôme (Accepté)' : 'Double Degree (Accepted)'}</h3>
							<span class="org-name-sub" style="color: var(--school-emlyon);">emlyon business school <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Lyon, France</span></span>
						</div>
					</div>
					<div class="mission-list" style="--dot-color: var(--school-emlyon);" set:html={lang === 'fr' ? `
						<ul>
							<li><strong>Programme :</strong> Double Diplôme "Business Mediation".</li>
							<li><strong>Objectif :</strong> Compléter mon socle ingénieur/design par les outils financiers, stratégiques et managériaux nécessaires pour évoluer vers un rôle de Product Owner global.</li>
						</ul>
            <p style="margin-top: 12px; font-size: 0.85rem; font-style: italic; color: var(--muted);">* Ma candidature complète est disponible en français via le lien ci-dessous.</p>
					` : `
						<ul>
							<li><strong>Program:</strong> "Business Mediation" Double Degree.</li>
							<li><strong>Goal:</strong> Complement my engineering and design background with the financial, strategic, and managerial tools required for a global Product Owner role.</li>
						</ul>
            <p style="margin-top: 12px; font-size: 0.85rem; font-style: italic; color: var(--muted);">* Note: My full application file is available in French via the link below.</p>
					`} />

					<a href="/candidature_emlyon/index.html" target="_blank" style="display: inline-block; margin-top: 14px; font-size: 0.9rem; font-weight: 700; color: var(--school-emlyon); text-decoration: underline; text-underline-offset: 3px; transition: opacity 0.2s ease;">
						{lang === 'fr' ? 'Voir ma candidature emlyon (Format Web) →' : 'View my emlyon application (Web Format) →'}
					</a>
				</div>
			</div>

			<div class="timeline-item" style="--dot-color: var(--school-polimi);">
				<div class="timeline-date">{lang === 'fr' ? 'Sep. 2026 — Fév. 2027' : 'Sep. 2026 — Feb. 2027'}</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo force-white-bg" src="/logo/polimi.png" alt="Politecnico di Milano" />
						<div>
							<h3 class="role-name">Master in Design & Engineering</h3>
              <span class="org-name-sub" style="color: var(--school-polimi);">Politecnico di Milano <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Milan, Italie</span></span>
						</div>
					</div>
          <div class="mission-list" style="--dot-color: var(--school-polimi);" set:html={lang === 'fr' ? `
            <ul>
              <li><strong>Cours :</strong> Product Design Studio 1, UX Design, Design and Manufacturing, Virtual and Physical Prototyping.</li>
              <li><strong>Enjeu :</strong> Maîtriser l'ergonomie, le prototypage rapide et l'UX pour placer l'utilisateur au centre de la conception matérielle. Une compétence clé pour diriger des produits dans les entreprises technologiques innovantes.</li>
            </ul>
          ` : `
            <ul>
              <li><strong>Courses:</strong> Product Design Studio 1, UX Design, Design and Manufacturing, Virtual and Physical Prototyping.</li>
              <li><strong>Goal:</strong> Master ergonomics, rapid prototyping, and UX to put the user at the center of hardware design—a key skill for leading products in innovative tech companies.</li>
            </ul>
          `} />
				</div>
			</div>

			<div class="timeline-item" style="--dot-color: var(--school-emse);">
				<div class="timeline-date">2024 — 2027</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
						<img class="org-logo force-white-bg" src="/logo/emse.png" alt="Mines Saint-Étienne" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Diplôme d'ingénieur (Cursus ISMIN)" : "Engineering Degree (ISMIN Program)"}</h3>
              <span class="org-name-sub" style="color: var(--school-emse);">Mines de Saint-Étienne <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Gardanne, France</span></span>
						</div>
					</div>
          <div class="mission-list" style="--dot-color: var(--school-emse);" set:html={lang === 'fr' ? `
            <ul>
              <li><strong>Tronc commun :</strong> Microcontrôleurs, Électronique Numérique/Analogique, Systèmes Embarqués, Traitement du Signal, Architecture CPU, Cryptographie.</li>
              <li><strong>Électifs :</strong> IA pour la Production, FPGA & Sécurité, Entrepreneuriat.</li>
              <li><strong>Projet :</strong> Gagnant du hackathon robotique (programmation STM32).</li>
            </ul>
          ` : `
            <ul>
              <li><strong>Core curriculum:</strong> Microcontrollers, Digital and Analog Electronics, Embedded Systems, Signal Processing, CPU Architecture, Cryptography.</li>
              <li><strong>Electives:</strong> AI for Production, FPGA and Security, Entrepreneurship.</li>
              <li><strong>Project:</strong> Robotics hackathon winner (programmed using STM32 microcontroller).</li>
            </ul>
          `} />
				</div>
			</div>

      <div class="timeline-item" style="--dot-color: var(--muted);">
				<div class="timeline-date">2022 — 2024</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
            <img class="org-logo" src="/logo/pothier.png" alt="Lycée Pothier" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Classes Préparatoires (MPSI / MP*)" : "Intensive Preparatory Classes (CPGE)"}</h3>
              <span class="org-name-sub" style="color: var(--muted);">Lycée Pothier <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Orléans, France</span></span>
						</div>
					</div>
          <p style="margin-top: 10px;">{lang === 'fr' ? "Spécialités : Mathématiques, Physique, Informatique." : "Mathematics, Physics, Computer Science."}</p>
				</div>
			</div>

      <div class="timeline-item" style="--dot-color: var(--muted);">
				<div class="timeline-date">2019 — 2022</div>
				<div class="timeline-dot"></div>
				<div class="timeline-content">
					<div class="timeline-org-head">
            <img class="org-logo" src="/logo/nda.png" alt="Lycée Notre-Dame des Aydes" />
						<div>
							<h3 class="role-name">{lang === 'fr' ? "Baccalauréat Mention Bien (Section Européenne)" : "High School Diploma with Honors"}</h3>
              <span class="org-name-sub" style="color: var(--muted);">Lycée Notre-Dame des Aydes <span style="color: var(--muted); font-weight: 500; text-transform: none;">— Blois, France</span></span>
						</div>
					</div>
          <p style="margin-top: 10px;">{lang === 'fr' ? "Spécialités : Mathématiques, Physique-Chimie, HGGSP. Option Maths Expertes." : "Mathematics, Physics, Chemistry, Geopolitics, Advanced Mathematics option, European Track."}</p>
				</div>
			</div>
		</div>
	</section>

	<section id="contact" style="padding: 60px 0 40px; max-width: 1000px; margin: 0 auto;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue); margin-bottom: 40px; text-align: center;">
      <div class="stacked-bg" style="left: 50%; transform: translateX(-50%); width: 100%;">Contact</div>
      <h2 class="stacked-main" style="margin-left: 0;">{lang === 'fr' ? 'Me contacter' : 'Get in Touch'}</h2>
    </div>

		<div class="card contact-wrapper" style="padding: 40px; display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: center;">
			
			<div>
				<h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 600; margin: 10px 0 20px; line-height: 1.1;">
					{lang === 'fr' ? "Travaillons ensemble !" : "Let's Work Together"}
				</h2>
				<p style="color: var(--muted); font-size: 0.95rem; margin-bottom: 30px; line-height: 1.6;">
					{lang === 'fr' ? "À la recherche d'une opportunité en tant que Product Owner ou en développement hardware/software. Écrivez-moi directement !" : "Looking for an opportunity as a Product Owner or in hardware/software development. Drop me a line!"}
				</p>

				<div style="display: flex; flex-direction: column; gap: 20px;">
					<div style="display: flex; align-items: center; gap: 14px;">
						<div class="contact-icon-box">📞</div>
						<div>
							<div style="font-size: 0.8rem; color: var(--muted); font-weight: 600;">PHONE & WHATSAPP</div>
							<div style="font-size: 0.95rem; font-weight: 600;">+33 6 27 88 34 83</div>
						</div>
					</div>

					<div style="display: flex; align-items: center; gap: 14px;">
						<div class="contact-icon-box">in</div>
						<div>
							<div style="font-size: 0.8rem; color: var(--muted); font-weight: 600;">LINKEDIN</div>
							<a href="https://linkedin.com/in/arthur-doradoux/" target="_blank" style="font-size: 0.95rem; font-weight: 600; text-decoration: underline;">arthur-doradoux</a>
						</div>
					</div>

					<div style="display: flex; align-items: center; gap: 14px;">
						<div class="contact-icon-box">✉️</div>
						<div>
							<div style="font-size: 0.8rem; color: var(--muted); font-weight: 600;">EMAIL</div>
							<a href="mailto:arthur.doradoux@etu.emse.fr" style="font-size: 0.95rem; font-weight: 600; text-decoration: underline;">arthur.doradoux@etu.emse.fr</a>
						</div>
					</div>
				</div>
			</div>

			<form action="https://api.web3forms.com/submit" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
				<input type="hidden" name="access_key" value="87fde94b-7057-4663-9e22-63385526c25a" />
        <input type="hidden" name="subject" value="Nouveau contact depuis le portfolio !" />
        <input type="hidden" name="from_name" value="Arthur Doradoux - Portfolio" />
				
				<div>
					<label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px;">{lang === 'fr' ? "Nom" : "Name"}</label>
					<input type="text" name="name" required class="contact-input" placeholder={lang === 'fr' ? "Votre nom" : "Your name"} />
				</div>

				<div>
					<label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px;">Email</label>
					<input type="email" name="email" required class="contact-input" placeholder={lang === 'fr' ? "votre@email.com" : "your@email.com"} />
				</div>

				<div>
					<label style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px;">Message</label>
					<textarea name="message" required class="contact-textarea" placeholder={lang === 'fr' ? "Votre message..." : "Your message..."}></textarea>
				</div>

				<button type="submit" class="btn btn-primary" style="justify-content: center; margin-top: 6px; cursor: pointer;">
					{lang === 'fr' ? "Envoyer le message" : "Send Message"} →
				</button>
			</form>

		</div>
	</section>

  <style>
    .contact-icon-box {
      width: 38px; height: 38px; border-radius: 10px; background: var(--bg);
      border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.9rem; flex-shrink: 0;
    }
    .contact-input, .contact-textarea {
      width: 100%; padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-strong);
      background: var(--bg); color: var(--text); font-family: inherit; font-size: 0.95rem; outline: none;
      transition: border-color 0.2s;
    }
    .contact-input:focus, .contact-textarea:focus { border-color: var(--text); }
    .contact-textarea { min-height: 120px; resize: vertical; }

    @media (max-width: 800px) {
      .contact-wrapper { grid-template-columns: 1fr !important; padding: 24px !important; }
    }
  </style>

  <style is:global>
    body.theme-light .logo-phinia { background-color: var(--ink); }
    .mission-list, .impact-card ul, .accordion-body-inner ul {
      padding-left: 24px;
      margin-left: 4px;
    }
  </style>
</Layout>