      const tabs = document.querySelectorAll('.travel-tab');
      const pillEl = document.getElementById('travelPill');
      const titleEl = document.getElementById('travelTitle');
      const themeEl = document.getElementById('travelTheme');
      const bodyEl = document.getElementById('travelBody');
      const subspotsEl = document.getElementById('travelSubspots');
      const photoTxtEl = document.getElementById('photoPlaceholderTxt');
      const photoSubEl = document.getElementById('photoPlaceholderSub');
      const imgEl = document.getElementById('travelImage');
      const placeholderEl = document.getElementById('travelPlaceholder');
      const badgeTxtEl = document.getElementById('globeBadgeTxt');
      const canvas = document.getElementById('travelGlobeCanvas');

      let currentDest = 'france';

      const badgeLabels = {
        france: 'France // Paris • Lyon • Provence',
        egypt: lang === 'fr' ? 'Égypte // Le Caire • Louxor' : 'Egypt // Cairo • Luxor',
        nyc: 'United States // New York City',
        uk: lang === 'fr' ? 'Royaume-Uni // Londres' : 'United Kingdom // London',
        italy: lang === 'fr' ? 'Italie // Milan' : 'Italy // Milan',
        spain: lang === 'fr' ? 'Espagne // Barcelone • Madrid' : 'Spain // Barcelona • Madrid'
      };

      // Repères géographiques avec mise en valeur de la destination sélectionnée
      function getMarkers(activeKey) {
        return [
          // France (Paris, Lyon, Provence)
          { location: [48.8566, 2.3522], size: activeKey === 'france' ? 0.095 : 0.05, color: activeKey === 'france' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          { location: [45.7640, 4.8357], size: activeKey === 'france' ? 0.075 : 0.045, color: activeKey === 'france' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          { location: [43.4550, 5.4700], size: activeKey === 'france' ? 0.075 : 0.045, color: activeKey === 'france' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          // Égypte (Le Caire, Louxor)
          { location: [30.0444, 31.2357], size: activeKey === 'egypt' ? 0.095 : 0.05, color: activeKey === 'egypt' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          { location: [25.6872, 32.6396], size: activeKey === 'egypt' ? 0.075 : 0.045, color: activeKey === 'egypt' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          // New York (USA)
          { location: [40.7128, -74.0060], size: activeKey === 'nyc' ? 0.095 : 0.05, color: activeKey === 'nyc' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          // Londres (UK)
          { location: [51.5074, -0.1278], size: activeKey === 'uk' ? 0.095 : 0.05, color: activeKey === 'uk' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          // Italie (Milan)
          { location: [45.4642, 9.1900], size: activeKey === 'italy' ? 0.095 : 0.05, color: activeKey === 'italy' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          // Espagne (Barcelone, Madrid)
          { location: [41.3851, 2.1734], size: activeKey === 'spain' ? 0.095 : 0.05, color: activeKey === 'spain' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] },
          { location: [40.4168, -3.7038], size: activeKey === 'spain' ? 0.075 : 0.045, color: activeKey === 'spain' ? [1, 0.75, 0.1] : [0.35, 0.65, 1] }
        ];
      }

      // Arcs de voyage depuis la France (Paris) vers les autres destinations
      const flightArcs = [
        { from: [48.8566, 2.3522], to: [40.7128, -74.0060], color: [1, 0.6, 0.2] }, // Paris -> NYC
        { from: [48.8566, 2.3522], to: [30.0444, 31.2357], color: [1, 0.7, 0.2] },  // Paris -> Le Caire
        { from: [48.8566, 2.3522], to: [51.5074, -0.1278], color: [0.4, 0.7, 1.0] }, // Paris -> Londres
        { from: [48.8566, 2.3522], to: [41.3851, 2.1734], color: [1, 0.5, 0.3] },  // Paris -> Barcelone
        { from: [48.8566, 2.3522], to: [45.4642, 9.1900], color: [0.4, 0.8, 0.9] },  // Paris -> Milan
        { from: [30.0444, 31.2357], to: [25.6872, 32.6396], color: [1, 0.7, 0.2] }, // Le Caire -> Louxor
        { from: [48.8566, 2.3522], to: [45.7640, 4.8357], color: [0.5, 0.8, 1.0] },  // Paris -> Lyon
        { from: [45.7640, 4.8357], to: [43.4550, 5.4700], color: [0.5, 0.8, 1.0] },  // Lyon -> Provence
      ];

      // Met à jour la carte d'information et synchronise le globe
      function selectDestination(key, syncGlobe = true) {
        currentDest = key;
        const item = travelData[key];
        if (!item) return;

        tabs.forEach(t => {
          const isActive = t.getAttribute('data-dest') === key;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        const currentLang = lang === 'en' ? 'en' : 'fr';
        if (pillEl) pillEl.textContent = item.pill;
        if (titleEl) titleEl.textContent = item.title[currentLang];
        if (themeEl) themeEl.textContent = item.theme[currentLang];
        if (bodyEl) bodyEl.textContent = item.body[currentLang];
        if (photoTxtEl) photoTxtEl.textContent = item.photoTxt[currentLang];
        if (photoSubEl) photoSubEl.textContent = item.photoSub[currentLang];

        if (badgeTxtEl && badgeLabels[key]) {
          badgeTxtEl.textContent = badgeLabels[key];
        }

        if (subspotsEl) {
          subspotsEl.innerHTML = '';
          (item.subspots || []).forEach(spot => {
            const chip = document.createElement('span');
            chip.className = 'subspot-chip';
            chip.textContent = spot;
            subspotsEl.appendChild(chip);
          });
        }

        if (imgEl) {
          imgEl.style.display = 'block';
          if (placeholderEl) placeholderEl.style.display = 'none';
          imgEl.onerror = () => {
            imgEl.style.display = 'none';
            if (placeholderEl) placeholderEl.style.display = 'flex';
          };
          imgEl.src = '/assets/voyages/' + item.imgFile;
        }

        if (syncGlobe && window.rotateGlobeTo) {
          window.rotateGlobeTo(item.centerLat, item.centerLon, key);
        }
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const key = tab.getAttribute('data-dest');
          selectDestination(key, true);
        });
      });

      // --- MOTEUR DU GLOBE 3D COBE WEBGL (Continents détaillés, rotation fluide et repères) ---
      async function initCobeGlobe() {
        if (!canvas) return;
        try {
          const { default: createGlobe } = await import('/scripts/cobe.js');

          // Orientation initiale sur la France
          let phi = -1.61;
          let theta = 0.55;
          let targetPhi = -1.61;
          let targetTheta = 0.55;
          let isDragging = false;
          let lastX = 0, lastY = 0;
          let autoSpin = true;
          let autoSpinTimer = null;

          const isDark = document.body.classList.contains('theme-dark');
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const size = 350;

          const globe = createGlobe(canvas, {
            devicePixelRatio: dpr,
            width: size * dpr,
            height: size * dpr,
            phi: phi,
            theta: theta,
            dark: isDark ? 1 : 0,
            diffuse: isDark ? 1.3 : 1.4,
            scale: 1.05,
            mapSamples: 22000,
            mapBrightness: isDark ? 8 : 4.5,
            baseColor: isDark ? [0.1, 0.15, 0.24] : [0.92, 0.94, 0.98],
            markerColor: [1, 0.65, 0.1],
            glowColor: isDark ? [0.18, 0.32, 0.58] : [0.85, 0.9, 1.0],
            arcColor: [0.35, 0.65, 1.0],
            arcWidth: 0.6,
            arcHeight: 0.25,
            markerElevation: 0.03,
            markers: getMarkers(currentDest),
            arcs: flightArcs,
            onRender: (state) => {
              if (autoSpin) {
                targetPhi += 0.0022;
              }
              phi += (targetPhi - phi) * 0.07;
              theta += (targetTheta - theta) * 0.07;
              state.phi = phi;
              state.theta = theta;
            }
          });

          // Méthode globale pour faire pivoter le globe sur la destination sélectionnée
          window.rotateGlobeTo = function(lat, lon, key) {
            autoSpin = false;
            clearTimeout(autoSpinTimer);
            targetPhi = -Math.PI / 2 - (lon * Math.PI) / 180;
            targetTheta = Math.max(-0.6, Math.min(0.8, (lat * Math.PI) / 180));
            globe.update({ markers: getMarkers(key || currentDest) });
            autoSpinTimer = setTimeout(() => { autoSpin = true; }, 5000);
          };

          // Gestion du drag interactif à la souris et au toucher
          canvas.addEventListener('pointerdown', (e) => {
            isDragging = true;
            autoSpin = false;
            clearTimeout(autoSpinTimer);
            lastX = e.clientX;
            lastY = e.clientY;
            canvas.setPointerCapture(e.pointerId);
          });

          window.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            const dx = e.clientX - lastX;
            const dy = e.clientY - lastY;
            lastX = e.clientX;
            lastY = e.clientY;

            targetPhi += dx * 0.007;
            targetTheta = Math.max(-0.7, Math.min(0.85, targetTheta - dy * 0.007));
          });

          function handlePointerEnd(e) {
            if (!isDragging) return;
            isDragging = false;
            try { canvas.releasePointerCapture(e.pointerId); } catch(err){}
            autoSpinTimer = setTimeout(() => { autoSpin = true; }, 4000);
          }
          window.addEventListener('pointerup', handlePointerEnd);
          window.addEventListener('pointercancel', handlePointerEnd);

          // Support dynamique du changement de thème sombre / clair
          const themeObserver = new MutationObserver(() => {
            const darkNow = document.body.classList.contains('theme-dark');
            globe.update({
              dark: darkNow ? 1 : 0,
              diffuse: darkNow ? 1.3 : 1.4,
              mapBrightness: darkNow ? 8 : 4.5,
              baseColor: darkNow ? [0.1, 0.15, 0.24] : [0.92, 0.94, 0.98],
              glowColor: darkNow ? [0.18, 0.32, 0.58] : [0.85, 0.9, 1.0],
            });
          });
          themeObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });

        } catch (err) {
          console.error('Erreur chargement Cobe globe:', err);
        }
      }

      initCobeGlobe();

      // Initialiser par défaut sur la France
      selectDestination('france', false);

      // Secret mobile triggers sur les passions
      let f1Tap = 0, f1Timer = null;
      document.getElementById('aboutF1Section')?.addEventListener('pointerdown', () => {
        f1Tap++;
        clearTimeout(f1Timer);
        f1Timer = setTimeout(() => {
          if (f1Tap >= 3 && window.startF1) {
            window.startF1();
          }
          f1Tap = 0;
        }, 450);
      });

      let vitTap = 0, vitTimer = null;
      document.getElementById('aboutVitalitySection')?.addEventListener('pointerdown', () => {
        vitTap++;
        clearTimeout(vitTimer);
        vitTimer = setTimeout(() => {
          if (vitTap >= 3 && window.startVitality) {
            window.startVitality();
          }
          vitTap = 0;
        }, 450);
      });
    })();
  </script>
