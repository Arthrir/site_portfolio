---
import Layout from '../layouts/Layout.astro';
import { getLangFromCookie, makeT } from '../i18n/translations';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = makeT(lang);

const sections = [
  {
    title: lang === 'fr' ? "Systèmes embarqués & Hardware" : "Embedded Systems & Hardware",
    skills: ["C / C++ embarqué", "Assembleur", "STM32 (HAL / LL)", "ESP32", "FPGA", "SystemVerilog / VHDL", "Architecture RISC-V", "Conception PCB (KiCad)", "Prototypage matériel", "Électronique analogique", "Électronique numérique", "Capteurs & instrumentation", "Bus de communication (I2C, SPI, UART, CAN)"]
  },
  {
    title: lang === 'fr' ? "RF, IoT & Mesures" : "RF, IoT & High‑Frequency",
    skills: ["IoT", "RF", "LoRa", "BLE", "Caractérisation RF", "Adaptation d’impédance", "Analyse S-parameters", "VNA", "TDR", "CEM"]
  },
  {
    title: lang === 'fr' ? "Informatique & Logiciel" : "Software & Computing",
    skills: ["Python", "C / C++", "Linux / Bash", "Git", "CI/CD", "Programmation réseau (TCP/IP, Sockets)", "Multithreading", "Rust", "OCaml", "SQL"]
  },
  {
    title: lang === 'fr' ? "Data, IA & Python scientifique" : "Data, AI & Scientific Python",
    skills: ["NumPy", "Pandas", "Matplotlib", "Seaborn", "SciPy", "scikit-learn", "TensorFlow", "Keras", "PyTorch", "Traitement du signal", "IA embarquée"]
  },
  {
    title: lang === 'fr' ? "Sécurité & Réseaux" : "Cybersecurity & Networks",
    skills: ["Cybersécurité", "Cryptographie (ASCON)", "OSINT", "Linux", "Sécurité des réseaux", "Social Engineering"]
  },
  {
    title: lang === 'fr' ? "Design Produit (Polimi)" : "Product Design (Polimi)",
    skills: ["Product Design Studio 1", "UX Design", "Design & Manufacturing", "Virtual & Physical Prototyping"]
  },
  {
    title: "Toolbox", 
    skills: ["STM32CubeIDE", "Vivado", "ModelSim", "MATLAB / Simulink", "LTSpice", "Logisim Evolution", "Vector CANalyzer", "Oscilloscope", "GBF", "VS Code", "Figma", "Unity"]
  },
  {
    title: "Management & Soft Skills",
    skills: ["Product Management", "Gestion de Projet (Cycle en V / Agile)", "Leadership d'équipe", "Communication technique", "Organisation d’événements", "Gestion de Budget (> 25k€)", "Communication Institutionnelle", "Planification"]
  }
];
---

<Layout title={lang === 'fr' ? "Arthur Doradoux | Compétences" : "Arthur Doradoux | Skills"}>
  <section style="padding: 20px 0 40px; max-width: 800px; margin: 0 auto; text-align: center;">
    <div class="stacked-title-wrapper" style="--stacked-color: var(--pop-blue); --dot-color: var(--pop-blue); display: inline-block;">
      <div class="stacked-bg" style="left: 50%; transform: translateX(-50%); width: 100%;">{lang === 'fr' ? 'Boîte à outils' : 'Toolbox'}</div>
      <h2 class="stacked-main" style="margin-left: 0;">{lang === 'fr' ? 'Compétences & Langues' : 'Skills & Languages'}</h2>
    </div>
  </section>

  <!-- NOUVEAU DESIGN : Cartes de Langues & Certifications centrées et fun -->
  <section style="padding: 0 0 60px; max-width: 900px; margin: 0 auto;">
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px;">
      
      <!-- Français -->
      <div class="cred-card" style="--card-accent: var(--pop-blue);">
        <div class="cred-icon">🇫🇷</div>
        <div class="cred-title">Français</div>
        <div class="cred-desc">{lang === 'fr' ? 'Langue maternelle' : 'Native Speaker'}</div>
      </div>

      <!-- Anglais -->
      <div class="cred-card" style="--card-accent: var(--pop-orange);">
        <div class="cred-icon">🇬🇧</div>
        <div class="cred-title">English</div>
        <div class="cred-desc">
          {lang === 'fr' ? 'Courant — C1' : 'Fluent — C1'}<br/>
          <strong style="color: var(--text); font-weight: 700;">TOEIC 955/990</strong>, TOEFL, Cambridge
        </div>
      </div>

      <!-- Allemand -->
      <div class="cred-card" style="--card-accent: var(--pop-yellow);">
        <div class="cred-icon">🇩🇪</div>
        <div class="cred-title">Deutsch</div>
        <div class="cred-desc">{lang === 'fr' ? 'Intermédiaire — B1' : 'Intermediate — B1'}</div>
      </div>

      <!-- Certifications -->
      <div class="cred-card" style="--card-accent: var(--pop-fuchsia);">
        <div class="cred-icon">🏅</div>
        <div class="cred-title">Certifications</div>
        <div class="cred-desc">
          Label HandiManagement<br/>
          {lang === 'fr' ? 'PSC1 (Secourisme)' : 'First Aid (PSC1)'}
        </div>
      </div>

    </div>
  </section>

  <!-- Grille de compétences (Style Bento / Ghost Tags) -->
  <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; padding-bottom: 60px;">
    {sections.map(section => (
      <div class="skill-category">
        <h3 class="skill-cat-title">{section.title}</h3>
        <div class="skill-ghost-list">
          {section.skills.map(skill => (
            <span class="ghost-tag">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </section>

  <style>
    /* Design des Cartes Fun (Langues/Certifs) */
    .cred-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-top: 3px solid var(--card-accent);
      border-radius: 16px;
      padding: 20px 24px;
      text-align: center;
      flex: 1 1 200px;
      max-width: 280px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      transition: transform 0.25s var(--ease-premium), box-shadow 0.25s var(--ease-premium), border-color 0.2s;
    }
    .cred-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
      border-color: var(--card-accent);
    }
    .cred-icon {
      font-size: 2rem;
      margin-bottom: 4px;
    }
    .cred-title {
      font-family: var(--font-serif);
      font-weight: 600;
      font-size: 1.15rem;
      color: var(--text);
      line-height: 1.2;
    }
    .cred-desc {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.5;
    }

    /* Design Épuré des Compétences */
    .skill-category {
      background: transparent;
    }
    .skill-cat-title {
      font-size: 1.1rem; font-weight: 600; margin-bottom: 16px; color: var(--text);
      border-bottom: 2px solid var(--border); padding-bottom: 8px;
    }
    .skill-ghost-list {
      display: flex; flex-wrap: wrap; gap: 8px;
    }
    .ghost-tag {
      font-size: 0.85rem; font-weight: 500; color: var(--muted);
      padding: 4px 10px; border-radius: 6px;
      border: 1px solid var(--border); background: var(--card-bg);
      transition: border-color 0.2s, color 0.2s;
    }
    .ghost-tag:hover {
      border-color: var(--text); color: var(--text);
    }
  </style>
</Layout>