            <path d="M935.956 478.988L936.506 479.504C938.2 484.541 933.748 542.45 932.589 550.758C932.032 554.541 931.123 558.264 929.883 561.881C923.789 580.173 917.614 584.693 901.574 592.772C910.324 613.28 918.802 635.519 927.118 656.296L974.65 775.126L1005.97 853.396C1011.45 867.084 1018.71 883.772 1023.24 897.386C1019.31 895.729 1014.57 893.22 1010.67 891.305C1006.76 889.413 1003.05 887.44 999.204 885.393C967.184 802.399 932.502 720.137 900.1 637.264C893.367 620.055 885.997 602.937 879.675 585.587C914.467 568.919 916.147 564.039 918.024 523.033C918.552 511.464 919.894 499.009 919.924 487.104L935.956 478.988Z"/>
