---
// src/components/MinitelTerminal.astro
// Retro 3615 Minitel CRT Terminal Easter Egg
---

<div id="minitelModal" class="minitel-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Terminal 3615 Minitel">
  <div class="minitel-backdrop" id="minitelBackdrop"></div>

  <div class="minitel-container" id="minitelContainer">
    <!-- Bouton Quitter bien intégré sur le châssis rétro beige -->
    <div class="minitel-top-bar">
      <span class="minitel-model-badge">MINITEL 1B • ALCATEL</span>
      <button type="button" class="minitel-close-btn" id="minitelCloseBtn" aria-label="Quitter le Minitel" title="Quitter (Échap)">✕ QUITTER [ÉCHAP]</button>
    </div>

    <!-- Écran Cathodique CRT -->
    <div class="minitel-crt">
      <div class="minitel-screen" id="minitelScreen">
        <div class="minitel-scanlines"></div>

        <!-- Grand logo MINITEL en ASCII Art pixelisé en filigrane d'arrière-plan -->
        <div class="minitel-ascii-bg" aria-hidden="true">
███    ███ ██ ███    ██ ████████ ████████ ███████ ██     
████  ████ ██ ████   ██    ██       ██    ██      ██     
██ ████ ██ ██ ██ ██  ██    ██       ██    █████   ██     
██  ██  ██ ██ ██  ██ ██    ██       ██    ██      ██     
██      ██ ██ ██   ████    ██       ██    ███████ ███████
        </div>

        <div class="minitel-content" id="minitelContent">
          <div class="minitel-line minitel-blink">CONNEXION 3615 MINITEL...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .minitel-modal {
    position: fixed; inset: 0; z-index: 10000;
    display: flex; align-items: center; justify-content: center;
    background: #000;
    padding: 16px;
  }
  .minitel-backdrop {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
  }
  .minitel-container {
    position: relative; z-index: 2;
    width: 90vw; max-width: 820px;
    height: 74vh; max-height: 580px;
    background: #20221d;
    border: 14px solid #c8c4b7;
    border-radius: 16px;
    box-shadow: inset 0 0 16px rgba(0,0,0,0.85), 0 20px 50px rgba(0,0,0,0.9);
    transform: scale(0.1);
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: flex;
    flex-direction: column;
  }
  .minitel-container.open {
    transform: scale(1);
    opacity: 1;
  }

  .minitel-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    background: #2a2d26;
    border-bottom: 2px solid #141712;
    user-select: none;
  }
  .minitel-model-badge {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #a39e91;
  }
  .minitel-close-btn {
    background: #393d34;
    color: #f0ece1;
    border: 1.5px solid #757165;
    border-radius: 4px;
    padding: 3px 10px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    transition: all 0.15s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .minitel-close-btn:hover,
  .minitel-close-btn:active {
    background: #b92b27;
    color: #ffffff;
    border-color: #ff5752;
  }

  .minitel-crt {
    position: relative;
    flex: 1;
    background: #050a05;
    border-radius: 6px;
    overflow: hidden;
    border: 8px solid #121612;
    box-shadow: inset 0 0 30px rgba(105, 255, 10, 0.12);
    display: flex;
    flex-direction: column;
  }
  .minitel-screen {
    position: relative;
    flex: 1;
    background: repeating-linear-gradient(0deg, #070e07 0px, #070e07 2px, #040804 2px, #040804 4px);
    background-size: 100% 4px;
    padding: 24px 26px;
    font-family: 'Courier New', Courier, monospace;
    color: #69FF0A; /* Vert phosphore authentique */
    font-size: 1.15rem;
    line-height: 1.55;
    text-shadow: 0 0 6px rgba(105, 255, 10, 0.7);
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .minitel-screen::-webkit-scrollbar {
    display: none;
  }

  /* Scanlines CRT et lueur */
  .minitel-scanlines {
    position: absolute; inset: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(0, 255, 10, 0.03), rgba(0, 255, 10, 0.01), rgba(0, 255, 10, 0.03));
    background-size: 100% 4px, 4px 100%;
    pointer-events: none;
    z-index: 10;
  }

  /* Grand filigrane ASCII Art pixelisé en arrière-plan */
  .minitel-ascii-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Courier New', Courier, monospace;
    font-size: clamp(0.68rem, 1.7vw, 1.2rem);
    line-height: 1.15;
    color: #69FF0A;
    opacity: 0.12;
    pointer-events: none;
    user-select: none;
    white-space: pre;
    text-align: center;
    z-index: 2;
    text-shadow: 0 0 12px rgba(105, 255, 10, 0.5);
  }

  .minitel-content {
    position: relative;
    z-index: 5;
  }
  .minitel-line {
    margin-bottom: 8px;
    word-break: break-all;
    letter-spacing: 0.03em;
  }
  .minitel-clickable {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-shadow 0.15s ease;
    user-select: none;
    display: inline-block;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .minitel-clickable:hover,
  .minitel-clickable:active {
    background: rgba(105, 255, 10, 0.25);
    color: #ffffff;
    text-shadow: 0 0 10px #69FF0A, 0 0 16px #ffffff;
  }
  .minitel-blink {
    animation: minitelBlink 0.9s step-end infinite;
  }
  @keyframes minitelBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .minitel-input-line {
    display: flex;
    align-items: center;
    margin-top: 10px;
    gap: 8px;
  }
  .minitel-prompt {
    color: #69FF0A;
    font-weight: 700;
    text-shadow: 0 0 8px rgba(105, 255, 10, 0.8);
    user-select: none;
    font-size: 1.25rem;
  }
  .minitel-input {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    color: #69FF0A !important;
    font-family: 'Courier New', Courier, monospace !important;
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    text-shadow: 0 0 8px rgba(105, 255, 10, 0.8) !important;
    flex: 1;
    text-transform: uppercase;
    padding: 0 !important;
    margin: 0 !important;
    caret-color: #69FF0A !important;
  }
  .minitel-input::selection {
    background: #69FF0A;
    color: #040804;
  }

  /* Responsive Mobile */
  @media (max-width: 640px) {
    .minitel-modal { padding: 8px; }
    .minitel-container {
      width: 96vw; max-width: 96vw;
      height: 82vh; max-height: 560px;
      border: 8px solid #c8c4b7;
      border-radius: 12px;
    }
    .minitel-top-bar { padding: 4px 8px; }
    .minitel-model-badge { font-size: 0.62rem; }
    .minitel-close-btn { font-size: 0.65rem; padding: 2px 7px; }
    .minitel-crt { border: 3px solid #121612; }
    .minitel-screen {
      padding: 16px 12px;
      font-size: 0.88rem;
      line-height: 1.45;
    }
    .minitel-ascii-bg {
      font-size: 0.58rem;
    }
    .minitel-prompt { font-size: 1rem; }
    .minitel-input { font-size: 0.88rem !important; }
  }
</style>

<script is:inline>
  (function initMinitel() {
    const modal = document.getElementById('minitelModal');
    const container = document.getElementById('minitelContainer');
    const content = document.getElementById('minitelContent');
    const backdrop = document.getElementById('minitelBackdrop');
    const closeBtn = document.getElementById('minitelCloseBtn');
    const screenEl = document.getElementById('minitelScreen');

    function writeLine(text, delay = 0) {
      return new Promise(resolve => {
        setTimeout(() => {
          const div = document.createElement('div');
          div.className = 'minitel-line';
          div.textContent = text;
          content.appendChild(div);
          if (screenEl) screenEl.scrollTop = screenEl.scrollHeight;
          resolve();
        }, delay);
      });
    }

    function writeLineHtml(html, delay = 0) {
      return new Promise(resolve => {
        setTimeout(() => {
          const div = document.createElement('div');
          div.className = 'minitel-line';
          div.innerHTML = html;
          content.appendChild(div);
          if (screenEl) screenEl.scrollTop = screenEl.scrollHeight;
          resolve();
        }, delay);
      });
    }

    function createInput() {
      const oldInputs = content.querySelectorAll('input');
      oldInputs.forEach(inp => { inp.disabled = true; inp.style.opacity = '0.6'; });

      const div = document.createElement('div');
      div.className = 'minitel-input-line';
      div.innerHTML = `<span class="minitel-prompt">&gt;</span><input type="text" class="minitel-input" autocomplete="off" spellcheck="false" />`;
      content.appendChild(div);
      const input = div.querySelector('input');

      if (screenEl) {
        screenEl.onclick = (e) => {
          if (!e.target.closest('.minitel-clickable')) {
            input.focus();
          }
        };
      }

      const isMobile = window.matchMedia('(max-width: 640px)').matches;
      if (!isMobile) {
        input.focus();
      }

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const val = input.value.trim().toUpperCase();
          input.disabled = true;
          input.style.opacity = '0.6';
          processCommand(val);
        } else if (e.key === 'Escape') {
          closeMinitel();
        }
      });
    }

    async function processCommand(cmd) {
      const isEn = document.documentElement.lang === 'en';
      if (cmd === 'F1' || cmd === '1') {
        await writeLine('LANCEMENT GRAND PRIX F1...', 200);
        setTimeout(() => {
          closeMinitel();
          if (window.startF1) window.startF1();
        }, 400);
      } else if (cmd === 'VITALITY' || cmd === '2') {
        await writeLine('LANCEMENT VITALITY AIM LAB...', 200);
        setTimeout(() => {
          closeMinitel();
          if (window.startVitality) window.startVitality();
        }, 400);
      } else if (cmd === 'BLACKJACK' || cmd === 'BJ' || cmd === '3') {
        await writeLine('LANCEMENT TIPE BLACKJACK & STRATÉGIE...', 200);
        setTimeout(() => {
          closeMinitel();
          if (window.startBlackjack) window.startBlackjack();
        }, 400);
      } else if (cmd === 'EXIT' || cmd === 'QUITTER' || cmd === 'QUIT' || cmd === '4') {
        await writeLine('DÉCONNEXION DU SERVEUR...', 150);
        setTimeout(closeMinitel, 300);
      } else if (cmd === 'HELP' || cmd === 'AIDE' || cmd === '?') {
        await writeLine('SOMMAIRE DES PROGRAMMES :', 120);
        await writeLineHtml('<span class="minitel-clickable" data-choice="F1">  1 / F1        : GRAND PRIX RACING</span>', 50);
        await writeLineHtml('<span class="minitel-clickable" data-choice="VITALITY">  2 / VITALITY  : AIM & REFLEX LAB</span>', 50);
        await writeLineHtml('<span class="minitel-clickable" data-choice="BLACKJACK">  3 / BLACKJACK : TIPE 21 & ASSISTANT PROBAS</span>', 50);
        await writeLineHtml('<span class="minitel-clickable" data-choice="QUITTER">  4 / QUITTER   : RETOUR AU SITE</span>', 50);
        createInput();
      } else if (cmd !== '') {
        await writeLine('COMMANDE NON RECONNUE. TAPEZ 1, 2, 3, 4 OU AIDE.', 150);
        createInput();
      } else {
        createInput();
      }
    }

    async function startBootSequence() {
      content.innerHTML = '';
      await writeLine('CONNEXION...', 200);
      await writeLine('3615 MINITEL EST EN LIGNE.', 350);
      await writeLine('BIENVENUE SUR LE RÉSEAU ARTHUR DORADOUX.', 250);
      await writeLine('CHOIX DISPONIBLES (CLIQUEZ SUR UNE LIGNE OU TAPEZ) :', 150);
      await writeLineHtml('<span class="minitel-clickable" data-choice="F1">► 1 : F1 GRAND PRIX RACING</span>', 60);
      await writeLineHtml('<span class="minitel-clickable" data-choice="VITALITY">► 2 : VITALITY AIM LAB</span>', 60);
      await writeLineHtml('<span class="minitel-clickable" data-choice="BLACKJACK">► 3 : BLACKJACK (TIPE 21 & MATHS)</span>', 60);
      await writeLineHtml('<span class="minitel-clickable" data-choice="QUITTER">► 4 : QUITTER LE TERMINAL</span>', 60);
      createInput();
    }

    function openMinitel() {
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        void container.offsetWidth;
        container.classList.add('open');
        startBootSequence();
      }
    }

    function closeMinitel() {
      if (modal) {
        document.body.style.overflow = '';
        container.classList.remove('open');
        setTimeout(() => {
          modal.style.display = 'none';
        }, 350);
      }
    }

    window.startMinitel = openMinitel;

    backdrop?.addEventListener('click', closeMinitel);
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMinitel();
    });

    // Clic tactile direct sur les options du terminal
    content?.addEventListener('click', (e) => {
      const clickable = e.target.closest('.minitel-clickable');
      if (clickable) {
        e.stopPropagation();
        const choice = clickable.getAttribute('data-choice');
        if (choice) processCommand(choice);
      }
    });

    // Détection clavier "minitel" ou "3615"
    let keyBuffer = '';
    window.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') {
        if (e.key === 'Escape') closeMinitel();
        return;
      }
      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        keyBuffer += e.key.toLowerCase();
        if (keyBuffer.length > 20) keyBuffer = keyBuffer.slice(-20);
        if (keyBuffer.endsWith('minitel') || keyBuffer.endsWith('3615')) {
          openMinitel();
          keyBuffer = '';
        }
      }
    });

  })();
</script>
