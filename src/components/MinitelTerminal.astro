---
// src/components/MinitelTerminal.astro
// Retro terminal easter egg
---

<div id="minitelModal" class="minitel-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Terminal Minitel">
  <div class="minitel-backdrop" id="minitelBackdrop"></div>

  <div class="minitel-container" id="minitelContainer">
    <div class="minitel-crt">
      <div class="minitel-screen">
        <div class="minitel-watermark">
  __  __ ___ _   _ ___ _____ _____ _     
 |  \/  |_ _| \ | |_ _|_   _| ____| |    
 | |\/| || ||  \| || |  | | |  _| | |    
 | |  | || || |\  || |  | | | |___| |___ 
 |_|  |_|___|_| \_|___| |_| |_____|_____|
   [ CLUB RESEAU & INFORMATIQUE - EMSE ]
        </div>
        <div class="minitel-scanlines"></div>
        <div class="minitel-content" id="minitelContent">
          <div class="minitel-line minitel-blink">CONNEXION 3615 MINITEL...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .minitel-modal {
    position: fixed; inset: 0; z-index: 10000;
    display: flex; align-items: center; justify-content: center;
    background: #000;
  }
  .minitel-backdrop {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
  }
  .minitel-container {
    position: relative; z-index: 2;
    width: 90vw; max-width: 820px;
    height: 72vh; max-height: 600px;
    background: #181916;
    border: 18px solid #c9c5ba;
    border-radius: 20px 20px 12px 12px;
    box-shadow: inset 0 0 16px rgba(0,0,0,0.9), 0 16px 40px rgba(0,0,0,0.9);
    transform: scale(0.1);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .minitel-container.open {
    transform: scale(1);
    opacity: 1;
  }
  .minitel-crt {
    position: relative; width: 100%; height: 100%;
    background: #050a05;
    border-radius: 8px;
    overflow: hidden;
    border: 8px solid #141814;
    box-shadow: inset 0 0 24px rgba(105, 255, 10, 0.12);
  }
  .minitel-screen {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(0deg, #070e07 0px, #070e07 2px, #040804 2px, #040804 4px);
    background-size: 100% 4px;
    padding: 24px;
    font-family: 'Courier New', Courier, monospace;
    color: #69FF0A; /* Authentique vert MINITEL */
    font-size: 1.15rem;
    line-height: 1.55;
    text-shadow: 0 0 6px rgba(105, 255, 10, 0.7);
    overflow-y: auto;
  }
  .minitel-watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: monospace;
    font-size: clamp(0.6rem, 1.4vw, 0.82rem);
    line-height: 1.15;
    color: #69FF0A;
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
    white-space: pre;
    z-index: 1;
    text-shadow: none;
  }
  .minitel-scanlines {
    position: absolute; inset: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(0, 255, 10, 0.03), rgba(0, 255, 10, 0.01), rgba(0, 255, 10, 0.03));
    background-size: 100% 4px, 4px 100%;
    pointer-events: none;
    z-index: 10;
  }
  .minitel-content {
    position: relative;
    z-index: 5;
  }
  .minitel-line {
    margin-bottom: 8px;
    word-break: break-all;
    letter-spacing: 0.03em;
  }
  .minitel-blink {
    animation: minitelBlink 0.9s step-end infinite;
  }
  @keyframes minitelBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .minitel-input-line {
    display: flex;
    align-items: center;
    margin-top: 10px;
    gap: 8px;
  }
  .minitel-prompt {
    color: #69FF0A;
    font-weight: 700;
    text-shadow: 0 0 8px rgba(105, 255, 10, 0.8);
    user-select: none;
    font-size: 1.25rem;
  }
  .minitel-input {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    outline: none !important;
    box-shadow: none !important;
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    color: #69FF0A !important;
    font-family: 'Courier New', Courier, monospace !important;
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    text-shadow: 0 0 8px rgba(105, 255, 10, 0.8) !important;
    flex: 1;
    text-transform: uppercase;
    padding: 0 !important;
    margin: 0 !important;
    caret-color: #69FF0A !important;
  }
  .minitel-input::selection {
    background: #69FF0A;
    color: #040804;
  }
</style>

<script is:inline>
  (function initMinitel() {
    const modal = document.getElementById('minitelModal');
    const container = document.getElementById('minitelContainer');
    const content = document.getElementById('minitelContent');
    const backdrop = document.getElementById('minitelBackdrop');

    let isTyping = false;
    
    function writeLine(text, delay = 0) {
      return new Promise(resolve => {
        setTimeout(() => {
          const div = document.createElement('div');
          div.className = 'minitel-line';
          div.textContent = text;
          content.appendChild(div);
          content.parentElement.scrollTop = content.parentElement.scrollHeight;
          resolve();
        }, delay);
      });
    }

    function createInput() {
      const div = document.createElement('div');
      div.className = 'minitel-input-line';
      div.innerHTML = `<span class="minitel-prompt">&gt;</span><input type="text" class="minitel-input" autocomplete="off" spellcheck="false" autofocus />`;
      content.appendChild(div);
      const input = div.querySelector('input');
      
      // Ensure click focuses input
      content.parentElement.onclick = () => input.focus();
      input.focus();
      
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const val = input.value.trim().toUpperCase();
          input.disabled = true;
          input.style.opacity = '0.6';
          processCommand(val);
        } else if (e.key === 'Escape') {
          closeMinitel();
        }
      });
    }

    async function processCommand(cmd) {
      const isEn = document.documentElement.lang === 'en';
      if (cmd === 'F1' || cmd === '1') {
        await writeLine(isEn ? 'LANCEMENT MODULE COURSE...' : 'LANCEMENT MODULE COURSE...', 350);
        setTimeout(() => {
          closeMinitel();
          if (window.startF1) window.startF1();
        }, 700);
      } else if (cmd === 'VITALITY' || cmd === '2') {
        await writeLine(isEn ? 'LANCEMENT AIM LAB...' : 'LANCEMENT MODULE AIM LAB...', 350);
        setTimeout(() => {
          closeMinitel();
          if (window.startVitality) window.startVitality();
        }, 700);
      } else if (cmd === 'EXIT' || cmd === 'QUITTER' || cmd === 'QUIT' || cmd === '3') {
        await writeLine(isEn ? 'DECONNEXION DU SERVEUR...' : 'DECONNEXION DU SERVEUR...', 200);
        setTimeout(closeMinitel, 400);
      } else if (cmd === 'HELP' || cmd === 'AIDE' || cmd === '?') {
        await writeLine(isEn ? 'AVAILABLE COMMANDS :' : 'COMMANDES DISPONIBLES :', 150);
        await writeLine('  1 / F1        : GRAND PRIX RACING', 80);
        await writeLine('  2 / VITALITY  : AIM & REFLEX LAB', 80);
        await writeLine('  3 / QUITTER   : RETOUR AU SITE', 80);
        createInput();
      } else if (cmd !== '') {
        await writeLine(isEn ? 'COMMANDE INCONNUE. TAPEZ 1, 2, 3 OU HELP.' : 'COMMANDE INCONNUE. TAPEZ 1, 2, 3 OU AIDE.', 200);
        createInput();
      } else {
        createInput();
      }
    }

    async function startBootSequence() {
      content.innerHTML = '';
      const isEn = document.documentElement.lang === 'en';
      await writeLine('3615 MINITEL // SERVEUR EN LIGNE', 350);
      await writeLine('CLUB INFORMATIQUE & RESEAU — MINES CHARPAK', 350);
      await writeLine('=========================================', 120);
      await writeLine(isEn ? 'CHOISISSEZ UNE APPLICATION :' : 'CHOISISSEZ UNE APPLICATION :', 180);
      await writeLine('  [1] F1        — GRAND PRIX RACING', 80);
      await writeLine('  [2] VITALITY  — AIM & REFLEX LAB', 80);
      await writeLine('  [3] QUITTER   — RETOUR AU SITE', 80);
      await writeLine('=========================================', 120);
      createInput();
    }

    function openMinitel() {
      if (modal) {
        modal.style.display = 'flex';
        // force reflow
        void container.offsetWidth;
        container.classList.add('open');
        startBootSequence();
      }
    }

    function closeMinitel() {
      if (modal) {
        container.classList.remove('open');
        setTimeout(() => {
          modal.style.display = 'none';
        }, 500); // match transition
      }
    }

    window.startMinitel = openMinitel;

    backdrop?.addEventListener('click', closeMinitel);
    
    // Easter egg triggers via keyboard
    let keyBuffer = '';
    window.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') return;
      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        keyBuffer += e.key.toLowerCase();
        if (keyBuffer.length > 20) keyBuffer = keyBuffer.slice(-20);
        if (keyBuffer.endsWith('minitel') || keyBuffer.endsWith('3615')) {
          openMinitel();
          keyBuffer = '';
        }
      }
    });

  })();
</script>
