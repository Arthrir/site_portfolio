            <path d="M814.256 618.263L815.561 618.416C821.597 623.672 894.343 819.132 908.167 846.28C917.555 851.914 933.521 859.315 943.649 864.377L1005.02 895.017C1016.73 900.863 1030.23 907.245 1041.49 913.539L1050.58 936.521C1032.1 928.716 1003.78 913.466 985.049 904.025C956.579 889.67 924.016 874.536 896.301 859.447C892.913 852.977 887.933 839.451 885.087 832.306L865.087 782.212C846.122 734.817 825.22 684.995 807.31 637.432C797.116 641.978 784.832 648.536 774.703 653.6L713.812 684.063C691.988 694.946 666.597 706.941 645.369 718.44C640.764 727.775 634.178 745.953 629.941 756.56L601.556 827.611C596.418 840.47 590.917 855.317 585.264 867.685C574.644 873.729 560.088 880.801 548.914 886.009C511.565 903.416 474.311 925.239 436.77 941.773C439.344 934.819 442.47 927.418 445.239 920.493C452.195 916.561 459.837 913.224 466.949 909.519C502.016 891.239 538.758 874.786 573.518 856.08C593.635 809.441 612.911 756.985 632.275 709.489C648.002 700.552 672.636 689.177 689.326 680.834L814.256 618.263Z"/>
