---
// src/components/F1GameModal.astro
// Racing Game
---

<div id="f1Modal" class="f1-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Racing Game">
  <div class="f1-backdrop" id="f1Backdrop"></div>

  <div class="f1-content">
    <button class="f1-close-btn" id="f1CloseBtn" aria-label="Fermer" title="Fermer (Échap)">✕</button>

    <div class="f1-header">
      <h2 class="f1-title">Grand Prix Racing</h2>
      <p class="f1-subtitle">Flèches directionnelles ou ZQSD pour piloter.</p>
    </div>

    <div class="f1-game-container">
      <canvas id="racingCanvas" width="800" height="450"></canvas>
      <div id="f1LapOverlay">Temps au tour: <span id="f1TimerDisplay">0.00</span>s</div>
      <div id="f1BestLapOverlay">Meilleur tour: <span id="f1BestTimerDisplay">--</span>s</div>
    </div>
  </div>
</div>

<style>
  .f1-modal {
    position: fixed; inset: 0; z-index: 10000;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .f1-backdrop {
    position: absolute; inset: 0;
    background: rgba(12, 13, 16, 0.9);
    backdrop-filter: blur(8px);
  }
  .f1-content {
    position: relative; z-index: 2;
    background: #14161B;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    width: 100%; max-width: 860px;
    padding: 30px;
    color: #F1F1EC;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    text-align: center;
  }
  .f1-close-btn {
    position: absolute; top: 14px; right: 16px;
    background: transparent; border: 1px solid rgba(255, 255, 255, 0.18);
    color: #8F9198; width: 32px; height: 32px; border-radius: 6px;
    font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.15s ease;
    z-index: 10;
  }
  .f1-close-btn:hover { color: #fff; border-color: #fff; background: rgba(255, 255, 255, 0.08); }

  .f1-title {
    font-family: var(--font-serif, serif); font-size: 1.85rem; font-weight: 600;
    margin-bottom: 8px; color: #FFFFFF;
  }
  .f1-subtitle {
    font-size: 0.88rem; color: #8F9198; margin-bottom: 20px;
  }

  .f1-game-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #2b7a2b; /* grass color */
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid #333;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  #f1LapOverlay, #f1BestLapOverlay {
    position: absolute;
    top: 15px;
    background: rgba(0,0,0,0.6);
    padding: 8px 12px;
    border-radius: 6px;
    font-family: monospace;
    font-size: 1.1rem;
    color: #fff;
    pointer-events: none;
  }
  #f1LapOverlay {
    left: 15px;
  }
  #f1BestLapOverlay {
    right: 15px;
    color: #ffde00;
  }
</style>

<script is:inline>
  (function initRacingGame() {
    const modal = document.getElementById('f1Modal');
    const closeBtn = document.getElementById('f1CloseBtn');
    const backdrop = document.getElementById('f1Backdrop');
    const canvas = document.getElementById('racingCanvas');
    const ctx = canvas.getContext('2d');
    const timerDisplay = document.getElementById('f1TimerDisplay');
    const bestTimerDisplay = document.getElementById('f1BestTimerDisplay');

    let isGameRunning = false;
    let animFrameId = null;

    const keys = {
      ArrowUp: false, ArrowDown: false, ArrowLeft: false, ArrowRight: false,
      w: false, s: false, a: false, d: false
    };

    // Track path (inner and outer boundaries)
    // Simple oval track
    const trackOuter = { x: 400, y: 225, rx: 350, ry: 180, width: 80 };

    class Car {
      constructor(x, y, color, isPlayer = false) {
        this.x = x;
        this.y = y;
        this.angle = 0;
        this.speed = 0;
        this.maxSpeed = isPlayer ? 6 : 4;
        this.friction = 0.95;
        this.acceleration = 0.2;
        this.turnSpeed = 0.05;
        this.color = color;
        this.isPlayer = isPlayer;
        
        // Sprite placeholder dimensions (will be replaced by Unity sprites later)
        this.width = 24;
        this.height = 12;

        this.lapStartTime = null;
        this.bestLapTime = null;
        this.crossedStartLine = false;
      }

      update() {
        if (this.isPlayer) {
          if (keys.ArrowUp || keys.w) this.speed += this.acceleration;
          if (keys.ArrowDown || keys.s) this.speed -= this.acceleration;

          if (this.speed != 0) {
            const flip = this.speed > 0 ? 1 : -1;
            if (keys.ArrowLeft || keys.a) this.angle -= this.turnSpeed * flip;
            if (keys.ArrowRight || keys.d) this.angle += this.turnSpeed * flip;
          }
        } else {
          // simple AI: follow track ellipse
          const angleToCenter = Math.atan2(this.y - trackOuter.y, this.x - trackOuter.x);
          let targetAngle = angleToCenter + Math.PI / 2; // tangent
          
          // steering towards tangent
          let diff = targetAngle - this.angle;
          while (diff < -Math.PI) diff += Math.PI * 2;
          while (diff > Math.PI) diff -= Math.PI * 2;

          this.angle += Math.sign(diff) * Math.min(Math.abs(diff), this.turnSpeed * 0.8);
          this.speed += this.acceleration * 0.8;
        }

        // Apply friction and speed limits
        this.speed *= this.friction;
        if (this.speed > this.maxSpeed) this.speed = this.maxSpeed;
        if (this.speed < -this.maxSpeed/2) this.speed = -this.maxSpeed/2;

        const prevX = this.x;
        const prevY = this.y;

        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed;

        // Collision with grass (slow down)
        const dx = this.x - trackOuter.x;
        const dy = this.y - trackOuter.y;
        // distance from center normalized to ellipse
        const distSq = (dx*dx)/(trackOuter.rx*trackOuter.rx) + (dy*dy)/(trackOuter.ry*trackOuter.ry);
        const innerRadiusSq = Math.pow((trackOuter.rx - trackOuter.width)/trackOuter.rx, 2);

        if (distSq > 1 || distSq < innerRadiusSq) {
           this.speed *= 0.85; // grass friction
        }

        if (this.isPlayer) {
          // check start line (x = 400, y < 225)
          if (prevX <= trackOuter.x && this.x > trackOuter.x && this.y < trackOuter.y) {
            // crossed start line to the right
            if (this.crossedStartLine) {
               const now = performance.now();
               if (this.lapStartTime) {
                 const lapTime = (now - this.lapStartTime) / 1000;
                 if (lapTime > 2) { // prevent double triggers
                   if (!this.bestLapTime || lapTime < this.bestLapTime) {
                     this.bestLapTime = lapTime;
                     bestTimerDisplay.textContent = this.bestLapTime.toFixed(2);
                   }
                   this.lapStartTime = now;
                 }
               } else {
                 this.lapStartTime = now;
               }
            } else {
              this.crossedStartLine = true;
              this.lapStartTime = performance.now();
            }
          }
        }
      }

      draw(ctx) {
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.rotate(this.angle);

        // Placeholder car drawing
        ctx.fillStyle = this.color;
        ctx.fillRect(-this.width/2, -this.height/2, this.width, this.height);
        
        // Window/cockpit
        ctx.fillStyle = '#000';
        ctx.fillRect(-this.width/4, -this.height/3, this.width/2, this.height/1.5);
        
        // Front direction indicator
        ctx.fillStyle = '#fff';
        ctx.fillRect(this.width/2 - 4, -this.height/2, 2, this.height);

        ctx.restore();
      }
    }

    let cars = [];

    function initGame() {
      cars = [
        new Car(400, trackOuter.y - trackOuter.ry + trackOuter.width/2, '#FF1801', true), // Player
        new Car(400 - 60, trackOuter.y - trackOuter.ry + trackOuter.width/2 + 10, '#00D2BE', false), // AI 1
        new Car(400 - 120, trackOuter.y - trackOuter.ry + trackOuter.width/2 - 10, '#1E41FF', false) // AI 2
      ];
      bestTimerDisplay.textContent = '--';
    }

    function drawTrack() {
      // Background grass
      ctx.fillStyle = '#2b7a2b';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Track Asphalt
      ctx.beginPath();
      ctx.ellipse(trackOuter.x, trackOuter.y, trackOuter.rx, trackOuter.ry, 0, 0, Math.PI*2);
      ctx.fillStyle = '#444';
      ctx.fill();

      // Track Inner Grass
      ctx.beginPath();
      ctx.ellipse(trackOuter.x, trackOuter.y, trackOuter.rx - trackOuter.width, trackOuter.ry - trackOuter.width, 0, 0, Math.PI*2);
      ctx.fillStyle = '#2b7a2b';
      ctx.fill();

      // Start/Finish Line
      ctx.fillStyle = '#fff';
      ctx.fillRect(trackOuter.x, trackOuter.y - trackOuter.ry, 6, trackOuter.width);
      // checkered pattern
      ctx.fillStyle = '#000';
      for (let i=0; i<trackOuter.width; i+=10) {
        ctx.fillRect(trackOuter.x, trackOuter.y - trackOuter.ry + i + (Math.floor(i/10)%2===0?0:5), 3, 5);
        ctx.fillRect(trackOuter.x+3, trackOuter.y - trackOuter.ry + i + (Math.floor(i/10)%2===0?5:0), 3, 5);
      }
    }

    function gameLoop() {
      if (!isGameRunning) return;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawTrack();

      cars.forEach(car => {
        car.update();
        car.draw(ctx);
      });

      // Update player timer
      if (cars[0].lapStartTime) {
         const currentLap = (performance.now() - cars[0].lapStartTime) / 1000;
         timerDisplay.textContent = currentLap.toFixed(2);
      } else {
         timerDisplay.textContent = "0.00";
      }

      animFrameId = requestAnimationFrame(gameLoop);
    }

    function openModal() {
      if (modal) {
        modal.style.display = 'flex';
        isGameRunning = true;
        initGame();
        gameLoop();
      }
    }

    function closeModal() {
      if (modal) {
        modal.style.display = 'none';
        isGameRunning = false;
        if (animFrameId) cancelAnimationFrame(animFrameId);
      }
    }

    window.addEventListener('keydown', (e) => {
      if (keys.hasOwnProperty(e.key)) keys[e.key] = true;
      if (modal && modal.style.display === 'flex' && e.key === 'Escape') closeModal();
    });
    window.addEventListener('keyup', (e) => {
      if (keys.hasOwnProperty(e.key)) keys[e.key] = false;
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.startF1 = openModal;
  })();
</script>
