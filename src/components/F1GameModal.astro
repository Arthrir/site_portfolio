---
// src/components/F1GameModal.astro
// Easter Egg F1 : Déclenché en tapant "formula1", "formule1" ou "f1" au clavier
---

<div id="f1Modal" class="f1-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="F1 Reaction Test">
  <div class="f1-backdrop" id="f1Backdrop"></div>
  
  <div class="f1-content">
    <button class="f1-close-btn" id="f1CloseBtn" aria-label="Fermer" title="Fermer (Échap)">✕</button>
    
    <!-- Top Telemetry Bar (Design Industriel / F1 Precision) -->
    <div class="f1-telemetry-bar">
      <div class="f1-team-stripes">
        <span class="stripe stripe-ferrari" title="Scuderia Ferrari"></span>
        <span class="stripe stripe-mclaren" title="McLaren F1"></span>
        <span class="stripe stripe-mercedes" title="Mercedes-AMG"></span>
        <span class="stripe stripe-redbull" title="Red Bull Racing"></span>
        <span class="stripe stripe-alpine" title="Alpine F1"></span>
        <span class="stripe stripe-aston" title="Aston Martin"></span>
      </div>
      <span class="f1-telemetry-tag">FIA STARTING PROTOCOL // SECTOR 1</span>
    </div>

    <div class="f1-header">
      <h2 class="f1-title">F1 Reaction Time Test</h2>
      <p class="f1-subtitle">Les 5 feux s'allument à intervalle d'1 seconde. Dès l'extinction complète des feux, cliquez ou appuyez sur <strong>Espace</strong> !</p>
    </div>

    <!-- Portique officiel FIA Start Gantry -->
    <div class="f1-gantry-frame">
      <div class="f1-gantry" id="f1Gantry">
        <div class="f1-light-pod">
          <div class="f1-light" id="f1L1"></div>
          <div class="f1-sub-light"></div>
        </div>
        <div class="f1-light-pod">
          <div class="f1-light" id="f1L2"></div>
          <div class="f1-sub-light"></div>
        </div>
        <div class="f1-light-pod">
          <div class="f1-light" id="f1L3"></div>
          <div class="f1-sub-light"></div>
        </div>
        <div class="f1-light-pod">
          <div class="f1-light" id="f1L4"></div>
          <div class="f1-sub-light"></div>
        </div>
        <div class="f1-light-pod">
          <div class="f1-light" id="f1L5"></div>
          <div class="f1-sub-light"></div>
        </div>
      </div>
    </div>

    <!-- Dashboard & Zone de réaction -->
    <div class="f1-action-area" id="f1ActionArea">
      <div class="f1-timer-wrap">
        <span class="f1-timer-label">DELTA REACTION</span>
        <div class="f1-timer-display" id="f1TimerDisplay">--- ms</div>
      </div>

      <div class="f1-status-pill" id="f1StatusMsg">Prêt sur la grille de départ</div>
      
      <div class="f1-controls">
        <button class="f1-btn f1-btn-start" id="f1StartBtn">
          DÉMARRER LA PROCÉDURE 🚦
        </button>
      </div>

      <div class="f1-hint">Astuce : barre <strong>Espace</strong> pour démarrer et réagir au feu vert</div>
    </div>

    <div class="f1-footer-bar">
      <span class="f1-score-tag" id="f1BestScore">Meilleur réflexe : -- ms</span>
      <span class="f1-esc-hint">Touche <strong>Échap</strong> pour fermer</span>
    </div>
  </div>
</div>

<style>
  .f1-modal {
    position: fixed; inset: 0; z-index: 10000;
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .f1-backdrop {
    position: absolute; inset: 0;
    background: rgba(12, 13, 16, 0.85);
    backdrop-filter: blur(12px);
  }
  .f1-content {
    position: relative; z-index: 2;
    background: #14161B;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    width: 100%; max-width: 650px;
    padding: 30px 32px 26px;
    color: #F1F1EC;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 1px 0 rgba(255, 255, 255, 0.1) inset;
    text-align: center;
    font-family: var(--font-sans, system-ui, sans-serif);
  }
  .f1-close-btn {
    position: absolute; top: 16px; right: 16px;
    background: transparent; border: 1px solid rgba(255, 255, 255, 0.15);
    color: #8F9198; width: 30px; height: 30px; border-radius: 6px;
    font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.15s ease;
  }
  .f1-close-btn:hover { color: #fff; border-color: #fff; background: rgba(255, 255, 255, 0.08); }

  /* Telemetry Bar */
  .f1-telemetry-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 16px; margin-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .f1-team-stripes {
    display: flex; gap: 4px; align-items: center;
  }
  .stripe { width: 14px; height: 4px; border-radius: 2px; }
  .stripe-ferrari { background: #E8002D; }
  .stripe-mclaren { background: #FF8000; }
  .stripe-mercedes { background: #00D2BE; }
  .stripe-redbull { background: #1E41FF; }
  .stripe-alpine { background: #0093CC; }
  .stripe-aston { background: #00594F; }

  .f1-telemetry-tag {
    font-family: monospace; font-size: 0.75rem; font-weight: 700;
    color: #8F9198; letter-spacing: 0.08em;
  }

  .f1-title {
    font-family: var(--font-serif, serif); font-size: 1.85rem; font-weight: 600;
    margin-bottom: 8px; color: #FFFFFF; letter-spacing: -0.01em;
  }
  .f1-subtitle {
    font-size: 0.88rem; color: #8F9198; max-width: 500px; margin: 0 auto 24px; line-height: 1.5;
  }
  .f1-subtitle strong { color: #fff; }

  /* Portique F1 Usiné */
  .f1-gantry-frame {
    background: #0B0C0E;
    border: 1px solid #23262D;
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 20px;
  }
  .f1-gantry {
    display: flex; justify-content: center; gap: 12px;
  }
  .f1-light-pod {
    width: 62px; height: 95px;
    background: #181A20;
    border: 1px solid #2A2E38;
    border-radius: 6px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
  }
  .f1-light {
    width: 38px; height: 38px; border-radius: 50%;
    background: #242730;
    border: 2px solid #17181C;
    transition: background-color 0.05s ease, box-shadow 0.05s ease;
  }
  .f1-light.on {
    background: #FF1801;
    box-shadow: 0 0 16px #FF1801, 0 0 30px rgba(255, 24, 1, 0.7);
  }
  .f1-sub-light {
    width: 14px; height: 14px; border-radius: 50%;
    background: #1E2026; border: 1px solid #141518;
  }

  /* Zone d'action */
  .f1-action-area {
    background: #181A21;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px; padding: 20px 24px;
    cursor: pointer; user-select: none;
    transition: border-color 0.2s;
  }
  .f1-action-area:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }
  .f1-timer-wrap { margin-bottom: 12px; }
  .f1-timer-label {
    font-family: monospace; font-size: 0.72rem; color: #8F9198; letter-spacing: 0.1em;
  }
  .f1-timer-display {
    font-family: monospace; font-size: 2.8rem; font-weight: 700;
    color: #69FF0A; font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
    line-height: 1.1; margin-top: 4px;
  }
  .f1-status-pill {
    display: inline-block; font-size: 0.95rem; font-weight: 600;
    color: #fff; padding: 6px 14px; border-radius: 6px;
    background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 16px;
  }
  .f1-btn {
    padding: 11px 26px; border-radius: 6px; font-weight: 700; font-size: 0.9rem;
    border: none; cursor: pointer; transition: all 0.15s ease;
    font-family: inherit; letter-spacing: 0.02em;
  }
  .f1-btn-start {
    background: #FF5500; color: #fff;
    box-shadow: 0 2px 8px rgba(255, 85, 0, 0.3);
  }
  .f1-btn-start:hover {
    background: #FF6A1A; transform: translateY(-1px);
  }
  .f1-hint {
    margin-top: 14px; font-size: 0.78rem; color: #6B6D76;
  }

  .f1-footer-bar {
    margin-top: 20px; display: flex; justify-content: space-between; align-items: center;
    font-size: 0.8rem; color: #8F9198; border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 14px;
  }
  .f1-score-tag { font-family: monospace; font-weight: 600; color: #5B9DFF; }
  .f1-esc-hint strong { color: #fff; }
</style>

<script is:inline>
  (function initF1Game() {
    let keyBuffer = '';
    const modal = document.getElementById('f1Modal');
    const closeBtn = document.getElementById('f1CloseBtn');
    const backdrop = document.getElementById('f1Backdrop');
    const startBtn = document.getElementById('f1StartBtn');
    const actionArea = document.getElementById('f1ActionArea');
    const timerDisplay = document.getElementById('f1TimerDisplay');
    const statusMsg = document.getElementById('f1StatusMsg');
    const bestScoreDisplay = document.getElementById('f1BestScore');
    
    const lights = [
      document.getElementById('f1L1'),
      document.getElementById('f1L2'),
      document.getElementById('f1L3'),
      document.getElementById('f1L4'),
      document.getElementById('f1L5')
    ];

    let gameState = 'IDLE'; // IDLE | SEQUENCE | WAITING | FINISHED
    let sequenceTimeouts = [];
    let lightOutTimestamp = 0;
    let bestScore = localStorage.getItem('f1_best_reaction') ? parseInt(localStorage.getItem('f1_best_reaction')) : null;
    if (bestScore && bestScoreDisplay) {
      bestScoreDisplay.textContent = `Meilleur réflexe : ${bestScore} ms`;
    }

    function playBeep(freq = 440, duration = 0.08) {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }

    function openF1Modal() {
      if (modal) {
        modal.style.display = 'flex';
        resetGame();
      }
    }

    function closeF1Modal() {
      if (modal) {
        modal.style.display = 'none';
        resetGame();
      }
    }

    function resetGame() {
      gameState = 'IDLE';
      sequenceTimeouts.forEach(clearTimeout);
      sequenceTimeouts = [];
      lights.forEach(l => l?.classList.remove('on'));
      if (timerDisplay) timerDisplay.textContent = '--- ms';
      if (statusMsg) {
        statusMsg.textContent = 'Prêt sur la grille de départ';
        statusMsg.style.color = '#fff';
      }
      if (startBtn) {
        startBtn.style.display = 'inline-block';
        startBtn.textContent = 'DÉMARRER LA PROCÉDURE 🚦';
      }
    }

    function startSequence() {
      if (gameState === 'SEQUENCE' || gameState === 'WAITING') return;
      resetGame();
      gameState = 'SEQUENCE';
      if (startBtn) startBtn.style.display = 'none';
      if (statusMsg) statusMsg.textContent = 'Feux en cours d\'allumage... Restez concentré !';

      lights.forEach((light, index) => {
        const t = setTimeout(() => {
          light.classList.add('on');
          playBeep(440, 0.08);
        }, (index + 1) * 900);
        sequenceTimeouts.push(t);
      });

      const randomHold = 800 + Math.random() * 2400;
      const totalDelay = (5 * 900) + randomHold;

      const finishTimeout = setTimeout(() => {
        lights.forEach(l => l.classList.remove('on'));
        playBeep(880, 0.12);
        lightOutTimestamp = performance.now();
        gameState = 'WAITING';
        if (statusMsg) {
          statusMsg.textContent = 'PARTEZ ! 🏎️';
          statusMsg.style.color = '#69FF0A';
        }
      }, totalDelay);
      sequenceTimeouts.push(finishTimeout);
    }

    function triggerReaction() {
      if (gameState === 'SEQUENCE') {
        sequenceTimeouts.forEach(clearTimeout);
        sequenceTimeouts = [];
        gameState = 'FINISHED';
        lights.forEach(l => l.classList.add('on'));
        playBeep(220, 0.25);
        if (timerDisplay) timerDisplay.textContent = 'JUMP START';
        if (statusMsg) {
          statusMsg.textContent = '🚨 FAUX DÉPART ! +5s de pénalité.';
          statusMsg.style.color = '#FF1801';
        }
        if (startBtn) {
          startBtn.style.display = 'inline-block';
          startBtn.textContent = 'Réessayer';
        }
      } else if (gameState === 'WAITING') {
        const reactionTime = Math.round(performance.now() - lightOutTimestamp);
        gameState = 'FINISHED';
        if (timerDisplay) timerDisplay.textContent = `${reactionTime} ms`;

        let feedback = '';
        if (reactionTime < 200) {
          feedback = '🏆 INCROYABLE ! Réflexes niveau Max Verstappen / Fernando Alonso !';
        } else if (reactionTime < 260) {
          feedback = '⚡ EXCELLENT DÉPART ! Niveau pilote F1 / F2.';
        } else if (reactionTime < 320) {
          feedback = '🏎️ BON DÉPART ! En plein dans le peloton.';
        } else {
          feedback = '🐢 DÉPART ENDORMI ! Le peloton est déjà au premier virage.';
        }

        if (statusMsg) {
          statusMsg.textContent = feedback;
          statusMsg.style.color = reactionTime < 260 ? '#69FF0A' : '#5B9DFF';
        }

        if (!bestScore || reactionTime < bestScore) {
          bestScore = reactionTime;
          localStorage.setItem('f1_best_reaction', bestScore);
          if (bestScoreDisplay) bestScoreDisplay.textContent = `Nouveau record personnel : ${bestScore} ms ! ⭐`;
        }

        if (startBtn) {
          startBtn.style.display = 'inline-block';
          startBtn.textContent = 'Rejouer';
        }
      }
    }

    window.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') {
        if (e.key === 'Escape') {
          closeF1Modal();
        } else if (e.code === 'Space') {
          e.preventDefault();
          if (gameState === 'IDLE' || gameState === 'FINISHED') {
            startSequence();
          } else {
            triggerReaction();
          }
        }
        return;
      }

      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        keyBuffer += e.key.toLowerCase();
        if (keyBuffer.length > 20) keyBuffer = keyBuffer.slice(-20);

        if (keyBuffer.endsWith('formula1') || keyBuffer.endsWith('formule1') || keyBuffer.endsWith('f1game')) {
          openF1Modal();
          keyBuffer = '';
        }
      }
    });

    closeBtn?.addEventListener('click', closeF1Modal);
    backdrop?.addEventListener('click', closeF1Modal);
    startBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      startSequence();
    });
    actionArea?.addEventListener('click', () => {
      if (gameState === 'IDLE' || gameState === 'FINISHED') {
        startSequence();
      } else {
        triggerReaction();
      }
    });

    window.startF1 = openF1Modal;
  })();
</script>
