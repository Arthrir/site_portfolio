---
// src/components/BlackjackModal.astro
// TIPE Blackjack 21 — Stratégie de Base Mathématique & Probabilités
// Déclenché via le Minitel (touche 3 ou "blackjack"), la palette de commandes, ou secret mobile
---

<div id="blackjackModal" class="bj-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Blackjack 21 TIPE Edition">
  <div class="bj-backdrop" id="bjBackdrop"></div>

  <div class="bj-container">
    <!-- Bouton fermeture discret -->
    <button class="bj-close-btn" id="bjCloseBtn" aria-label="Fermer le jeu" title="Fermer (Échap)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- Header Monte Carlo / TIPE -->
    <div class="bj-header">
      <div class="bj-badge-row">
        <span class="bj-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#D4AF37"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          TIPE MATHS // PROBABILITÉS & THÉORIE DES JEUX
        </span>
        <button type="button" class="bj-assistant-toggle active" id="bjAssistantToggle" title="Activer/désactiver l'analyse mathématique">
          <span class="toggle-dot"></span>
          <span class="toggle-text">Assistant TIPE : <strong>ACTIF</strong></span>
        </button>
      </div>
      <h2 class="bj-title">Blackjack 21 — Math Engine</h2>
      <p class="bj-sub">Simulation fidèle d'un sabot de casino avec calcul en temps réel de la Stratégie de Base et du comptage Hi-Lo.</p>
    </div>

    <!-- Tapis de jeu feutrine verte avec bordure dorée -->
    <div class="bj-table">
      <!-- Croupier Zone -->
      <div class="dealer-zone">
        <div class="zone-header">
          <span class="zone-label">CROUPIER</span>
          <span class="hand-score" id="dealerScore">0</span>
          <span class="dealer-rule-badge">Reste à 17</span>
        </div>
        <div class="cards-wrapper" id="dealerCards">
          <!-- Cartes injectées en JS -->
        </div>
      </div>

      <!-- Message central de statut / Résultat -->
      <div class="bj-status-banner" id="bjStatusBanner">
        Placez votre mise et cliquez sur DISTRIBUER
      </div>

      <!-- Joueur Zone -->
      <div class="player-zone">
        <div class="zone-header">
          <div class="player-info-left">
            <span class="zone-label">JOUEUR</span>
            <span class="hand-score" id="playerScore">0</span>
          </div>
          <div class="player-info-right">
            <span class="bankroll-label">BANKROLL : <strong id="playerBankroll">1 000</strong> $</span>
            <span class="bet-label">MISE : <strong id="currentBetDisplay">50</strong> $</span>
          </div>
        </div>
        <div class="cards-wrapper" id="playerCards">
          <!-- Cartes injectées en JS -->
        </div>
      </div>

      <!-- Panneau Assistant Mathématique TIPE (Affichage probas & reco) -->
      <div class="bj-tipe-panel" id="bjTipePanel">
        <div class="tipe-panel-header">
          <span class="tipe-title">📊 ANALYSE PROBABILISTE DU TIPE</span>
          <span class="tipe-edge" id="tipeEdge">Avantage : <strong class="edge-val">-0.5% (Maison)</strong></span>
        </div>
        <div class="tipe-body">
          <div class="tipe-advice-box">
            <span class="tipe-advice-tag" id="tipeAdviceTag">DÉCISION OPTIMALE</span>
            <span class="tipe-advice-move" id="tipeAdviceMove">DISTRIBUER</span>
            <span class="tipe-advice-why" id="tipeAdviceWhy">En attente de la distribution des cartes.</span>
          </div>
          <div class="tipe-metrics-grid">
            <div class="tipe-metric">
              <span class="m-lbl">Comptage Hi-Lo</span>
              <span class="m-val" id="mHiLo">0</span>
            </div>
            <div class="tipe-metric">
              <span class="m-lbl">Vrai Compte</span>
              <span class="m-val" id="mTrueCount">0.0</span>
            </div>
            <div class="tipe-metric">
              <span class="m-lbl">Bust Croupier</span>
              <span class="m-val" id="mDealerBust">--%</span>
            </div>
            <div class="tipe-metric">
              <span class="m-lbl">Cartes restantes</span>
              <span class="m-val" id="mCardsLeft">312</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Barre de Contrôles & Mises -->
    <div class="bj-controls">
      <!-- Sélecteur de Jetons -->
      <div class="bj-chips-bar" id="bjChipsBar">
        <span class="chips-title">JETONS :</span>
        <button type="button" class="bj-chip chip-10" data-chip="10">10</button>
        <button type="button" class="bj-chip chip-25" data-chip="25">25</button>
        <button type="button" class="bj-chip chip-50 active" data-chip="50">50</button>
        <button type="button" class="bj-chip chip-100" data-chip="100">100</button>
        <button type="button" class="bj-chip chip-250" data-chip="250">250</button>
        <button type="button" class="bj-chip-reset" id="bjResetBetBtn" title="Réinitialiser la mise">✕</button>
      </div>

      <!-- Boutons d'Action de Jeu -->
      <div class="bj-actions-bar">
        <button type="button" class="bj-btn btn-deal" id="bjDealBtn">
          <span>DISTRIBUER</span>
        </button>
        <button type="button" class="bj-btn btn-hit" id="bjHitBtn" disabled>
          <span>TIRER (CARTE)</span>
        </button>
        <button type="button" class="bj-btn btn-stand" id="bjStandBtn" disabled>
          <span>RESTER</span>
        </button>
        <button type="button" class="bj-btn btn-double" id="bjDoubleBtn" disabled>
          <span>DOUBLER (x2)</span>
        </button>
      </div>
    </div>

    <!-- Pied de page -->
    <div class="bj-footer">
      <span class="bj-footer-hint"><kbd>Échap</kbd> fermer • Sabot de 6 jeux mélangés</span>
      <span class="bj-footer-credits">Développé d'après les recherches TIPE en prépa scientifique d'Arthur Doradoux</span>
    </div>
  </div>
</div>

<style>
  .bj-modal {
    position: fixed; inset: 0; z-index: 10002;
    display: flex; align-items: center; justify-content: center;
    padding: 16px; font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    color: #F3F4F6;
  }
  .bj-backdrop {
    position: absolute; inset: 0;
    background: rgba(4, 10, 8, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .bj-container {
    position: relative; z-index: 2;
    background: linear-gradient(160deg, #111e17 0%, #0a140f 100%);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 16px;
    width: 100%; max-width: 820px;
    max-height: 94vh;
