  }
  .tipe-advice-tag {
    font-size: 0.62rem; font-weight: 700; color: #9CA3AF; letter-spacing: 0.06em;
  }
  .tipe-advice-move {
    font-size: 1.05rem; font-weight: 800; color: #34D399; letter-spacing: 0.03em;
  }
  .tipe-advice-why {
    font-size: 0.72rem; color: #D1D5DB; line-height: 1.35;
  }

  .tipe-metrics-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }
  .tipe-metric {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px; padding: 6px 8px;
