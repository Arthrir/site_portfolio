---
// src/components/VitalityGameModal.astro
// Easter Egg Esport / Vitality : Déclenché par le Konami Code (↑ ↑ ↓ ↓ ← → ← → B A) ou en tapant "vitality"
---

<div id="vitalityModal" class="vit-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Vitality Aim Lab">
  <div class="vit-backdrop" id="vitBackdrop"></div>

  <div class="vit-container">
    <button class="vit-close-btn" id="vitCloseBtn" aria-label="Fermer" title="Fermer (Échap)">✕</button>

    <div class="vit-header">
      <div class="vit-logo-badge">TEAM VITALITY // AIM & REFLEX LAB</div>
      <h2 class="vit-title">V FOR VICTORY — AIM & REFLEX LAB</h2>
      <p class="vit-sub">Testez vos réflexes et votre précision en 15 secondes. Cliquez sur les cibles ZywOo-tier !</p>
    </div>

    <div class="vit-hud">
      <div class="hud-item">
        <span class="hud-label">TEMPS RESTANT</span>
        <span class="hud-val" id="vitTimer">15.0s</span>
      </div>
      <div class="hud-item">
        <span class="hud-label">SCORE</span>
        <span class="hud-val" id="vitScore">0</span>
      </div>
      <div class="hud-item">
        <span class="hud-label">PRÉCISION</span>
        <span class="hud-val" id="vitAccuracy">100%</span>
      </div>
    </div>

    <div class="vit-arena" id="vitArena">
      <div class="vit-start-overlay" id="vitStartOverlay">
        <button class="vit-btn-main" id="vitStartGameBtn">LANCER LA SESSION</button>
      </div>

      <div class="vit-end-overlay" id="vitEndOverlay" style="display: none;">
        <div class="vit-end-rank" id="vitEndRank">MAJOR CHAMPION</div>
        <div class="vit-end-stats" id="vitEndStats">Score : 0 • Cibles : 0</div>
        <button class="vit-btn-main" id="vitRestartBtn">REJOUER</button>
      </div>
    </div>

    <div class="vit-footer-info">
      <span>Record personnel : <strong id="vitBestScore">0</strong> pts</span>
      <span class="vit-exit-hint">Touche <strong>Échap</strong> pour quitter</span>
    </div>
  </div>
</div>

<style>
  .vit-modal {
    position: fixed; inset: 0; z-index: 10001;
    display: flex; align-items: center; justify-content: center;
    padding: 20px; font-family: monospace, sans-serif;
  }
  .vit-backdrop {
    position: absolute; inset: 0;
    background: rgba(10, 11, 14, 0.88);
    backdrop-filter: blur(12px);
  }
  .vit-container {
    position: relative; z-index: 2;
    background: #111215;
    border: 1px solid #F2E800;
    border-radius: 12px;
    width: 100%; max-width: 680px;
    padding: 28px;
    color: #F2E800;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6), 0 0 24px rgba(242, 232, 0, 0.15);
    text-align: center;
  }
  .vit-close-btn {
    position: absolute; top: 14px; right: 16px;
    background: transparent; border: 1px solid rgba(242, 232, 0, 0.3);
    color: #F2E800; width: 32px; height: 32px; border-radius: 6px;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.15s ease; font-size: 14px;
    z-index: 10;
  }
  .vit-close-btn:hover { background: #F2E800; color: #000; }

  .vit-header {
    padding-right: 36px; /* Évite la collision avec le bouton Fermer ✕ */
  }
  .vit-logo-badge {
    display: inline-block; font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; color: #000; background: #F2E800;
    padding: 4px 12px; border-radius: 4px; margin-bottom: 10px;
  }
  .vit-title {
    font-size: 1.45rem; font-weight: 800; color: #FFFFFF; margin-bottom: 6px; letter-spacing: 0.04em;
  }
  .vit-sub {
    font-size: 0.85rem; color: #8F9198; margin-bottom: 20px; font-family: var(--font-sans, system-ui, sans-serif);
  }

  /* HUD */
  .vit-hud {
    display: flex; justify-content: space-around;
    background: rgba(242, 232, 0, 0.05);
    border: 1px solid rgba(242, 232, 0, 0.2);
    border-radius: 8px; padding: 10px 16px; margin-bottom: 16px;
  }
  .hud-item { display: flex; flex-direction: column; gap: 2px; }
  .hud-label { font-size: 0.7rem; color: #8F9198; letter-spacing: 0.08em; }
  .hud-val { font-size: 1.35rem; font-weight: 800; color: #FFFFFF; font-variant-numeric: tabular-nums; }

  /* Arène de tir */
  .vit-arena {
    position: relative;
    width: 100%; height: 320px;
    background: #0A0B0E;
    border: 1px solid #23262D;
    border-radius: 8px;
    overflow: hidden;
    cursor: crosshair;
    user-select: none;
    background-image: radial-gradient(rgba(242, 232, 0, 0.12) 1px, transparent 1px);
    background-size: 20px 20px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Cibles abeilles ultra visibles */
  :global(.vit-target) {
    position: absolute;
    width: 54px; height: 54px;
    border-radius: 50%;
    background: radial-gradient(circle, #FFF438 25%, #F2E800 65%, #C2BA00 100%);
    border: 3px solid #FFFFFF;
    box-shadow: 0 0 14px rgba(242, 232, 0, 0.8), 0 0 24px rgba(242, 232, 0, 0.4);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transform: translate(-50%, -50%);
    z-index: 100 !important;
    pointer-events: auto !important;
    user-select: none;
    animation: pulseBee 0.8s ease-in-out infinite alternate;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  @keyframes pulseBee {
    0% { transform: translate(-50%, -50%) scale(0.95); }
    100% { transform: translate(-50%, -50%) scale(1.05); }
  }
  :global(.vit-target-inner) {
    font-size: 22px; line-height: 1; pointer-events: none;
  }

  .vit-start-overlay, .vit-end-overlay {
    position: absolute; inset: 0;
    background: rgba(10, 11, 14, 0.85);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 14px; z-index: 10;
  }
  .vit-btn-main {
    background: #F2E800; color: #000; border: none;
    padding: 13px 28px; border-radius: 6px; font-weight: 800; font-size: 0.95rem;
    cursor: pointer; transition: transform 0.15s, box-shadow 0.15s; font-family: monospace;
    letter-spacing: 0.04em;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .vit-btn-main:hover {
    transform: translateY(-1px); box-shadow: 0 0 20px rgba(242, 232, 0, 0.5);
  }

  .vit-end-rank { font-size: 1.3rem; font-weight: 800; color: #F2E800; }
  .vit-end-stats { font-size: 0.92rem; color: #FFFFFF; }

  .vit-footer-info {
    margin-top: 14px; display: flex; justify-content: space-between; align-items: center;
    font-size: 0.8rem; color: #8F9198;
  }
  .vit-footer-info strong { color: #F2E800; }
  .vit-exit-hint strong { color: #FFFFFF; }

  /* Optimisation Mobile */
  @media (max-width: 640px) {
    .vit-container {
      padding: 20px 14px 16px;
    }
    .vit-header {
      padding-right: 32px;
    }
    .vit-title {
      font-size: 1.15rem;
    }
    .vit-sub {
      font-size: 0.78rem;
      margin-bottom: 14px;
    }
    .vit-arena {
      height: 270px;
    }
    :global(.vit-target) {
      width: 48px;
      height: 48px;
    }
    .hud-val {
      font-size: 1.15rem;
    }
    .vit-footer-info {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>

<script is:inline>
  (function initVitalityGame() {
    let keySequence = [];
    let textBuffer = '';
    const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];

    const modal = document.getElementById('vitalityModal');
    const closeBtn = document.getElementById('vitCloseBtn');
    const backdrop = document.getElementById('vitBackdrop');
    const arena = document.getElementById('vitArena');
    const startOverlay = document.getElementById('vitStartOverlay');
    const endOverlay = document.getElementById('vitEndOverlay');
    const startBtn = document.getElementById('vitStartGameBtn');
    const restartBtn = document.getElementById('vitRestartBtn');
    const timerEl = document.getElementById('vitTimer');
    const scoreEl = document.getElementById('vitScore');
    const accEl = document.getElementById('vitAccuracy');
    const bestScoreEl = document.getElementById('vitBestScore');
    const endRankEl = document.getElementById('vitEndRank');
    const endStatsEl = document.getElementById('vitEndStats');

    let isPlaying = false;
    let score = 0;
    let totalClicks = 0;
    let hits = 0;
    let timeLeft = 15.0;
    let gameInterval = null;
    let activeTargets = [];
    let savedBest = localStorage.getItem('vit_best_score') ? parseInt(localStorage.getItem('vit_best_score')) : 0;
    if (bestScoreEl) bestScoreEl.textContent = savedBest;

    function playSound(freq = 600, duration = 0.06) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function openModal() {
      if (modal) {
        modal.style.display = 'flex';
        resetGameUI();
      }
    }

    function closeModal() {
      if (modal) {
        stopGame();
        modal.style.display = 'none';
      }
    }

    function resetGameUI() {
      stopGame();
      if (startOverlay) {
        startOverlay.style.display = 'flex';
        startOverlay.style.pointerEvents = 'auto';
      }
      if (endOverlay) endOverlay.style.display = 'none';
      if (timerEl) timerEl.textContent = '15.0s';
      if (scoreEl) scoreEl.textContent = '0';
      if (accEl) accEl.textContent = '100%';
    }

    function createTargetElement() {
      if (!arena) return null;
      const rect = arena.getBoundingClientRect();
      const arenaW = rect.width > 0 ? rect.width : 600;
      const arenaH = rect.height > 0 ? rect.height : 320;

      const padding = 45;
      const x = Math.round(padding + Math.random() * (arenaW - padding * 2));
      const y = Math.round(padding + Math.random() * (arenaH - padding * 2));

      const target = document.createElement('div');
      target.className = 'vit-target';
      target.style.left = `${x}px`;
      target.style.top = `${y}px`;

      const inner = document.createElement('span');
      inner.className = 'vit-target-inner';
      inner.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0B0C10" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="5" fill="#0B0C10"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>';
      target.appendChild(inner);

      function handleHit(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!isPlaying) return;

        hits++;
        totalClicks++;
        score += 100;
        playSound(880, 0.08);
        updateHUD();

        // Enlever la cible et en créer une nouvelle
        target.remove();
        activeTargets = activeTargets.filter(t => t !== target);
        spawnSingleTarget();
      }

      target.addEventListener('pointerdown', handleHit);

      return target;
    }

    function spawnSingleTarget() {
      if (!isPlaying || !arena) return;
      const target = createTargetElement();
      if (target) {
        arena.appendChild(target);
        activeTargets.push(target);
      }
    }

    function spawnInitialTargets() {
      clearAllTargets();
      // Toujours avoir 2 cibles simultanément pour du rythme
      spawnSingleTarget();
      spawnSingleTarget();
    }

    function clearAllTargets() {
      activeTargets.forEach(t => t.remove());
      activeTargets = [];
      const leftover = arena?.querySelectorAll('.vit-target');
      leftover?.forEach(t => t.remove());
    }

    function updateHUD() {
      if (scoreEl) scoreEl.textContent = score;
      if (timerEl) timerEl.textContent = `${Math.max(0, timeLeft).toFixed(1)}s`;
      const acc = totalClicks > 0 ? Math.round((hits / totalClicks) * 100) : 100;
      if (accEl) accEl.textContent = `${acc}%`;
    }

    function startGame() {
      score = 0;
      hits = 0;
      totalClicks = 0;
      timeLeft = 15.0;
      isPlaying = true;

      if (startOverlay) {
        startOverlay.style.display = 'none';
        startOverlay.style.pointerEvents = 'none';
      }
      if (endOverlay) endOverlay.style.display = 'none';
      updateHUD();
      spawnInitialTargets();

      const startTime = performance.now();
      const initialTime = timeLeft;

      gameInterval = setInterval(() => {
        const elapsed = (performance.now() - startTime) / 1000;
        timeLeft = initialTime - elapsed;
        if (timeLeft <= 0) {
          endGame();
        } else {
          updateHUD();
        }
      }, 50);
    }

    function stopGame() {
      isPlaying = false;
      if (gameInterval) clearInterval(gameInterval);
      clearAllTargets();
    }

    function endGame() {
      stopGame();
      playSound(320, 0.25);
      if (timerEl) timerEl.textContent = '0.0s';

      let rank = 'SILVER 1';
      if (hits >= 28) {
        rank = 'MAJOR CHAMPION // ZywOo Tier';
      } else if (hits >= 20) {
        rank = 'GLOBAL ELITE // Pro Tier';
      } else if (hits >= 12) {
        rank = 'MASTER GUARDIAN // Bon réflexe';
      } else {
        rank = 'SILVER 1 // Entraîne-toi encore';
      }

      if (score > savedBest) {
        savedBest = score;
        localStorage.setItem('vit_best_score', savedBest);
        if (bestScoreEl) bestScoreEl.textContent = savedBest;
      }

      if (endRankEl) endRankEl.textContent = rank;
      if (endStatsEl) endStatsEl.textContent = `Score : ${score} pts • Cibles touchées : ${hits}`;
      if (endOverlay) endOverlay.style.display = 'flex';
    }

    arena?.addEventListener('pointerdown', (e) => {
      // Si on clique dans l'arène mais pas sur une cible
      if (isPlaying && e.target === arena) {
        if (e.cancelable) e.preventDefault();
        totalClicks++;
        playSound(220, 0.05); // Bip raté
        updateHUD();
      }
    });

    startBtn?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      if (e.cancelable) e.preventDefault();
      startGame();
    });
    startBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    restartBtn?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      if (e.cancelable) e.preventDefault();
      startGame();
    });
    restartBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') {
        if (e.key === 'Escape') closeModal();
        return;
      }

      keySequence.push(e.key);
      if (keySequence.length > konami.length) keySequence.shift();
      if (keySequence.join(',') === konami.join(',')) {
        openModal();
        keySequence = [];
        return;
      }

      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        textBuffer += e.key.toLowerCase();
        if (textBuffer.length > 15) textBuffer = textBuffer.slice(-15);
        if (textBuffer.endsWith('vitality') || textBuffer.endsWith('esport')) {
          openModal();
          textBuffer = '';
        }
      }
    });

    window.startVitality = openModal;
  })();
</script>
