---
// src/components/VitalityGameModal.astro
// Esports Aim & Reflex Benchmark — Team Vitality Edition
// Déclenché par le Konami Code (↑ ↑ ↓ ↓ ← → ← → B A), en tapant "vitality" ou via le Minitel
---

<div id="vitalityModal" class="vit-modal" style="display: none;" role="dialog" aria-modal="true" aria-label="Vitality Aim Lab Benchmark">
  <div class="vit-backdrop" id="vitBackdrop"></div>

  <div class="vit-container">
    <!-- Bouton fermeture moderne -->
    <button class="vit-close-btn" id="vitCloseBtn" aria-label="Fermer la session" title="Fermer (Échap)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <!-- En-tête Esports Professionnel -->
    <div class="vit-header">
      <div class="vit-badge-row">
        <span class="vit-team-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#EAB308"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          TEAM VITALITY // ESPORTS AIM BENCHMARK
        </span>
        <span class="vit-version-tag">PRO DRILL V2</span>
      </div>
      <h2 class="vit-title">Precision & Reflex Lab</h2>
      <p class="vit-sub">Session d'entraînement 15 secondes — Mesurez votre réactivité, cadence (KPS) et précision de visée.</p>
    </div>

    <!-- HUD télémétrie façon Aim Lab / Valorant -->
    <div class="vit-hud">
      <div class="hud-box">
        <span class="hud-label">CHRONO</span>
        <span class="hud-value timer-val" id="vitTimer">15.0<small>s</small></span>
        <div class="hud-bar"><div class="hud-bar-fill" id="vitTimerBar" style="width: 100%;"></div></div>
      </div>
      <div class="hud-box">
        <span class="hud-label">SCORE</span>
        <span class="hud-value" id="vitScore">0</span>
        <span class="hud-sub" id="vitKps">0.0 KPS</span>
      </div>
      <div class="hud-box">
        <span class="hud-label">PRÉCISION</span>
        <span class="hud-value highlight-green" id="vitAccuracy">100%</span>
        <span class="hud-sub" id="vitHitsCounter">0 touchés</span>
      </div>
      <div class="hud-box best-box">
        <span class="hud-label">RECORD</span>
        <span class="hud-value highlight-gold" id="vitBestScore">0</span>
        <span class="hud-sub">SESSION BEST</span>
      </div>
    </div>

    <!-- Arène de tir haute précision -->
    <div class="vit-arena" id="vitArena" tabIndex="0">
      <!-- Réticule customisé fluide -->
      <div class="vit-crosshair" id="vitCrosshair"></div>

      <!-- Hitmarker flash dynamique -->
      <div class="vit-hitmarker" id="vitHitmarker"></div>

      <!-- Overlay de départ -->
      <div class="vit-overlay" id="vitStartOverlay">
        <div class="overlay-card">
          <div class="overlay-icon">🎯</div>
          <h3 class="overlay-title">STAND DE TIR PRÊT</h3>
          <p class="overlay-desc">Cliquez ou touchez les cibles le plus vite possible dès leur apparition. Évitez les tirs dans le vide pour préserver votre précision.</p>
          <button class="vit-btn-action" id="vitStartGameBtn">
            <span>DÉMARRER LA SESSION</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </button>
        </div>
      </div>

      <!-- Overlay de fin avec rapport de performance détaillé -->
      <div class="vit-overlay" id="vitEndOverlay" style="display: none;">
        <div class="overlay-card end-card">
          <div class="rank-badge" id="vitEndRankBadge">
            <span class="rank-icon" id="vitEndRankIcon">👑</span>
            <span class="rank-title" id="vitEndRank">MAJOR CHAMPION</span>
          </div>

          <div class="stats-grid">
            <div class="stat-col">
              <span class="stat-col-lbl">Score final</span>
              <span class="stat-col-val" id="endScoreVal">0</span>
            </div>
            <div class="stat-col">
              <span class="stat-col-lbl">Cibles éliminées</span>
              <span class="stat-col-val" id="endHitsVal">0</span>
            </div>
            <div class="stat-col">
              <span class="stat-col-lbl">Précision globale</span>
              <span class="stat-col-val" id="endAccVal">100%</span>
            </div>
            <div class="stat-col">
              <span class="stat-col-lbl">Cadence de tir</span>
              <span class="stat-col-val" id="endKpsVal">0.0 /s</span>
            </div>
          </div>

          <div class="new-record-alert" id="vitNewRecordAlert" style="display: none;">
            ✨ NOUVEAU RECORD PERSONNEL ÉTABLI !
          </div>

          <div class="end-actions">
            <button class="vit-btn-action" id="vitRestartBtn">
              <span>NOUVEAU DRILL (REJOUER)</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Barre inférieure discrète -->
    <div class="vit-footer">
      <span class="vit-tip"><kbd>Échap</kbd> quitter • <kbd>Espace</kbd> relancer</span>
      <span class="vit-credits">Design inspiré de l'entraînement CS2 / Aim Lab</span>
    </div>
  </div>
</div>

<style>
  .vit-modal {
    position: fixed; inset: 0; z-index: 10001;
    display: flex; align-items: center; justify-content: center;
    padding: 16px; font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    color: #F3F4F6;
  }
  .vit-backdrop {
    position: absolute; inset: 0;
    background: rgba(6, 8, 12, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .vit-container {
    position: relative; z-index: 2;
    background: linear-gradient(145deg, #101218 0%, #0B0D12 100%);
    border: 1px solid rgba(234, 179, 8, 0.28);
    border-radius: 16px;
    width: 100%; max-width: 720px;
    padding: 26px 28px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(234, 179, 8, 0.08);
  }

  .vit-close-btn {
    position: absolute; top: 18px; right: 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #9CA3AF; width: 34px; height: 34px; border-radius: 8px;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
  }
  .vit-close-btn:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #F87171;
    transform: scale(1.05);
  }

  /* Header */
  .vit-header {
    text-align: left;
    margin-bottom: 20px;
    padding-right: 48px;
  }
  .vit-badge-row {
    display: flex; align-items: center; gap: 8px; margin-bottom: 8px;
  }
  .vit-team-tag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em;
    color: #FACC15; background: rgba(234, 179, 8, 0.12);
    border: 1px solid rgba(234, 179, 8, 0.28);
    padding: 3px 10px; border-radius: 999px;
  }
  .vit-version-tag {
    font-size: 0.68rem; font-weight: 700; color: #6B7280;
    letter-spacing: 0.06em;
  }
  .vit-title {
    font-size: 1.55rem; font-weight: 800; color: #FFFFFF;
    margin: 0 0 4px; letter-spacing: -0.02em;
  }
  .vit-sub {
    font-size: 0.85rem; color: #9CA3AF; margin: 0; line-height: 1.4;
  }

  /* HUD */
  .vit-hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 16px;
  }
  .hud-box {
    background: rgba(18, 21, 28, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex; flex-direction: column;
    text-align: left; position: relative; overflow: hidden;
  }
  .hud-box.best-box {
    border-color: rgba(234, 179, 8, 0.2);
    background: rgba(234, 179, 8, 0.04);
  }
  .hud-label {
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em;
    color: #6B7280; text-transform: uppercase; margin-bottom: 2px;
  }
  .hud-value {
    font-size: 1.35rem; font-weight: 800; color: #FFFFFF;
    font-variant-numeric: tabular-nums; line-height: 1.1;
  }
  .timer-val small { font-size: 0.8rem; font-weight: 600; color: #9CA3AF; margin-left: 2px; }
  .hud-sub {
    font-size: 0.68rem; font-weight: 600; color: #9CA3AF; margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .highlight-green { color: #10B981; }
  .highlight-gold { color: #FACC15; }

  .hud-bar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
    background: rgba(255, 255, 255, 0.08);
  }
  .hud-bar-fill {
    height: 100%; background: #EAB308;
    transition: width 0.05s linear;
  }

  /* Arena */
  .vit-arena {
    position: relative;
    width: 100%; height: 340px;
    background: #08090C;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    cursor: crosshair;
    user-select: none;
    background-image: 
      radial-gradient(circle at center, rgba(234, 179, 8, 0.03) 0%, transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 32px 32px, 32px 32px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  /* Réticule dynamique */
  .vit-crosshair {
    position: absolute;
    width: 24px; height: 24px;
    pointer-events: none;
    transform: translate(-50%, -50%);
    display: none;
    z-index: 50;
  }
  .vit-crosshair::before {
    content: ''; position: absolute; inset: 10px;
    border-radius: 50%; background: #FACC15;
    box-shadow: 0 0 6px #FACC15;
  }
  .vit-crosshair::after {
    content: ''; position: absolute; inset: 0;
    border: 1.5px solid rgba(250, 204, 21, 0.5);
    border-radius: 50%;
  }

  /* Hitmarker */
  .vit-hitmarker {
    position: absolute;
    width: 26px; height: 26px;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(45deg);
    display: none;
    z-index: 60;
  }
  .vit-hitmarker.active {
    display: block;
    animation: hitAnim 0.15s ease-out forwards;
  }
  .vit-hitmarker::before, .vit-hitmarker::after {
    content: ''; position: absolute; background: #EF4444; border-radius: 1px;
  }
  .vit-hitmarker::before { top: 0; bottom: 0; left: 11px; width: 4px; }
  .vit-hitmarker::after { left: 0; right: 0; top: 11px; height: 4px; }

  @keyframes hitAnim {
    0% { transform: translate(-50%, -50%) rotate(45deg) scale(0.7); opacity: 1; }
    100% { transform: translate(-50%, -50%) rotate(45deg) scale(1.3); opacity: 0; }
  }

  /* Cible Pro Haute Précision */
  :global(.vit-target-pro) {
    position: absolute;
    width: 48px; height: 48px;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 30;
    display: flex; align-items: center; justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    animation: targetPop 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  @keyframes targetPop {
    0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0; }
    100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  }

  :global(.vit-target-ring) {
    position: absolute; inset: 2px;
    border-radius: 50%;
    border: 2px solid #EAB308;
    background: radial-gradient(circle, rgba(234, 179, 8, 0.3) 0%, rgba(234, 179, 8, 0.08) 70%, transparent 100%);
    box-shadow: 0 0 14px rgba(234, 179, 8, 0.45);
    pointer-events: none;
  }
  :global(.vit-target-bullseye) {
    position: relative;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: #FFFFFF;
    box-shadow: 0 0 8px #FFFFFF, inset 0 0 2px #EAB308;
    pointer-events: none;
  }
  :global(.vit-target-cross-h), :global(.vit-target-cross-v) {
    position: absolute; background: rgba(255, 255, 255, 0.7); pointer-events: none;
  }
  :global(.vit-target-cross-h) { width: 100%; height: 1.5px; left: 0; top: calc(50% - 0.75px); }
  :global(.vit-target-cross-v) { height: 100%; width: 1.5px; top: 0; left: calc(50% - 0.75px); }

  /* Floating combat text +100 */
  :global(.vit-score-float) {
    position: absolute;
    font-size: 0.85rem; font-weight: 800; color: #FACC15;
    pointer-events: none;
    transform: translate(-50%, -50%);
    animation: floatUp 0.45s ease-out forwards;
    z-index: 40;
    text-shadow: 0 0 8px rgba(234, 179, 8, 0.8);
  }
  @keyframes floatUp {
    0% { transform: translate(-50%, -50%) scale(0.8); opacity: 1; }
    100% { transform: translate(-50%, -90px) scale(1.1); opacity: 0; }
  }

  /* Overlays */
  .vit-overlay {
    position: absolute; inset: 0;
    background: rgba(8, 9, 12, 0.85);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    padding: 20px; z-index: 70;
  }
  .overlay-card {
    background: rgba(18, 21, 28, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 26px 30px;
    max-width: 440px; text-align: center;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }
  .overlay-icon { font-size: 2.2rem; margin-bottom: 8px; }
  .overlay-title {
    font-size: 1.25rem; font-weight: 800; color: #FFFFFF;
    margin: 0 0 8px; letter-spacing: 0.02em;
  }
  .overlay-desc {
    font-size: 0.84rem; color: #9CA3AF; margin: 0 0 20px; line-height: 1.45;
  }

  .vit-btn-action {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: linear-gradient(135deg, #FACC15 0%, #EAB308 100%);
    color: #000000;
    font-weight: 800; font-size: 0.9rem; letter-spacing: 0.04em;
    border: none; border-radius: 8px;
    padding: 12px 24px; cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(234, 179, 8, 0.3);
  }
  .vit-btn-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(234, 179, 8, 0.45);
    filter: brightness(1.05);
  }
  .vit-btn-action:active { transform: translateY(0); }

  /* End screen card */
  .end-card { max-width: 480px; width: 100%; }
  .rank-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(234, 179, 8, 0.15);
    border: 1px solid rgba(234, 179, 8, 0.4);
    padding: 8px 18px; border-radius: 999px; margin-bottom: 18px;
  }
  .rank-icon { font-size: 1.3rem; }
  .rank-title { font-size: 0.95rem; font-weight: 800; color: #FACC15; letter-spacing: 0.05em; }

  .stats-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 10px; margin-bottom: 18px;
  }
  .stat-col {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px; padding: 10px;
    display: flex; flex-direction: column; align-items: center;
  }
  .stat-col-lbl { font-size: 0.68rem; color: #9CA3AF; margin-bottom: 2px; }
  .stat-col-val { font-size: 1.2rem; font-weight: 800; color: #FFFFFF; font-variant-numeric: tabular-nums; }

  .new-record-alert {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    color: #34D399; font-size: 0.78rem; font-weight: 700;
    padding: 6px 12px; border-radius: 6px; margin-bottom: 16px;
  }

  /* Footer */
  .vit-footer {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 14px; font-size: 0.75rem; color: #6B7280;
  }
  .vit-tip kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px; padding: 1px 5px; color: #D1D5DB; font-family: monospace;
  }

  /* Responsive Mobile */
  @media (max-width: 640px) {
    .vit-container { padding: 18px 16px; }
    .vit-header { padding-right: 36px; margin-bottom: 14px; }
    .vit-title { font-size: 1.25rem; }
    .vit-sub { font-size: 0.76rem; }
    .vit-hud { grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .hud-value { font-size: 1.15rem; }
    .vit-arena { height: 280px; }
    .overlay-card { padding: 18px 16px; }
    .stats-grid { gap: 6px; }
    .vit-footer { flex-direction: column; gap: 6px; text-align: center; }
  }
</style>

<script is:inline>
  (function initVitalityAimLab() {
    let keySequence = [];
    let textBuffer = '';
    const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];

    const modal = document.getElementById('vitalityModal');
    const closeBtn = document.getElementById('vitCloseBtn');
    const backdrop = document.getElementById('vitBackdrop');
    const arena = document.getElementById('vitArena');
    const crosshair = document.getElementById('vitCrosshair');
    const hitmarker = document.getElementById('vitHitmarker');
    const startOverlay = document.getElementById('vitStartOverlay');
    const endOverlay = document.getElementById('vitEndOverlay');
    const startBtn = document.getElementById('vitStartGameBtn');
    const restartBtn = document.getElementById('vitRestartBtn');
    const timerEl = document.getElementById('vitTimer');
    const timerBarEl = document.getElementById('vitTimerBar');
    const scoreEl = document.getElementById('vitScore');
    const accEl = document.getElementById('vitAccuracy');
    const kpsEl = document.getElementById('vitKps');
    const hitsCounterEl = document.getElementById('vitHitsCounter');
    const bestScoreEl = document.getElementById('vitBestScore');

    const endScoreVal = document.getElementById('endScoreVal');
    const endHitsVal = document.getElementById('endHitsVal');
    const endAccVal = document.getElementById('endAccVal');
    const endKpsVal = document.getElementById('endKpsVal');
    const endRankEl = document.getElementById('vitEndRank');
    const endRankIconEl = document.getElementById('vitEndRankIcon');
    const newRecordAlert = document.getElementById('vitNewRecordAlert');

    const TOTAL_DURATION = 15.0;
    let isPlaying = false;
    let score = 0;
    let totalClicks = 0;
    let hits = 0;
    let timeLeft = TOTAL_DURATION;
    let gameInterval = null;
    let activeTargets = [];
    let startTime = 0;

    let savedBest = localStorage.getItem('vit_best_score') ? parseInt(localStorage.getItem('vit_best_score')) : 0;
    if (bestScoreEl) bestScoreEl.textContent = savedBest;

    // Synthétiseur audio esport haute fidélité
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    // Son de hit percutant (harmonique double chime)
    function playHitSound() {
      try {
        const ctx = getAudioContext();
        const now = ctx.currentTime;
        
        // Oscillateur 1 (corps)
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'triangle';
        osc1.frequency.setValueAtTime(880, now);
        osc1.frequency.exponentialRampToValueAtTime(1320, now + 0.08);
        gain1.gain.setValueAtTime(0.08, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.08);

        // Oscillateur 2 (ping métallique aigu)
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1760, now);
        gain2.gain.setValueAtTime(0.04, now);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now);
        osc2.stop(now + 0.12);
      } catch (e) {}
    }

    // Son de miss discret (plop étouffé)
    function playMissSound() {
      try {
        const ctx = getAudioContext();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.exponentialRampToValueAtTime(80, now + 0.06);
        gain.gain.setValueAtTime(0.03, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.06);
      } catch (e) {}
    }

    function openModal() {
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        resetGameUI();
      }
    }

    function closeModal() {
      if (modal) {
        document.body.style.overflow = '';
        stopGame();
        modal.style.display = 'none';
      }
    }

    function resetGameUI() {
      stopGame();
      if (startOverlay) {
        startOverlay.style.display = 'flex';
      }
      if (endOverlay) endOverlay.style.display = 'none';
      if (newRecordAlert) newRecordAlert.style.display = 'none';
      if (timerEl) timerEl.innerHTML = '15.0<small>s</small>';
      if (timerBarEl) timerBarEl.style.width = '100%';
      if (scoreEl) scoreEl.textContent = '0';
      if (accEl) accEl.textContent = '100%';
      if (kpsEl) kpsEl.textContent = '0.0 KPS';
      if (hitsCounterEl) hitsCounterEl.textContent = '0 touchés';
    }

    // Déplacement fluide du réticule
    arena?.addEventListener('pointermove', (e) => {
      if (!crosshair) return;
      const rect = arena.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      crosshair.style.display = 'block';
      crosshair.style.left = `${x}px`;
      crosshair.style.top = `${y}px`;
    });

    arena?.addEventListener('pointerleave', () => {
      if (crosshair) crosshair.style.display = 'none';
    });

    function triggerHitmarker(x, y) {
      if (!hitmarker) return;
      hitmarker.style.left = `${x}px`;
      hitmarker.style.top = `${y}px`;
      hitmarker.classList.remove('active');
      void hitmarker.offsetWidth; // Force reflow
      hitmarker.classList.add('active');
    }

    function showFloatingScore(x, y, text) {
      if (!arena) return;
      const el = document.createElement('div');
      el.className = 'vit-score-float';
      el.textContent = text;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      arena.appendChild(el);
      setTimeout(() => el.remove(), 450);
    }

    function createTargetElement() {
      if (!arena) return null;
      const rect = arena.getBoundingClientRect();
      const arenaW = rect.width > 0 ? rect.width : 600;
      const arenaH = rect.height > 0 ? rect.height : 320;

      const padding = 52;
      const x = Math.round(padding + Math.random() * (arenaW - padding * 2));
      const y = Math.round(padding + Math.random() * (arenaH - padding * 2));

      const target = document.createElement('div');
      target.className = 'vit-target-pro';
      target.style.left = `${x}px`;
      target.style.top = `${y}px`;

      target.innerHTML = `
        <div class="vit-target-ring"></div>
        <div class="vit-target-cross-h"></div>
        <div class="vit-target-cross-v"></div>
        <div class="vit-target-bullseye"></div>
      `;

      function handleHit(e) {
        e.preventDefault();
        e.stopPropagation();
        if (!isPlaying) return;

        hits++;
        totalClicks++;
        score += 100;

        playHitSound();
        triggerHitmarker(x, y);
        showFloatingScore(x, y, '+100');
        updateHUD();

        target.remove();
        activeTargets = activeTargets.filter(t => t !== target);
        spawnSingleTarget();
      }

      target.addEventListener('pointerdown', handleHit);
      return target;
    }

    function spawnSingleTarget() {
      if (!isPlaying || !arena) return;
      const target = createTargetElement();
      if (target) {
        arena.appendChild(target);
        activeTargets.push(target);
      }
    }

    function spawnInitialTargets() {
      clearAllTargets();
      spawnSingleTarget();
      spawnSingleTarget();
      spawnSingleTarget(); // 3 cibles pour un vrai rythme esports fluide
    }

    function clearAllTargets() {
      activeTargets.forEach(t => t.remove());
      activeTargets = [];
      const leftover = arena?.querySelectorAll('.vit-target-pro');
      leftover?.forEach(t => t.remove());
    }

    function updateHUD() {
      if (scoreEl) scoreEl.textContent = score;
      if (timerEl) timerEl.innerHTML = `${Math.max(0, timeLeft).toFixed(1)}<small>s</small>`;
      if (timerBarEl) {
        const pct = Math.max(0, (timeLeft / TOTAL_DURATION) * 100);
        timerBarEl.style.width = `${pct}%`;
      }

      const acc = totalClicks > 0 ? Math.round((hits / totalClicks) * 100) : 100;
      if (accEl) {
        accEl.textContent = `${acc}%`;
        if (acc >= 90) accEl.className = 'hud-value highlight-green';
        else if (acc >= 75) accEl.className = 'hud-value highlight-gold';
        else accEl.className = 'hud-value';
      }

      const elapsed = Math.max(0.1, (performance.now() - startTime) / 1000);
      const kps = (hits / elapsed).toFixed(1);
      if (kpsEl) kpsEl.textContent = `${kps} KPS`;
      if (hitsCounterEl) hitsCounterEl.textContent = `${hits} touchés`;
    }

    function startGame() {
      score = 0;
      hits = 0;
      totalClicks = 0;
      timeLeft = TOTAL_DURATION;
      isPlaying = true;
      startTime = performance.now();

      if (startOverlay) startOverlay.style.display = 'none';
      if (endOverlay) endOverlay.style.display = 'none';
      if (newRecordAlert) newRecordAlert.style.display = 'none';

      updateHUD();
      spawnInitialTargets();

      gameInterval = setInterval(() => {
        const elapsed = (performance.now() - startTime) / 1000;
        timeLeft = TOTAL_DURATION - elapsed;
        if (timeLeft <= 0) {
          endGame();
        } else {
          updateHUD();
        }
      }, 50);
    }

    function stopGame() {
      isPlaying = false;
      if (gameInterval) clearInterval(gameInterval);
      clearAllTargets();
    }

    function endGame() {
      stopGame();
      if (timerEl) timerEl.innerHTML = '0.0<small>s</small>';
      if (timerBarEl) timerBarEl.style.width = '0%';

      const finalAcc = totalClicks > 0 ? Math.round((hits / totalClicks) * 100) : 100;
      const finalKps = (hits / TOTAL_DURATION).toFixed(1);

      // Calcul du rang esport
      let rankTitle = 'ROOKIE // Recrue';
      let rankIcon = '🛡️';

      if (hits >= 34 && finalAcc >= 90) {
        rankTitle = 'MAJOR MVP // ZywOo Class';
        rankIcon = '👑';
      } else if (hits >= 26 && finalAcc >= 85) {
        rankTitle = 'RADIANT // CS2 Global Elite';
        rankIcon = '⚡';
      } else if (hits >= 18 && finalAcc >= 75) {
        rankTitle = 'DIAMOND // Faceit Level 10';
        rankIcon = '🎯';
      } else if (hits >= 12) {
        rankTitle = 'GOLD // Challenger';
        rankIcon = '⚔️';
      }

      const isNewBest = score > savedBest;
      if (isNewBest) {
        savedBest = score;
        localStorage.setItem('vit_best_score', savedBest);
        if (bestScoreEl) bestScoreEl.textContent = savedBest;
        if (newRecordAlert) newRecordAlert.style.display = 'block';
      }

      if (endRankEl) endRankEl.textContent = rankTitle;
      if (endRankIconEl) endRankIconEl.textContent = rankIcon;
      if (endScoreVal) endScoreVal.textContent = score;
      if (endHitsVal) endHitsVal.textContent = hits;
      if (endAccVal) endAccVal.textContent = `${finalAcc}%`;
      if (endKpsVal) endKpsVal.textContent = `${finalKps} /s`;

      if (endOverlay) endOverlay.style.display = 'flex';
    }

    // Gestion des tirs dans le vide (miss)
    arena?.addEventListener('pointerdown', (e) => {
      if (isPlaying && e.target === arena) {
        if (e.cancelable) e.preventDefault();
        totalClicks++;
        playMissSound();
        updateHUD();
      }
    });

    startBtn?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      if (e.cancelable) e.preventDefault();
      startGame();
    });
    startBtn?.addEventListener('click', (e) => e.stopPropagation());

    restartBtn?.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      if (e.cancelable) e.preventDefault();
      startGame();
    });
    restartBtn?.addEventListener('click', (e) => e.stopPropagation());

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') {
        if (e.key === 'Escape') closeModal();
        if (e.code === 'Space' && (!isPlaying || endOverlay?.style.display === 'flex')) {
          e.preventDefault();
          startGame();
        }
        return;
      }

      // Déclencheur Konami Code
      keySequence.push(e.key);
      if (keySequence.length > konami.length) keySequence.shift();
      if (keySequence.join(',') === konami.join(',')) {
        openModal();
        keySequence = [];
        return;
      }

      // Déclencheur textuel
      if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        textBuffer += e.key.toLowerCase();
        if (textBuffer.length > 15) textBuffer = textBuffer.slice(-15);
        if (textBuffer.endsWith('vitality') || textBuffer.endsWith('esport')) {
          openModal();
          textBuffer = '';
        }
      }
    });

    // Exposition globale pour Minitel et palettes
    window.startVitality = openModal;
  })();
</script>

