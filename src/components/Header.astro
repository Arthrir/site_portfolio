---
import { makeT, type Lang } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = makeT(lang);
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo-link" aria-label="Arthur Doradoux — Home">
      <!-- Si tu as mis icone_white.png et icone_gray.png dans public/ -->
      <img src="/icone.png" alt="Logo" class="nav-logo" />
    </a>

    <nav class="nav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li><a href="/" class:list={{ active: Astro.url.pathname === '/' }}>{t('nav.home')}</a></li>
        <li><a href="/about" class:list={{ active: Astro.url.pathname.startsWith('/about') }}>{t('nav.about')}</a></li>
        <li><a href="/projects" class:list={{ active: Astro.url.pathname.startsWith('/projects') }}>{t('nav.projects')}</a></li>
        <li><a href="/skills" class:list={{ active: Astro.url.pathname.startsWith('/skills') }}>{t('nav.skills')}</a></li>
        <li><a href="/engagements" class:list={{ active: Astro.url.pathname.startsWith('/engagements') }}>{t('nav.engagements')}</a></li>
      </ul>
    </nav>

    <div class="header-controls">
      <div class="cv-menu">
        <button class="cv-trigger" aria-haspopup="true">{t('common.resume')} <span class="chev">↓</span></button>
        <div class="cv-dropdown">
          <a href="/assets/CV-Arthur_DORADOUX-ENG.pdf" download>{t('common.resumeEn')}</a>
          <a href="/assets/CV-Arthur_DORADOUX-FR.pdf" download>{t('common.resumeFr')}</a>
        </div>
      </div>

      <!-- Nouveau bouton Dark Mode plus clair (Soleil/Lune) -->
      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" type="button">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <a class="lang-toggle" id="langToggle" href="#" aria-label="Toggle language" data-current={lang}>
        {lang === 'fr' ? 'EN' : 'FR'}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; backdrop-filter: blur(14px); background: rgba(244, 245, 246, 0.78); border-bottom: 1px solid var(--border); z-index: 1000; height: 70px; display: flex; align-items: center; }
  body.theme-dark .site-header { background: rgba(12, 13, 15, 0.78); }
  .header-inner { width: 100%; max-width: var(--container-width); margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; }
  
  .nav-logo { height: 28px; width: auto; object-fit: contain; }
  body.theme-dark .nav-logo { filter: brightness(0) invert(1); } /* Rend le logo blanc en mode sombre si c'est un PNG noir */

  .nav-list { display: flex; gap: 24px; list-style: none; }
  .nav-list a { position: relative; color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.92rem; padding-bottom: 2px; }
  .nav-list a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -3px; height: 1.5px; background: var(--text); transition: right 0.25s ease; }
  .nav-list a:hover { color: var(--text); }
  .nav-list a:hover::after { right: 0; }
  .nav-list a.active { color: var(--text); }
  .nav-list a.active::after { right: 0; }

  .header-controls { display: flex; gap: 10px; align-items: center; }

  /* Boutons Theme et Langue plus clairs et cliquables */
  .theme-toggle, .lang-toggle {
    background: var(--card-bg); border: 1px solid var(--border-strong); color: var(--text);
    cursor: pointer; font-weight: 600; font-size: 0.85rem; width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center; border-radius: 8px;
    position: relative; transition: border-color 0.2s ease; text-decoration: none;
  }
  .theme-toggle:hover, .lang-toggle:hover { border-color: var(--text); }
  
  .theme-toggle svg { position: absolute; transition: opacity 0.3s ease, transform 0.3s ease; }
  .icon-sun { opacity: 1; transform: scale(1); color: var(--pop-orange); }
  .icon-moon { opacity: 0; transform: scale(0.5) rotate(-45deg); color: var(--pop-purple); }
  body.theme-dark .icon-sun { opacity: 0; transform: scale(0.5) rotate(45deg); }
  body.theme-dark .icon-moon { opacity: 1; transform: scale(1) rotate(0); }

  .cv-menu { position: relative; }
  .cv-trigger { display: inline-flex; align-items: center; gap: 6px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: transform 0.2s ease; }
  .cv-trigger:hover { background: transparent; color: var(--text); }
  .cv-dropdown { opacity: 0; visibility: hidden; transform: translateY(-6px); position: absolute; top: calc(100% + 8px); right: 0; background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 6px; min-width: 170px; z-index: 10; }
  .cv-menu:hover .cv-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .cv-dropdown a { display: block; padding: 8px 10px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; text-decoration: none; }
  .cv-dropdown a:hover { background: var(--accent-soft); }

  /* Mobile Responsive */
  @media (max-width: 850px) {
    .nav { display: none; } /* Cache le menu sur mobile (il faudrait un menu burger plus tard) */
    .header-inner { padding: 0 16px; }
  }
</style>

<script>
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.body.classList.toggle('theme-dark');
    document.body.classList.toggle('theme-light', !isDark);
    document.cookie = `theme=${isDark ? 'dark' : 'light'}; path=/; max-age=31536000; SameSite=Lax`;
  });

  const langToggle = document.getElementById('langToggle');
  langToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    const current = langToggle.getAttribute('data-current');
    const next = current === 'fr' ? 'en' : 'fr';
    document.cookie = `lang=${next}; path=/; max-age=31536000; SameSite=Lax`;
    window.location.reload();
  });
</script>