---
import { makeT, type Lang } from '../i18n/translations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = makeT(lang);

// Logique de switch : on affiche la langue vers laquelle on va aller
const targetLang = lang === 'fr' ? 'EN' : 'FR';
const targetFlag = lang === 'fr' ? 'en-flag' : 'fr-flag';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-logo-link" aria-label="Arthur Doradoux — Home">
      <!-- Appels propres de tes fichiers SVG vectoriels -->
      <img src="/logo/logo-black.svg" alt="Arthur Doradoux — Accueil" class="nav-logo logo-light" />
      <img src="/logo/logo-white.svg" alt="Arthur Doradoux — Accueil" class="nav-logo logo-dark" />
    </a>

    <nav class="nav" id="mainNav" aria-label="Main Navigation">
      <ul class="nav-list">
        <li><a href="/" class:list={{ active: Astro.url.pathname === '/' }}>{t('nav.home')}</a></li>
        <!-- <li><a href="/about" class:list={{ active: Astro.url.pathname.startsWith('/about') }}>{t('nav.about')}</a></li> -->
        <li><a href="/projects" class:list={{ active: Astro.url.pathname.startsWith('/projects') }}>{t('nav.projects')}</a></li>
        <li><a href="/skills" class:list={{ active: Astro.url.pathname.startsWith('/skills') }}>{t('nav.skills')}</a></li>
        <li><a href="/engagements" class:list={{ active: Astro.url.pathname.startsWith('/engagements') }}>{t('nav.engagements')}</a></li>
      </ul>
    </nav>

    <div class="header-controls">
      <div class="cv-menu">
        <button class="cv-trigger" aria-haspopup="true">
          {t('common.resume')} 
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="cv-dropdown">
          <a href="/assets/CV-Arthur_DORADOUX-ENG.pdf" download>{t('common.resumeEn')}</a>
          <a href="/assets/CV-Arthur_DORADOUX-FR.pdf" download>{t('common.resumeFr')}</a>
        </div>
      </div>

      <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" type="button">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <button class={`lang-toggle ${targetFlag}`} id="langToggle" data-current={lang}>
        {targetLang}
      </button>

      <button class="mobile-toggle" id="mobileToggle" aria-label="Menu principal">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; top: 0; left: 0; right: 0; backdrop-filter: blur(14px); background: rgba(244, 245, 246, 0.78); border-bottom: 1px solid var(--border); z-index: 1000; height: 58px; display: flex; align-items: center; }
  body.theme-dark .site-header { background: rgba(12, 13, 15, 0.78); }
  .header-inner { width: 100%; max-width: var(--container-width); margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; }
  
  /* Paramètres du Logo SVG */
  .header-logo-link { display: flex; align-items: center; }
  .nav-logo { height: 32px; width: auto; object-fit: contain; transition: transform 0.2s ease; }
  .nav-logo:hover { transform: scale(1.05); }
  .logo-dark { display: none; }
  body.theme-dark .logo-light { display: none; }
  body.theme-dark .logo-dark { display: block; }

  .nav-list { display: flex; gap: 24px; list-style: none; }
  .nav-list a { position: relative; color: var(--muted); text-decoration: none; font-weight: 500; font-size: 0.9rem; padding-bottom: 2px; }
  .nav-list a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -3px; height: 1.5px; background: var(--text); transition: right 0.25s ease; }
  .nav-list a:hover { color: var(--text); }
  .nav-list a:hover::after { right: 0; }
  .nav-list a.active { color: var(--text); }
  .nav-list a.active::after { right: 0; }

  .header-controls { display: flex; gap: 12px; align-items: center; }

  /* Animation RGB Cyclique pour le bouton Soleil/Lune */
  @keyframes icon-rgb-cycle {
    0% { color: #ff0080; }
    25% { color: #ffaa00; }
    50% { color: #00ff88; }
    75% { color: #0088ff; }
    100% { color: #ff0080; }
  }

  .theme-toggle {
    background: transparent; border: none; color: var(--text); cursor: pointer; 
    width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; 
    position: relative; transition: transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover { 
      transform: scale(1.05); 
      animation: icon-rgb-cycle 2.5s linear infinite;
    }
  }
  .theme-toggle:active {
    transform: scale(0.92);
  }
  .theme-toggle:focus:not(:focus-visible) {
    outline: none;
    animation: none;
    color: var(--text);
  }
  .theme-toggle svg { position: absolute; transition: opacity 0.3s ease, transform 0.3s ease; }
  .icon-sun { opacity: 1; transform: scale(1); }
  .icon-moon { opacity: 0; transform: scale(0.5) rotate(-45deg); }
  body.theme-dark .icon-sun { opacity: 0; transform: scale(0.5) rotate(45deg); }
  body.theme-dark .icon-moon { opacity: 1; transform: scale(1) rotate(0); }

  .lang-toggle {
    background: var(--card-bg); color: var(--text); cursor: pointer; font-weight: 600; font-size: 0.8rem; 
    width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; 
    border-radius: 8px; transition: transform 0.2s ease, box-shadow 0.2s ease; border: 2px solid transparent;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .lang-toggle.en-flag { border: 2px solid var(--text); background-image: none; }
  .lang-toggle.fr-flag {
    background-image: linear-gradient(var(--card-bg), var(--card-bg)), linear-gradient(90deg, #0055A4 33%, #fff 33%, #fff 66%, #EF4135 66%);
    background-origin: border-box; background-clip: padding-box, border-box;
  }
  @media (hover: hover) and (pointer: fine) {
    .lang-toggle:hover { transform: translateY(-1px); box-shadow: 0 4px 8px rgba(15, 23, 42, 0.1); }
  }
  .lang-toggle:active { transform: scale(0.95); }

  /* GESTION DU MENU CV */
  .cv-menu { position: relative; }
  .cv-trigger { display: inline-flex; align-items: center; gap: 4px; background: var(--ink); color: var(--bg); border: 1px solid var(--ink); padding: 8px 14px; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: transform 0.2s ease, background 0.2s; }
  .cv-trigger:hover { background: transparent; color: var(--text); }
  .cv-trigger .chev { transition: transform 0.2s ease; }
  .cv-menu:hover .chev { transform: translateY(2px); }
  
  .cv-dropdown { 
    opacity: 0; 
    visibility: hidden; 
    transform: translateY(-6px); 
    position: absolute; 
    top: calc(100% + 8px); 
    right: 0; 
    background: var(--card-bg); 
    border: 1px solid var(--border); 
    border-radius: 8px; 
    padding: 6px; 
    min-width: 170px; 
    z-index: 10; 
    box-shadow: var(--shadow-lift); 
    transition: opacity 0.5s ease, transform 0.5s ease, visibility 0s linear 0.5s;
  }
  
  .cv-dropdown::before { content: ''; position: absolute; top: -16px; left: -20px; right: -20px; height: 16px; }
  
  .cv-menu:hover .cv-dropdown { 
    opacity: 1; 
    visibility: visible; 
    transform: translateY(0); 
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
  }
  
  .cv-dropdown a { display: block; padding: 8px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 500; text-decoration: none; }
  .cv-dropdown a:hover { background: var(--accent-soft); }

  .mobile-toggle { display: none; background: none; border: 0; padding: 8px; color: var(--text); cursor: pointer; }

  @media (max-width: 850px) {
    .nav { display: none; }
    .nav.open { display: flex; position: fixed; top: 58px; left: 0; right: 0; flex-direction: column; background: var(--bg); border-top: 1px solid var(--border); box-shadow: var(--shadow); padding: 10px 0 20px 0; z-index: 999; }
    .nav.open .nav-list { flex-direction: column; width: 100%; align-items: flex-start; }
    .nav.open .nav-list a { display: block; width: 100%; padding: 14px 28px; border-radius: 0; text-align: left; font-size: 16px; }
    .mobile-toggle { display: block; }
  }
</style>

<script>
  const themeToggle = document.getElementById('themeToggle');
  themeToggle?.addEventListener('click', () => {
    themeToggle.blur();
    const isDark = document.body.classList.toggle('theme-dark');
    document.body.classList.toggle('theme-light', !isDark);
    document.cookie = `theme=${isDark ? 'dark' : 'light'}; path=/; max-age=31536000; SameSite=Lax`;
  });
  themeToggle?.addEventListener('touchend', () => {
    setTimeout(() => themeToggle.blur(), 50);
  }, { passive: true });

  const langToggle = document.getElementById('langToggle');
  langToggle?.addEventListener('click', (e) => {
    e.preventDefault();
    langToggle.blur();
    const current = langToggle.getAttribute('data-current');
    const next = current === 'fr' ? 'en' : 'fr';
    document.cookie = `lang=${next}; path=/; max-age=31536000; SameSite=Lax`;
    window.location.reload();
  });

  const mobileToggle = document.getElementById('mobileToggle');
  const mainNav = document.getElementById('mainNav');
  mobileToggle?.addEventListener('click', () => {
    mainNav?.classList.toggle('open');
  });
</script>